		BackgroundColor3 = Color3.fromRGB(30, 30, 30),
		Parent = overlay,
	}, { UI.corner(7) })
	refs.DownedFill = UI.new("Frame", { BackgroundColor3 = C.Bad, Size = UDim2.fromScale(1, 1), Parent = barBg }, { UI.corner(7) })
	refs.Downed = overlay
	refs.Cloaked = UI.text({
		Text = "CLOAKED",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(190, 150, 255),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(300, 30),
		Visible = false,
		Parent = gui,
	})
end

---------------------------------------------------------------------------
-- Map vote
---------------------------------------------------------------------------
local Shop = Net.Function("Shop")

local previewCams: { Camera } = {}

-- A picture of a map: a live 3D miniature, with the ForgeGUI art on top
-- when Config.Maps has an Image for it.
local function mapPicture(mapId: string, parent: Instance, size: UDim2, position: UDim2): Frame
	local frame = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(120, 180, 230),
		Size = size,
		Position = position,
		ClipsDescendants = true,
		Parent = parent,
	}, { UI.corner(10) :: any, UI.gradient(Color3.fromRGB(150, 200, 255), Color3.fromRGB(220, 235, 255)) })
	local viewport = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = frame,
	}, { UI.corner(10) })
	table.insert(previewCams, MapPreview.Build(viewport, mapId))
	local image: string? = nil
	for _, m in Config.Maps do
		if m.Id == mapId then
			image = m.Image
		end
	end
	if image and image ~= "" then
		UI.new("ImageLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Image = image,
			ScaleType = Enum.ScaleType.Crop,
			ZIndex = 2,
			Parent = frame,
		}, { UI.corner(10) })
	end
	return frame
end

local function buildVote()
	local panel = UI.panel({
		Name = "Vote",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(580, 300),
		Visible = false,
		Parent = gui,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(580, 300), Parent = panel })
	refs.Vote = panel
	UI.text({ Text = "VOTE FOR THE MAP", TextSize = 24, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 8), Parent = panel })
	UI.button({ Text = "X", TextSize = 18, Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, -42, 0, 8), Color = C.Bad, Parent = panel }, function()
		Sounds.Play("Click")
		HUD.VoteHidden = true
	end)
	-- Collapsed form: a small button that reopens the vote.
	refs.VotePill = UI.button({
		Name = "VotePill",
		Text = "VOTE FOR THE MAP",
		TextSize = 18,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(300, 42),
		Color = C.Blue,
		Parent = gui,
	}, function()
		Sounds.Play("Click")
		HUD.VoteHidden = false
		UI.pop(panel, 0.85)
	end)
	refs.VotePill.Visible = false
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 44),
		Size = UDim2.new(1, -28, 1, -56),
		Parent = panel,
	}, { UI.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center) })
	refs.VoteButtons = {}
	for i, m in Config.Maps do
		local card = UI.new("TextButton", {
			Name = m.Id,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.Panel2,
			Size = UDim2.new(0.5, -7, 1, 0),
			LayoutOrder = i,
			Parent = row,
		}, { UI.corner(12) })
		local outline = UI.borderStroke(3, C.Accent, 1)
		outline.Parent = card
		mapPicture(m.Id, card, UDim2.new(1, -16, 0, 150), UDim2.fromOffset(8, 8))
		UI.text({ Text = m.Name, TextSize = 24, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 162), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		UI.text({ Text = m.Blurb, Font = UI.Body, TextSize = 13, TextColor3 = C.Muted, Size = UDim2.new(1, -16, 0, 16), Position = UDim2.fromOffset(8, 192), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1, Parent = card })
		local count = UI.text({
			Text = "0 votes",
			TextSize = 18,
			TextColor3 = C.Accent,
			AnchorPoint = Vector2.new(1, 0),
			Size = UDim2.fromOffset(120, 28),
			Position = UDim2.new(1, -8, 0, 162),
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		local scale = UI.new("UIScale", { Parent = card })
		card.MouseEnter:Connect(function()
			UI.tween(scale, 0.1, { Scale = 1.03 })
		end)
		card.MouseLeave:Connect(function()
			UI.tween(scale, 0.1, { Scale = 1 })
		end)
		card.Activated:Connect(function()
			Sounds.Play("Click")
			scale.Scale = 0.95
			UI.tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
			HUD.MyVote = m.Id
			task.spawn(function()
				Shop:InvokeServer("Vote", m.Id)
			end)
			-- Get out of the way once you've voted.
			task.delay(0.6, function()
				if HUD.MyVote == m.Id then
					HUD.VoteHidden = true
				end
			end)
		end)
		refs.VoteButtons[m.Id] = { Button = card, Count = count, Outline = outline }
	end
end

-- Shown while the match intro plays: which map won the vote.
local function buildMapChosen()
	local panel = UI.panel({
		Name = "MapChosen",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(320, 230),
		Visible = false,
		Parent = gui,
	})
	refs.MapChosen = panel
	refs.MapChosenTitle = UI.text({ Text = "", TextSize = 24, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 190), Parent = panel })
	refs.MapChosenPictures = {}
	for _, m in Config.Maps do
		local pic = mapPicture(m.Id, panel, UDim2.new(1, -16, 0, 176), UDim2.fromOffset(8, 8))
		pic.Visible = false
		refs.MapChosenPictures[m.Id] = pic
	end
end

HUD.MyVote = nil :: string?
HUD.VoteHidden = false

---------------------------------------------------------------------------
-- Hero or Chicken
---------------------------------------------------------------------------
local HeroChoice = Net.Event("HeroChoice")

local function showHeroChoice(data: any)
	if refs.Hero then
		refs.Hero:Destroy()
	end
	local panel = UI.panel({
		Name = "Hero",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.fromOffset(460, 210),
		Parent = gui,
	})
	refs.Hero = panel
	UI.pop(panel)
	UI.text({ Text = "HERO OR CHICKEN?", TextSize = 34, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 10), TextColor3 = Color3.fromRGB(255, 225, 90), Parent = panel })
	UI.text({
		Text = ("Cross alone for +%d gems, or chicken out and stay with the group."):format(data.Reward or 100),
		Font = UI.Body,
		TextSize = 15,
		TextWrapped = true,
		Size = UDim2.new(1, -40, 0, 40),
		Position = UDim2.fromOffset(20, 52),
		Parent = panel,
	})
	local timer = UI.text({ Text = "", Font = UI.Body, TextSize = 14, TextColor3 = C.Muted, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -24), Parent = panel })
	local function answer(choice: string)
		HeroChoice:FireServer(choice)
		Sounds.Play("Click")
		panel:Destroy()
		refs.Hero = nil
	end
	UI.button({ Text = "HERO", TextSize = 28, Color = Color3.fromRGB(255, 200, 50), Size = UDim2.fromOffset(190, 64), Position = UDim2.fromOffset(28, 100), Parent = panel }, function()
		answer("Hero")
	end)
	UI.button({ Text = "CHICKEN", TextSize = 28, Color = Color3.fromRGB(150, 150, 160), Size = UDim2.fromOffset(190, 64), Position = UDim2.fromOffset(242, 100), Parent = panel }, function()
		answer("Chicken")
	end)
	local deadline = os.clock() + (data.Time or 7)
	task.spawn(function()
		while panel.Parent and os.clock() < deadline do
			timer.Text = ("Deciding for you in %d..."):format(math.ceil(deadline - os.clock()))
			task.wait(0.2)
		end
		if panel.Parent then
			panel:Destroy()
			refs.Hero = nil
		end
	end)
end

---------------------------------------------------------------------------
-- Results
---------------------------------------------------------------------------
local function showResults(data: any)
	if refs.Results then
		refs.Results:Destroy()
	end
	local panel = UI.panel({
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(520, 400),
		Parent = gui,
	})
	refs.Results = panel
	UI.pop(panel, 0.7)
	UI.text({ Text = data.Headline, TextSize = 38, TextColor3 = data.Color, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 12), Parent = panel })
	UI.text({
		Text = if data.YouWon then "YOU WON!" else "Better luck next time",
		Font = UI.Body,
		TextSize = 18,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 58),
		Parent = panel,
	})
	local statsLine = ("Crossings %d   •   Ankles broken %d   •   Catches %d   •   Rescues %d"):format(data.Crossings, data.Ankles, data.Catches, data.Rescues)
	UI.text({ Text = statsLine, Font = UI.Body, TextSize = 14, TextColor3 = C.Muted, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 88), StrokeThickness = 1, Parent = panel })
	if data.MVP then
		UI.text({ Text = "MVP: " .. data.MVP, TextSize = 20, TextColor3 = C.Accent, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 112), Parent = panel })
	end
	-- Group the earnings by reason.
	local grouped: { [string]: { Gems: number, Coins: number, XP: number, Order: number } } = {}
	local order = 0
	for _, line in data.Lines or {} do
		local key = if string.find(line.Reason, "^Caught ") then "Catches" elseif string.find(line.Reason, "ankles") then "Ankle breaks" else line.Reason
		local g = grouped[key]
		if not g then
			order += 1
			g = { Gems = 0, Coins = 0, XP = 0, Order = order }
			grouped[key] = g
		end
		g.Gems += line.Gems
		g.Coins += line.Coins
		g.XP += line.XP
	end
	local list = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(30, 146),
		Size = UDim2.new(1, -60, 0, 170),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		BorderSizePixel = 0,
		Parent = panel,
	}, { UI.list(Enum.FillDirection.Vertical, 2) })
	for reason, g in grouped do
		local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 22), LayoutOrder = g.Order, Parent = list })
		UI.text({ Text = reason, Font = UI.Body, TextSize = 15, Size = UDim2.new(0.5, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1, Parent = row })
		local parts = {}
		if g.Gems > 0 then
			table.insert(parts, ('<font color="#C46EFF">+%d gems</font>'):format(g.Gems))
		end
		if g.Coins > 0 then
			table.insert(parts, ('<font color="#FFCD3C">+%d coins</font>'):format(g.Coins))
		end
		if g.XP > 0 then
			table.insert(parts, ('<font color="#5ADC78">+%d xp</font>'):format(g.XP))
		end
		UI.text({ Text = table.concat(parts, "  "), RichText = true, Font = UI.Body, TextSize = 15, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromScale(0.5, 0), TextXAlignment = Enum.TextXAlignment.Right, StrokeThickness = 1, Parent = row })
	end
	UI.text({
		Text = ('Total  <font color="#C46EFF">+%d gems</font>   <font color="#FFCD3C">+%d coins</font>   <font color="#5ADC78">+%d xp</font>'):format(data.Gems, data.Coins, data.XP),
		RichText = true,
		TextSize = 20,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.new(0, 0, 1, -66),
		Parent = panel,
	})
	UI.button({ Text = "CLOSE", TextSize = 18, Size = UDim2.fromOffset(120, 34), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Color = Color3.fromRGB(90, 96, 110), Parent = panel }, function()
		panel:Destroy()
		refs.Results = nil
	end)
	task.delay(data.Time or 9, function()
		if panel.Parent then
			panel:Destroy()
			refs.Results = nil
		end
	end)
end

---------------------------------------------------------------------------
-- Notifications
---------------------------------------------------------------------------
local announceToken = 0

function HUD.Announce(text: string, sub: string?, color: Color3?)
	announceToken += 1
	local token = announceToken
	local frame = refs.AnnounceFrame :: Frame
	refs.AnnounceText.Text = text
	refs.AnnounceText.TextColor3 = color or C.Text
	refs.AnnounceSub.Text = sub or ""
	frame.Visible = true
	UI.showText(refs.AnnounceText)
	UI.showText(refs.AnnounceSub)
	UI.pop(refs.AnnounceText, 0.4)
	local function current(): boolean
		return token == announceToken
	end
	task.delay(2.4, function()
		if current() then
			UI.fadeText(refs.AnnounceText, 0.35, current)
			UI.fadeText(refs.AnnounceSub, 0.35, current)
			task.delay(0.36, function()
				if current() then
					frame.Visible = false
				end
			end)
		end
	end)
end

local toastToken = 0
function HUD.Toast(text: string, color: Color3?)
	toastToken += 1
	local token = toastToken
	local t = refs.Toast :: TextLabel
	t.Text = text
	t.TextColor3 = color or C.Text
	UI.showText(t)
	UI.pop(t, 0.7)
	local function current(): boolean
		return token == toastToken
	end
	task.delay(1.8, function()
		if current() then
			UI.fadeText(t, 0.3, current)
		end
	end)
end

local countToken = 0
function HUD.Count(text: string)
	countToken += 1
	local token = countToken
	local c = refs.Count :: TextLabel
	c.Text = text
	UI.showText(c)
	UI.pop(c, 1.6)
	Sounds.Play("Tick")
	local function current(): boolean
		return token == countToken
	end
	task.delay(0.8, function()
		if current() then
			UI.fadeText(c, 0.2, current)
		end
	end)
end

function HUD.Feed(text: string)
	local feed = refs.Feed :: Frame
	local item = UI.new("Frame", {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = feed,
	}, { UI.corner(8), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) })
	UI.text({
		Text = text,
		Font = UI.Body,
		TextSize = 15,
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		StrokeThickness = 1,
		Parent = item,
	})
	local items = {}
	for _, c in feed:GetChildren() do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #items > 6 do
		(table.remove(items, 1) :: Frame):Destroy()
	end
	task.delay(8, function()
		if item.Parent then
			item:Destroy()
		end
	end)
end

function HUD.Popup(text: string, sub: string?)
	local holder = refs.Popups :: Frame
	local label = UI.text({
		Text = if sub then ('%s  <font size="15" color="#DDDDDD">%s</font>'):format(text, sub) else text,
		RichText = true,
		TextSize = 24,
		TextColor3 = C.Gem,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, math.random(-40, 40), 1, 0),
		Size = UDim2.fromOffset(400, 30),
		Parent = holder,
	})
	if string.find(text, "Coins") and not string.find(text, "Gems") then
		label.TextColor3 = C.Coin
	end
	UI.pop(label, 0.5)
	UI.tween(label, 1.4, { Position = UDim2.new(0.5, label.Position.X.Offset, 1, -120) })
	task.delay(1.0, function()
		UI.fadeText(label, 0.4)
	end)
	task.delay(1.5, function()
		label:Destroy()
	end)
end

---------------------------------------------------------------------------
-- Profile
---------------------------------------------------------------------------
function HUD.SetProfile(p: any)
	HUD.Profile = p
	if not p then
		return
	end
	refs.Gems.Text = "💎 " .. UI.formatNumber(p.Gems)
	refs.Coins.Text = "🪙 " .. UI.formatNumber(p.Coins)
	refs.Level.Text = ("Level %d   %d / %d xp"):format(p.Level, p.XP, p.XPNeeded)
	refs.XPFill.Size = UDim2.fromScale(math.clamp(p.XP / math.max(1, p.XPNeeded), 0, 1), 1)
end

---------------------------------------------------------------------------
-- Per-frame refresh
---------------------------------------------------------------------------
local PHASE_TEXT = {
	Waiting = "WAITING",
	Intermission = "INTERMISSION",
	Intro = "GET READY",
	Countdown = "GET READY",
	Crossing = "RUN!",
	Between = "CROSSING DONE",
	HeroChoice = "HERO OR CHICKEN?",
	HeroCountdown = "HERO RUN",
	HeroRun = "HERO RUN",
	Results = "MATCH OVER",
}

local function refresh()
	local phase = (State:GetAttribute("Phase") :: string?) or "Waiting"
	local r = role()
	local inMatch = r ~= "Lobby"
	local t = timeLeft()

	local crossing = (State:GetAttribute("Crossing") :: number?) or 0
	if (phase == "Crossing" or phase == "Countdown" or phase == "Between" or phase == "HeroRun") and crossing > 0 then
		refs.Phase.Text = ("CROSSING %d/%d"):format(crossing, Config.Match.CrossingsToWin)
	else
		refs.Phase.Text = PHASE_TEXT[phase] or string.upper(phase)
	end
	local status = (State:GetAttribute("Status") :: string?) or ""
	if r == "Lobby" and phase ~= "Waiting" and phase ~= "Intermission" and phase ~= "Results" then
		status = if player:GetAttribute("AFK") then "You're AFK - turn it off to play" else "Match in progress - you'll play the next one"
	elseif phase == "Intermission" and player:GetAttribute("AFK") then
		status = "You're AFK and will sit this one out"
	end
	refs.Status.Text = status
	refs.Timer.Text = fmtTime(t)
	refs.Timer.TextColor3 = if t >= 0 and t <= 5 and (phase == "Crossing" or phase == "HeroRun") then C.Bad else C.Text
	local runners = (State:GetAttribute("Runners") :: number?) or 0
	local chasers = (State:GetAttribute("Chasers") :: number?) or 0
	refs.Counts.Text = if runners + chasers > 0
		then ('<font color="#78F096">%d run</font>  <font color="#FF5555">%d chase</font>'):format(runners, chasers)
		else ""

	-- Crossing pips.
	local showPips = inMatch or (phase ~= "Waiting" and phase ~= "Intermission")
	refs.PipsFrame.Visible = showPips and crossing > 0
	for i, pip in refs.Pips do
		local done = i < crossing or (i == crossing and phase == "Between")
		pip.BackgroundColor3 = if done then C.Good elseif i == crossing then C.Accent else Color3.fromRGB(60, 64, 76)
	end

	-- Role badge.
	local style = ROLE_STYLE[r] or ROLE_STYLE.Lobby
	refs.RoleBadge.Visible = inMatch
	refs.RoleBadge.BackgroundColor3 = style.Color
	refs.RoleText.Text = style.Text

	-- Safe indicator.
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local dir = (State:GetAttribute("Direction") :: number?) or 1
	local target = Arena.TargetSide(dir)
	refs.Safe.Visible = r == "Runner" and root ~= nil and (phase == "Crossing" or phase == "HeroRun") and Arena.InSafeZone((root :: BasePart).Position, target)
	if refs.Safe.Visible then
		refs.Safe.Text = "SAFE ON SIDE " .. target
	end

	-- Action bar.
	local profile = HUD.Profile
	local bar = refs.ActionBar :: Frame
	bar.Visible = inMatch and not (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
	local isChaser = r == "Chaser"
	refs.DashSlot.Frame.Visible = not isChaser
	refs.StopSlot.Frame.Visible = not isChaser
	refs.SwingSlot.Frame.Visible = isChaser
	if profile then
		local abilityId = if isChaser then profile.Equipped.Chaser else profile.Equipped.Runner
		local def = Catalog.Abilities[abilityId]
		refs.AbilitySlot.Label.Text = if def then def.Name else "No ability"
		local readyAt = (player:GetAttribute("AbilityReadyAt") :: number?) or 0
		local cd = (player:GetAttribute("AbilityCooldown") :: number?) or 1
		local remain = readyAt - workspace:GetServerTimeNow()
		refs.AbilitySlot.Shade.Size = UDim2.fromScale(1, math.clamp(remain / cd, 0, 1))
		refs.AbilitySlot.Sub.Text = if remain > 0 then ("%.1fs"):format(remain) else "Ready"
		local itemId = profile.Equipped.Item
		local item = Catalog.Items[itemId]
		refs.ItemSlot.Label.Text = if item then item.Name else "No item"
		local charges = if item then (profile.Items[itemId] or 0) else 0
		local itemReady = (player:GetAttribute("ItemReadyAt") :: number?) or 0
		local itemCd = (player:GetAttribute("ItemCooldown") :: number?) or 1
		local itemRemain = itemReady - workspace:GetServerTimeNow()
		refs.ItemSlot.Shade.Size = UDim2.fromScale(1, math.clamp(itemRemain / itemCd, 0, 1))
		refs.ItemSlot.Sub.Text = if item then ("x%d left"):format(charges) else "Buy items in the shop"
	end
	local dashRemain = Movement.DashReadyAt - os.clock()
	refs.DashSlot.Shade.Size = UDim2.fromScale(1, math.clamp(dashRemain / Config.Movement.DashCooldown, 0, 1))
	refs.SwingSlot.Shade.Size = UDim2.fromScale(1, 1 - Input.SwingReadyFraction())

	-- Downed overlay.
	local downed = r == "Downed"
	refs.Downed.Visible = downed
	if downed and char then
		local untilT = char:GetAttribute("DownedUntil")
		if type(untilT) == "number" then
			local remain = untilT - workspace:GetServerTimeNow()
			refs.DownedFill.Size = UDim2.fromScale(math.clamp(remain / Config.Match.BleedOutTime, 0, 1), 1)
		end
		local kits = if profile then (profile.Items.RescueKit or 0) else 0
		local kitEquipped = profile and profile.Equipped.Item == "RescueKit"
		refs.DownedHint.Text = if kits > 0 and kitEquipped
			then ("Press F to use a Rescue Kit (%d left), or wait for a teammate"):format(kits)
			else "Wait for a teammate to revive you, or you'll join the chasers"
	end
	refs.Cloaked.Visible = char ~= nil and char:GetAttribute("Cloaked") == true

	-- Vote panel.
	local voting = phase == "Intermission" and not player:GetAttribute("AFK")
	refs.Vote.Visible = voting and not HUD.VoteHidden
	refs.VotePill.Visible = voting and HUD.VoteHidden
	if voting then
		local voted = nil
		for _, m in Config.Maps do
			if m.Id == HUD.MyVote then
				voted = m.Name
			end
		end
		refs.VotePill.Text = if voted then ("VOTED: %s  •  CHANGE"):format(string.upper(voted)) else "VOTE FOR THE MAP"
		for id, v in refs.VoteButtons do
			local n = (State:GetAttribute("Vote_" .. id) :: number?) or 0
			v.Count.Text = ("%d vote%s"):format(n, if n == 1 then "" else "s")
			v.Outline.Transparency = if HUD.MyVote == id then 0 else 1
		end
	elseif phase ~= "Intermission" then
		HUD.MyVote = nil
		HUD.VoteHidden = false
	end
	local mapId = State:GetAttribute("Map")
	refs.MapChosen.Visible = phase == "Intro"
	if refs.MapChosen.Visible then
		for id, pic in refs.MapChosenPictures do
			pic.Visible = id == mapId
		end
		local name = mapId
		for _, m in Config.Maps do
			if m.Id == mapId then
				name = m.Name
			end
		end
		refs.MapChosenTitle.Text = "MAP: " .. string.upper(tostring(name))
	end

	-- Boosts.
	if profile and profile.Boosts then
		local now = os.time()
		local parts = {}
		if (profile.Boosts.Gems or 0) > now then
			table.insert(parts, ("2x Gems %d:%02d"):format((profile.Boosts.Gems - now) // 60, (profile.Boosts.Gems - now) % 60))
		end
		if (profile.Boosts.Coins or 0) > now then
			table.insert(parts, ("2x Coins %d:%02d"):format((profile.Boosts.Coins - now) // 60, (profile.Boosts.Coins - now) % 60))
		end
		refs.Boost.Text = table.concat(parts, "   ")
	end
end

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------
function HUD.Start()
	gui = UI.new("ScreenGui", {
		Name = "BA_HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTop()
	buildCurrency()
	buildFeed()
	buildCenter()
	buildActionBar()
	buildDowned()
	buildVote()
	buildMapChosen()

	local Notify = Net.Event("Notify")
	Notify.OnClientEvent:Connect(function(n)
		if n.Kind == "Announce" then
			HUD.Announce(n.Text, n.Sub, n.Color)
			Sounds.Play(n.Sound)
		elseif n.Kind == "Toast" then
			HUD.Toast(n.Text, n.Color)
			Sounds.Play(n.Sound)
		elseif n.Kind == "Feed" then
			HUD.Feed(n.Text)
		elseif n.Kind == "Popup" then
			HUD.Popup(n.Text, n.Sub)
		elseif n.Kind == "Count" then
			HUD.Count(n.Text)
		end
	end)
	HeroChoice.OnClientEvent:Connect(showHeroChoice)
	Net.Event("Results").OnClientEvent:Connect(showResults)
	Net.Event("ProfileChanged").OnClientEvent:Connect(HUD.SetProfile)
	task.spawn(function()
		local ok, p = pcall(function()
			return Net.Function("GetProfile"):InvokeServer()
		end)
		if ok and p and not HUD.Profile then
			HUD.SetProfile(p)
		end
	end)

	local acc = 0
	local orbitT = 0
	RunService.RenderStepped:Connect(function(dt)
		if refs.Vote.Visible or refs.MapChosen.Visible then
			orbitT += dt
			for _, cam in previewCams do
				MapPreview.Orbit(cam, orbitT)
			end
		end
		acc += dt
		if acc >= 0.05 then
			acc = 0
			refresh()
		end
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!strict
-- Key, gamepad and touch bindings.
--
--   Space + A/D  dash        (gamepad A + stick)
--   Alt          stop        (gamepad B)
--   Q            ability     (gamepad Y)
--   F            item        (gamepad R1)
--   Click        swing       (gamepad R2)
--   E            revive      (prompt; gamepad X)

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Movement = require(script.Parent.Movement)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Input = {}

Input.OnSwing = nil :: (() -> ())?

local SwingRemote = Net.Event("Swing")
local AbilityRemote = Net.Event("UseAbility")
local ItemRemote = Net.Event("UseItem")

local lastSwing = -math.huge

local function role(): string
	return (player:GetAttribute("Role") :: string?) or "Lobby"
end

function Input.Swing()
	if role() ~= "Chaser" then
		return
	end
	local now = os.clock()
	if now - lastSwing < Config.Knife.Cooldown then
		return
	end
	local char = player.Character
	local stun = char and char:GetAttribute("StunUntil")
	if type(stun) == "number" and workspace:GetServerTimeNow() < stun then
		return
	end
	lastSwing = now
	SwingRemote:FireServer()
	Movement.Lunge()
	if Input.OnSwing then
		(Input.OnSwing :: () -> ())()
	end
end

function Input.SwingReadyFraction(): number
	return math.clamp((os.clock() - lastSwing) / Config.Knife.Cooldown, 0, 1)
end

function Input.Ability()
	AbilityRemote:FireServer()
end

function Input.Item()
	ItemRemote:FireServer()
end

local function bind(name: string, fn: () -> (), ...: Enum.KeyCode | Enum.UserInputType)
	ContextActionService:BindActionAtPriority(name, function(_, state)
		if state == Enum.UserInputState.Begin then
			fn()
		end
		return Enum.ContextActionResult.Sink
	end, false, 3000, ...)
end

---------------------------------------------------------------------------
-- Touch controls
---------------------------------------------------------------------------
local function buildTouch()
	local gui = UI.new("ScreenGui", {
		Name = "BA_Touch",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local holder = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(270, 230),
		Parent = gui,
	})
	local function circle(text: string, pos: UDim2, size: number, color: Color3, fn: () -> ()): TextButton
		local b = UI.button({ Text = text, Size = UDim2.fromOffset(size, size), Position = pos, Color = color, TextSize = math.floor(size * 0.24), Radius = size // 2, Parent = holder }, fn)
		b.BackgroundTransparency = 0.15
		return b
	end
	local swing = circle("SWING", UDim2.fromOffset(150, 110), 110, UI.Colors.Chaser, Input.Swing)
	local left = circle("◀", UDim2.fromOffset(20, 140), 64, UI.Colors.Blue, function()
		Movement.Dash(-1)
	end)
	local right = circle("▶", UDim2.fromOffset(150, 140), 64, UI.Colors.Blue, function()
		Movement.Dash(1)
	end)
	local stop = circle("STOP", UDim2.fromOffset(84, 160), 58, Color3.fromRGB(120, 120, 130), function()
		Movement.Stop()
	end)
	circle("Q", UDim2.fromOffset(70, 40), 58, UI.Colors.Accent, Input.Ability)
	circle("F", UDim2.fromOffset(0, 70), 54, UI.Colors.Good, Input.Item)
	local function refresh()
		local r = role()
		swing.Visible = r == "Chaser"
		left.Visible = r ~= "Chaser"
		right.Visible = r ~= "Chaser"
		stop.Visible = r ~= "Chaser"
	end
	player:GetAttributeChangedSignal("Role"):Connect(refresh)
	refresh()
end

function Input.Start()
	bind("BA_Dash", function()
		Movement.Dash(nil)
	end, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	bind("BA_Stop", function()
		Movement.Stop()
	end, Enum.KeyCode.LeftAlt, Enum.KeyCode.RightAlt, Enum.KeyCode.ButtonB)
	bind("BA_Ability", Input.Ability, Enum.KeyCode.Q, Enum.KeyCode.ButtonY)
	bind("BA_Item", Input.Item, Enum.KeyCode.F, Enum.KeyCode.ButtonR1)
	bind("BA_Swing", Input.Swing, Enum.KeyCode.ButtonR2)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			Input.Swing()
		end
	end)
	if UserInputService.TouchEnabled then
		task.spawn(buildTouch)
	end
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="33">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Break Ankles client entry point.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local Effects = require(script.Parent.Effects)
local HUD = require(script.Parent.HUD)
local Input = require(script.Parent.Input)
local Menus = require(script.Parent.Menus)
local Movement = require(script.Parent.Movement)
local Sounds = require(script.Parent.Sounds)

local player = Players.LocalPlayer
local State = Net.State()

-- Hide the bits of the default UI this game doesn't use, and turn off the
-- reset button (resetting would let you dodge a catch).
local function core()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end
task.spawn(core)

Movement.Start()
Input.Start()
Effects.Start()
HUD.Start()
Menus.Start()

Movement.OnDash = function()
	Sounds.Play("Dash", 1.1)
	Effects.LocalDash()
end
Movement.OnStop = function()
	Sounds.Play("Stop", 1.3)
end
Input.OnSwing = function()
	Effects.LocalSwing()
end

-- Server impulses aimed at this character.
Net.Event("Knock").OnClientEvent:Connect(function(k)
	if k.Kind == "Impulse" then
		Movement.Impulse(k.Velocity, k.Lock or 0.3)
	elseif k.Kind == "Rocket" then
		Movement.Rocket()
	end
end)

-- Music follows the match phase.
local function music()
	local phase = State:GetAttribute("Phase")
	local role = player:GetAttribute("Role")
	if role ~= "Lobby" and (phase == "Crossing" or phase == "HeroRun" or phase == "Countdown") then
		Sounds.Music("Chase")
	else
		Sounds.Music("Lobby")
	end
end
State:GetAttributeChangedSignal("Phase"):Connect(music)
player:GetAttributeChangedSignal("Role"):Connect(music)
music()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MapPreview</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a small 3D model of a map inside a ViewportFrame for the vote
-- cards: the striped field, safe zones, lines, arches, fences, hills and
-- trees or cacti, in the same colors the real arena uses.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arena = require(Shared.Arena)
local Themes = require(Shared.Themes)

local HALF_L = Arena.HalfLength
local HALF_W = Arena.HalfWidth
local DEPTH = Arena.SafeDepth

local MapPreview = {}

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- A fixed pseudo-random sequence so every client sees the same preview.
local function seq(seed: number): () -> number
	local s = seed
	return function(): number
		s = (s * 16807) % 2147483647
		return s / 2147483647
	end
end

local function decor(model: Model, themeId: string, rand: () -> number)
	local valley = themeId ~= "Dunes"
	for _ = 1, 22 do
		-- pick a spot outside the fence
		local x, z
		repeat
			x = (rand() * 2 - 1) * (HALF_W + 70)
			z = (rand() * 2 - 1) * (HALF_L + DEPTH + 60)
		until math.abs(x) > HALF_W + 8 or math.abs(z) > HALF_L + DEPTH + 8
		if valley then
			local h = 10 + rand() * 6
			part(model, Vector3.new(h, 2.4, 2.4), CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(110, 76, 48), Enum.Material.Wood, Enum.PartType.Cylinder)
			local s = 10 + rand() * 4
			part(model, Vector3.new(s, s, s), CFrame.new(x, h + 2, z), Color3.fromRGB(60 + math.floor(rand() * 30), 130 + math.floor(rand() * 30), 52), Enum.Material.Grass, Enum.PartType.Ball)
		else
			local h = 8 + rand() * 5
			part(model, Vector3.new(h, 2.6, 2.6), CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(80, 140, 70), Enum.Material.Grass, Enum.PartType.Cylinder)
			part(model, Vector3.new(3.5, 1.6, 1.6), CFrame.new(x + 1.8, h * 0.55, z), Color3.fromRGB(80, 140, 70), Enum.Material.Grass)
			part(model, Vector3.new(3.2, 1.6, 1.6), CFrame.new(x + 3, h * 0.55 + 1.6, z) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(80, 140, 70), Enum.Material.Grass, Enum.PartType.Cylinder)
		end
	end
	local rockColor = if valley then Color3.fromRGB(120, 120, 124) else Color3.fromRGB(176, 120, 84)
	for _ = 1, 10 do
		local x = (if rand() < 0.5 then -1 else 1) * (HALF_W + 12 + rand() * 50)
		local z = (rand() * 2 - 1) * (HALF_L + DEPTH)
		local s = 4 + rand() * 5
		part(model, Vector3.new(s * 1.3, s * 0.7, s), CFrame.new(x, s * 0.25, z) * CFrame.Angles(0, rand() * 6, 0), rockColor, Enum.Material.Slate)
	end
end

-- Returns the camera so callers can orbit it.
function MapPreview.Build(viewport: ViewportFrame, themeId: string): Camera
	viewport:ClearAllChildren()
	local theme = Themes.Get(themeId)
	local model = Instance.new("Model")
	model.Name = "Preview"

	part(model, Vector3.new(520, 2, 680), CFrame.new(0, -1.1, 0), theme.SurroundColor, theme.Surround)
	part(model, Vector3.new(HALF_W * 2, 1, HALF_L * 2), CFrame.new(0, -0.45, 0), theme.GroundColor, theme.Ground)
	local stripes = 11
	local len = HALF_L * 2 / stripes
	for i = 0, stripes - 1, 2 do
		part(model, Vector3.new(HALF_W * 2, 0.1, len), CFrame.new(0, 0.1, -HALF_L + len * (i + 0.5)), theme.StripeColor, theme.Ground)
	end
	for _, side in { "A", "B" } do
		local sign = if side == "A" then -1 else 1
		part(model, Vector3.new(HALF_W * 2, 1, DEPTH), CFrame.new(0, -0.45, sign * (HALF_L + DEPTH / 2)), theme.SafeColor, theme.SafeMaterial)
		part(model, Vector3.new(HALF_W * 2, 0.2, 2), CFrame.new(0, 0.15, sign * HALF_L), Color3.new(1, 1, 1))
		-- arch
		local color = Themes.SideColors[side]
		for _, sx in { -1, 1 } do
			part(model, Vector3.new(2.6, 20, 2.6), CFrame.new(sx * (HALF_W + 2), 10, sign * HALF_L), Color3.fromRGB(40, 42, 48), Enum.Material.Metal)
		end
		part(model, Vector3.new(HALF_W * 2 + 6, 4, 1.4), CFrame.new(0, 21, sign * HALF_L), color)
	end
	-- fences
	local outer = HALF_L + DEPTH
	for _, sx in { -1, 1 } do
		part(model, Vector3.new(0.6, 3.4, outer * 2), CFrame.new(sx * (HALF_W + 1), 1.7, 0), theme.FenceColor, Enum.Material.Wood)
	end
	for _, sz in { -1, 1 } do
		part(model, Vector3.new(HALF_W * 2 + 2, 3.4, 0.6), CFrame.new(0, 1.7, sz * (outer + 1)), theme.FenceColor, Enum.Material.Wood)
	end
	-- hills
	local rand = seq(if themeId == "Dunes" then 4831 else 1384)
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		local s = 120 + rand() * 80
		part(model, Vector3.new(s, s, s), CFrame.new(math.cos(a) * 230, -s * 0.4, math.sin(a) * 300), theme.HillColor, theme.HillMaterial, Enum.PartType.Ball)
	end
	decor(model, themeId, rand)
	model.Parent = viewport

	local cam = Instance.new("Camera")
	cam.FieldOfView = 38
	cam.CFrame = CFrame.lookAt(Vector3.new(210, 190, 260), Vector3.new(0, 0, 0))
	cam.Parent = viewport
	viewport.CurrentCamera = cam
	viewport.Ambient = theme.Lighting.Ambient or Color3.fromRGB(120, 120, 130)
	viewport.LightColor = Color3.fromRGB(255, 248, 235)
	viewport.LightDirection = Vector3.new(-0.6, -1, -0.4)
	return cam
end

-- Orbit the camera around the field; `t` is seconds.
function MapPreview.Orbit(cam: Camera, t: number)
	local a = t * 0.25
	local pos = Vector3.new(math.cos(a) * 330, 190, math.sin(a) * 330)
	cam.CFrame = CFrame.lookAt(pos, Vector3.zero)
end

return MapPreview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby menus: the shop (abilities, items, knives, titles), codes, and the
-- AFK toggle.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Net = require(Shared.Net)
local HUD = require(script.Parent.HUD)
local Sounds = require(script.Parent.Sounds)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local ShopRemote = Net.Function("Shop")
local C = UI.Colors

local Menus = {}

local gui: ScreenGui
local shopWindow: Frame
local codesWindow: Frame
local grid: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local currentTab = "Runner"
local message: TextLabel

local function invoke(action: string, a: any?, b: any?): any
	local ok, result = pcall(function()
		return ShopRemote:InvokeServer(action, a, b)
	end)
	if not ok or type(result) ~= "table" then
		return { Ok = false, Message = "Couldn't reach the server" }
	end
	return result
end

local function flash(text: string, good: boolean)
	message.Text = text
	message.TextColor3 = if good then C.Good else C.Bad
	message.TextTransparency = 0
	UI.pop(message, 0.8)
	Sounds.Play(if good then "Gem" else "Click", if good then 1.2 else 0.8)
end

---------------------------------------------------------------------------
-- Shop cards
---------------------------------------------------------------------------
local function card(order: number, title: string, desc: string, accent: Color3): (Frame, Frame)
	local f = UI.panel({ Size = UDim2.fromOffset(250, 170), Color = C.Panel2, LayoutOrder = order, Parent = grid })
	UI.new("Frame", {
		BackgroundColor3 = accent,
		Size = UDim2.new(1, 0, 0, 6),
		BorderSizePixel = 0,
		Parent = f,
	}, { UI.corner(3) })
	UI.text({ Text = title, TextSize = 21, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 12), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
	UI.text({
		Text = desc,
		Font = UI.Body,
		TextSize = 13,
		TextColor3 = C.Muted,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, -20, 0, 70),
		Position = UDim2.fromOffset(10, 42),
		StrokeThickness = 1,
		Parent = f,
	})
	local footer = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 10, 1, -48),
		Size = UDim2.new(1, -20, 0, 40),
		Parent = f,
	})
	return f, footer
end

local function priceLabel(text: string, color: Color3, parent: Instance)
	UI.text({ Text = text, TextSize = 18, TextColor3 = color, Size = UDim2.new(0.5, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = parent })
end

local function actionButton(text: string, color: Color3, parent: Instance, fn: () -> ())
	UI.button({ Text = text, TextSize = 17, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromScale(0.5, 0), Color = color, Parent = parent }, fn)
end

local function refreshShop()
	if not shopWindow or not shopWindow.Visible then
		return
	end
	for _, c in grid:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for name, b in tabButtons do
		b.BackgroundColor3 = if name == currentTab then C.Accent else Color3.fromRGB(70, 74, 88)
	end
	local p = HUD.Profile
	if not p then
		return
	end
	local function act(action: string, id: string)
		task.spawn(function()
			local result = invoke(action, id)
			flash(result.Message, result.Ok)
		end)
	end
	if currentTab == "Runner" or currentTab == "Chaser" then
		for i, def in Catalog.Sorted(Catalog.Abilities, function(a)
			return a.Role == currentTab
		end) do
			local owned = p.OwnedAbilities[def.Id]
			local equipped = p.Equipped[def.Role] == def.Id
			local _, footer = card(i, def.Name, def.Description .. ("\nCooldown %ds"):format(def.Cooldown), def.Color)
			if owned then
				priceLabel("Owned", C.Good, footer)
			else
				priceLabel(("💎 %s"):format(UI.formatNumber(def.Price)), C.Gem, footer)
			end
			if equipped then
				actionButton("EQUIPPED", Color3.fromRGB(70, 74, 88), footer, function() end)
			elseif owned then
				actionButton("EQUIP", C.Blue, footer, function()
					act("EquipAbility", def.Id)
				end)
			else
				actionButton("BUY", if p.Gems >= def.Price then C.Good else Color3.fromRGB(110, 110, 120), footer, function()
					act("BuyAbility", def.Id)
				end)
			end
		end
	elseif currentTab == "Items" then
		for i, def in Catalog.Sorted(Catalog.Items) do
			local count = p.Items[def.Id] or 0
			local roles = {}
			for r in def.Roles do
				table.insert(roles, r)
			end
			table.sort(roles)
			local desc = def.Description .. ("\n%d per pack • %s • You have %d"):format(def.Charges, table.concat(roles, "/"), count)
			local f, footer = card(i, def.Name, desc, def.Color)
			priceLabel(("🪙 %d"):format(def.Price), C.Coin, footer)
			actionButton("BUY", if p.Coins >= def.Price then C.Good else Color3.fromRGB(110, 110, 120), footer, function()
				act("BuyItem", def.Id)
			end)
			if count > 0 then
				local equipped = p.Equipped.Item == def.Id
				UI.button({
					Text = if equipped then "EQUIPPED" else "EQUIP",
					TextSize = 14,
					Size = UDim2.fromOffset(90, 26),
					Position = UDim2.new(1, -100, 0, 12),
					Color = if equipped then Color3.fromRGB(70, 74, 88) else C.Blue,
					Parent = f,
				}, function()
					if not equipped then
						act("EquipItem", def.Id)
					end
				end)
			end
		end
	elseif currentTab == "Knives" then
		for i, def in Catalog.Sorted(Catalog.Knives) do
			local owned = p.OwnedKnives[def.Id]
			local equipped = p.Equipped.Knife == def.Id
			local _, footer = card(i, def.Name .. " Knife", "A cosmetic blade for when you're chasing.", def.Blade)
			if owned then
				priceLabel("Owned", C.Good, footer)
			else
				priceLabel(("💎 %s"):format(UI.formatNumber(def.Price)), C.Gem, footer)
			end
			if equipped then
				actionButton("EQUIPPED", Color3.fromRGB(70, 74, 88), footer, function() end)
			elseif owned then
				actionButton("EQUIP", C.Blue, footer, function()
					act("EquipKnife", def.Id)
				end)
			else
				actionButton("BUY", if p.Gems >= def.Price then C.Good else Color3.fromRGB(110, 110, 120), footer, function()
					act("BuyKnife", def.Id)
				end)
			end
		end
	elseif currentTab == "Titles" then
		for i, def in Catalog.Sorted(Catalog.Titles) do
			local owned = p.OwnedTitles[def.Id]
			local equipped = p.Equipped.Title == def.Id
			local _, footer = card(i, def.Name, def.Hint, def.Color)
			priceLabel(if owned then "Unlocked" else "Locked", if owned then C.Good else C.Muted, footer)
			if equipped then
				actionButton("EQUIPPED", Color3.fromRGB(70, 74, 88), footer, function() end)
			elseif owned then
				actionButton("EQUIP", C.Blue, footer, function()
					act("EquipTitle", def.Id)
				end)
			end
		end
	end
end

local function buildShop()
	shopWindow = UI.panel({
		Name = "Shop",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromScale(0.94, 0.82),
		Visible = false,
		Parent = gui,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(860, 520), Parent = shopWindow })
	UI.text({ Text = "SHOP", TextSize = 34, Size = UDim2.fromOffset(200, 40), Position = UDim2.fromOffset(20, 10), TextXAlignment = Enum.TextXAlignment.Left, Parent = shopWindow })
	UI.button({ Text = "X", TextSize = 20, Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -52, 0, 12), Color = C.Bad, Parent = shopWindow }, function()
		shopWindow.Visible = false
		Sounds.Play("Click")
	end)
	message = UI.text({ Text = "", Font = UI.Body, TextSize = 16, Size = UDim2.new(1, -320, 0, 24), Position = UDim2.fromOffset(160, 18), Parent = shopWindow })
	local tabs = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 58),
		Size = UDim2.new(1, -40, 0, 38),
		Parent = shopWindow,
	}, { UI.list(Enum.FillDirection.Horizontal, 8) })
	local tabNames = { { "Runner", "Runner Abilities" }, { "Chaser", "Chaser Abilities" }, { "Items", "Items" }, { "Knives", "Knives" }, { "Titles", "Titles" } }
	for i, t in tabNames do
		local id, label = t[1], t[2]
		tabButtons[id] = UI.button({ Text = label, TextSize = 16, Size = UDim2.fromOffset(152, 36), LayoutOrder = i, Color = Color3.fromRGB(70, 74, 88), Parent = tabs }, function()
			currentTab = id
			Sounds.Play("Click")
			refreshShop()
		end)
	end
	grid = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(20, 106),
		Size = UDim2.new(1, -40, 1, -120),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = shopWindow,
	})
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(256, 176),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	UI.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), Parent = grid })
end

---------------------------------------------------------------------------
-- Codes
---------------------------------------------------------------------------
local function buildCodes()
	codesWindow = UI.panel({
		Name = "Codes",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(400, 220),
		Visible = false,
		Parent = gui,
	})
	UI.text({ Text = "CODES", TextSize = 30, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 10), Parent = codesWindow })
	UI.button({ Text = "X", TextSize = 18, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(1, -44, 0, 10), Color = C.Bad, Parent = codesWindow }, function()
		codesWindow.Visible = false
	end)
	local box = UI.new("TextBox", {
		PlaceholderText = "Enter code",
		Text = "",
		ClearTextOnFocus = false,
		Font = UI.Display,
		TextSize = 22,
		TextColor3 = Color3.new(0, 0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(30, 60),
		Size = UDim2.new(1, -60, 0, 46),
		Parent = codesWindow,
	}, { UI.corner(10) })
	local result = UI.text({ Text = "", Font = UI.Body, TextSize = 15, TextWrapped = true, Size = UDim2.new(1, -40, 0, 36), Position = UDim2.fromOffset(20, 112), Parent = codesWindow })
	UI.button({ Text = "REDEEM", TextSize = 22, Size = UDim2.fromOffset(180, 46), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Color = C.Good, Parent = codesWindow }, function()
		task.spawn(function()
			local r = invoke("Redeem", box.Text)
			result.Text = r.Message
			result.TextColor3 = if r.Ok then C.Good else C.Bad
			Sounds.Play(if r.Ok then "Win" else "Click")
		end)
	end)
end

---------------------------------------------------------------------------
-- Side buttons
---------------------------------------------------------------------------
function Menus.OpenShop(tab: string?)
	if tab then
		currentTab = tab
	end
	codesWindow.Visible = false
	shopWindow.Visible = true
	UI.pop(shopWindow, 0.85)
	refreshShop()
end

local function buildSide()
	local side = UI.new("Frame", {
		Name = "Side",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 204),
		Size = UDim2.fromOffset(120, 200),
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Vertical, 8) })
	UI.button({ Text = "SHOP", TextSize = 22, Size = UDim2.fromOffset(120, 46), Color = C.Accent, LayoutOrder = 1, Parent = side }, function()
		Sounds.Play("Click")
		if shopWindow.Visible then
			shopWindow.Visible = false
		else
			local r = player:GetAttribute("Role")
			Menus.OpenShop(if r == "Chaser" then "Chaser" else nil)
		end
	end)
	UI.button({ Text = "CODES", TextSize = 22, Size = UDim2.fromOffset(120, 46), Color = C.Blue, LayoutOrder = 2, Parent = side }, function()
		Sounds.Play("Click")
		shopWindow.Visible = false
		codesWindow.Visible = not codesWindow.Visible
		if codesWindow.Visible then
			UI.pop(codesWindow, 0.85)
		end
	end)
	local afk: TextButton
	afk = UI.button({ Text = "AFK: OFF", TextSize = 18, Size = UDim2.fromOffset(120, 40), Color = Color3.fromRGB(90, 96, 110), LayoutOrder = 3, Parent = side }, function()
		Sounds.Play("Click")
		local want = not player:GetAttribute("AFK")
		task.spawn(function()
			invoke("SetAFK", want)
		end)
	end)
	local function refreshAfk()
		local on = player:GetAttribute("AFK") == true
		afk.Text = if on then "AFK: ON" else "AFK: OFF"
		afk.BackgroundColor3 = if on then C.Bad else Color3.fromRGB(90, 96, 110)
	end
	player:GetAttributeChangedSignal("AFK"):Connect(refreshAfk)
	refreshAfk()
end

function Menus.Start()
	gui = UI.new("ScreenGui", {
		Name = "BA_Menus",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildShop()
	buildCodes()
	buildSide()
	Net.Event("ProfileChanged").OnClientEvent:Connect(function()
		task.defer(refreshShop)
	end)
	-- The shop stall in the lobby opens the shop.
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who == player and prompt.Name == "ShopPrompt" then
			Menus.OpenShop()
		end
	end)
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- The local movement controller. Roblox's default controls still read your
-- keys or thumbstick; this script turns that input into momentum and hands
-- the humanoid a direction and speed every frame, after the default
-- controls have run.
--
--   * acceleration and a short slide when you let go
--   * Space + A/D: lateral dash (runners), keeps your facing so it reads as a juke
--   * Alt: instant stop
--   * stuns, trips, slows and boosts set by the server

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local MoveMath = require(Shared.MoveMath)
local Net = require(Shared.Net)

local Mv = Config.Movement
local player = Players.LocalPlayer
local Juke = Net.Event("Juke")

local Movement = {}

Movement.DashReadyAt = 0
Movement.OnDash = nil :: ((dir: Vector3) -> ())?
Movement.OnStop = nil :: (() -> ())?

local controls: any = nil
local vel = Vector3.zero
local dashUntil = 0
local dashDir = Vector3.zero
local dashSpeed = 0
local dashKeepsFacing = false
local lockUntil = 0
local nextStop = 0
local fallen = false

local function getControls(): any
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
		return (require :: any)(module):GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

local function character(): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return char, hum, root
end

-- Camera-relative basis on the ground plane.
local function cameraBasis(): (Vector3, Vector3)
	local cam = workspace.CurrentCamera
	local look = MoveMath.FlatUnit(cam.CFrame.LookVector, MoveMath.FlatUnit(cam.CFrame.UpVector, Vector3.new(0, 0, -1)))
	local right = Vector3.new(-look.Z, 0, look.X)
	return look, right
end

local function rawInput(): Vector3
	local c = getControls()
	if not c then
		return Vector3.zero
	end
	local ok, mv = pcall(function()
		return c:GetMoveVector()
	end)
	return if ok and typeof(mv) == "Vector3" then mv else Vector3.zero
end

local function worldInput(): Vector3
	local mv = rawInput()
	if mv.Magnitude < 0.05 then
		return Vector3.zero
	end
	local look, right = cameraBasis()
	local world = right * mv.X + look * -mv.Z
	if world.Magnitude > 1 then
		world = world.Unit
	end
	return world
end

local function role(): string
	return (player:GetAttribute("Role") :: string?) or "Lobby"
end

local function fovKick(amount: number)
	local cam = workspace.CurrentCamera
	local base = 70
	cam.FieldOfView = base + amount
	TweenService:Create(cam, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
end

local function startDash(dir: Vector3, speed: number, duration: number, keepFacing: boolean)
	local _, hum = character()
	dashDir = MoveMath.FlatUnit(dir, Vector3.new(0, 0, -1))
	dashSpeed = speed
	dashUntil = os.clock() + duration
	dashKeepsFacing = keepFacing
	if hum and keepFacing then
		hum.AutoRotate = false
	end
end

local function stunnedNow(char: Model): (boolean, string?)
	local t = char:GetAttribute("StunUntil")
	if type(t) == "number" and workspace:GetServerTimeNow() < t then
		return true, char:GetAttribute("StunKind") :: string?
	end
	return false, nil
end

local function canAct(): boolean
	local char, hum = character()
	if not char or not hum or role() == "Downed" or fallen then
		return false
	end
	if char:GetAttribute("Channeling") then
		return false
	end
	local stunned = stunnedNow(char)
	return not stunned
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------
-- side: -1 left, 1 right; nil reads it from the keys being held.
function Movement.Dash(side: number?): boolean
	local r = role()
	if r == "Chaser" or not canAct() then
		return false
	end
	local now = os.clock()
	if now < Movement.DashReadyAt then
		return false
	end
	local mv = rawInput()
	local lateral = side
	if not lateral then
		if math.abs(mv.X) < 0.3 then
			return false -- no forward dash: hold A or D
		end
		lateral = if mv.X > 0 then 1 else -1
	end
	local look, right = cameraBasis()
	local forward = math.clamp(-mv.Z, -1, 1)
	local dir = right * (lateral :: number) + look * forward * 0.55
	startDash(dir, Mv.DashSpeed, Mv.DashTime, true)
	Movement.DashReadyAt = now + Mv.DashCooldown
	if r == "Runner" then
		Juke:FireServer("Dash")
	end
	fovKick(6)
	if Movement.OnDash then
		(Movement.OnDash :: (Vector3) -> ())(dashDir)
	end
	return true
end

function Movement.Stop(): boolean
	if not canAct() then
		return false
	end
	local now = os.clock()
	if now < nextStop then
		return false
	end
	nextStop = now + Mv.StopCooldown
	vel = Vector3.zero
	dashUntil = 0
	local _, hum, root = character()
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
	end
	if hum then
		hum:Move(Vector3.zero)
		hum.AutoRotate = true
	end
	if role() == "Runner" then
		Juke:FireServer("Stop")
	end
	if Movement.OnStop then
		(Movement.OnStop :: () -> ())()
	end
	return true
end

-- Chaser's little forward burst on a swing.
function Movement.Lunge()
	local _, _, root = character()
	if root and canAct() then
		startDash(root.CFrame.LookVector, Mv.LungeSpeed, Mv.LungeTime, false)
	end
end

-- Rocket Shoes: where you're moving, or where the camera looks if standing still.
function Movement.Rocket()
	local input = worldInput()
	local dir = input
	if dir.Magnitude < 0.1 then
		dir = (cameraBasis())
	end
	startDash(dir, Mv.RocketSpeed, Mv.RocketTime, false)
	fovKick(12)
end

function Movement.Impulse(velocity: Vector3, lock: number)
	vel = MoveMath.Flat(velocity)
	dashUntil = 0
	lockUntil = os.clock() + lock
	local _, hum = character()
	if hum then
		hum.AutoRotate = true
	end
end

---------------------------------------------------------------------------
-- Frame step
---------------------------------------------------------------------------
local function setFallen(want: boolean, hum: Humanoid, root: BasePart)
	if want == fallen then
		return
	end
	fallen = want
	if want then
		hum.PlatformStand = true
		root.AssemblyAngularVelocity = root.CFrame.RightVector * 7
		root.AssemblyLinearVelocity += Vector3.new(0, 6, 0)
	else
		hum.PlatformStand = false
		local p = root.Position
		local look = MoveMath.FlatUnit(root.CFrame.LookVector, Vector3.new(0, 0, -1))
		local char = player.Character
		if char then
			char:PivotTo(CFrame.lookAt(Vector3.new(p.X, p.Y + 2, p.Z), Vector3.new(p.X, p.Y + 2, p.Z) + look))
		end
		root.AssemblyAngularVelocity = Vector3.zero
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

local function step(dt: number)
	local char, hum, root = character()
	if not char or not hum or not root or hum.Health <= 0 then
		return
	end
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	local r = role()
	local stunned, kind = stunnedNow(char)
	local wantFallen = r == "Downed" or (stunned and kind == "Trip")
	setFallen(wantFallen, hum, root)

	if wantFallen or stunned or char:GetAttribute("Channeling") then
		vel = Vector3.zero
		dashUntil = 0
		hum.WalkSpeed = 0
		hum:Move(Vector3.zero)
		return
	end

	local maxSpeed = MoveMath.MaxSpeed(r) * MoveMath.SpeedMult(char, serverNow)
	if now < dashUntil then
		hum.WalkSpeed = dashSpeed
		hum:Move(dashDir)
		vel = dashDir * maxSpeed -- carry momentum out of the dash
		return
	end
	if dashKeepsFacing then
		dashKeepsFacing = false
		hum.AutoRotate = true
	end

	local input = if now < lockUntil then Vector3.zero else worldInput()
	local hasInput = input.Magnitude > 0.01
	local accel = MoveMath.Accel(r) * (if MoveMath.Boosted(char, serverNow) then 1.3 else 1)
	vel = MoveMath.Approach(vel, input * maxSpeed, hasInput, accel, dt)
	local speed = vel.Magnitude
	hum.WalkSpeed = speed
	hum:Move(if speed > 0.3 then vel.Unit else Vector3.zero)
end

local function onCharacter(char: Model)
	vel = Vector3.zero
	dashUntil = 0
	fallen = false
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum then
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum.UseJumpPower = true
		hum.JumpPower = 0
		hum.AutoRotate = true
	end
end

function Movement.Start()
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)
	RunService:BindToRenderStep("BA_Movement", Enum.RenderPriority.Character.Value + 5, step)
	task.spawn(getControls)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--!strict
-- Plays the sounds named in Config.Sounds, plus looping music.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local Sounds = {}

local cache: { [string]: Sound } = {}
local folder = Instance.new("Folder")
folder.Name = "BA_Sounds"
folder.Parent = SoundService

local VOLUME: { [string]: number } = {
	Swing = 0.6,
	Lunge = 0.4,
	Down = 0.8,
	Dash = 0.35,
	Stop = 0.4,
	AnkleBreak = 0.8,
	Gem = 0.45,
	Click = 0.5,
	Tick = 0.6,
	Win = 0.6,
	Horn = 0.8,
}

local function get(name: string): Sound?
	local id = (Config.Sounds :: any)[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local s = cache[name]
	if not s then
		local created = Instance.new("Sound")
		created.Name = name
		created.SoundId = id
		created.Volume = VOLUME[name] or 0.5
		created.Parent = folder
		cache[name] = created
		return created
	end
	return s
end

function Sounds.Play(name: string?, pitch: number?)
	if not name then
		return
	end
	local s = get(name)
	if not s then
		return
	end
	local clone = s:Clone()
	clone.PlaybackSpeed = pitch or 1
	clone.Parent = folder
	clone:Play()
	clone.Ended:Once(function()
		clone:Destroy()
	end)
	task.delay(6, function()
		if clone.Parent then
			clone:Destroy()
		end
	end)
end

-- 3D sound at a position (others' swings, airhorns, traps).
function Sounds.PlayAt(name: string, position: Vector3, pitch: number?)
	local s = get(name)
	if not s then
		return
	end
	local holder = Instance.new("Attachment")
	holder.WorldPosition = position
	holder.Parent = workspace.Terrain
	local clone = s:Clone()
	clone.PlaybackSpeed = pitch or 1
	clone.RollOffMaxDistance = 140
	clone.RollOffMinDistance = 10
	clone.Parent = holder
	clone:Play()
	task.delay(5, function()
		holder:Destroy()
	end)
end

local music: Sound? = nil
local musicKey: string? = nil

function Sounds.Music(key: string?)
	if key == musicKey then
		return
	end
	musicKey = key
	local old = music
	if old then
		TweenService:Create(old, TweenInfo.new(1), { Volume = 0 }):Play()
		task.delay(1.1, function()
			old:Destroy()
		end)
		music = nil
	end
	local id = if key then (Config.Music :: any)[key] else nil
	if type(id) ~= "string" or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.Parent = folder
	s:Play()
	TweenService:Create(s, TweenInfo.new(1.5), { Volume = 0.35 }):Play()
	music = s
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- Small helpers for building UI in code, plus the shared look.

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Panel = Color3.fromRGB(22, 24, 32),
	Panel2 = Color3.fromRGB(34, 37, 48),
	Stroke = Color3.fromRGB(0, 0, 0),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(170, 176, 190),
	Gem = Color3.fromRGB(196, 110, 255),
	Coin = Color3.fromRGB(255, 205, 60),
	Runner = Color3.fromRGB(120, 240, 150),
	Chaser = Color3.fromRGB(255, 85, 85),
	Accent = Color3.fromRGB(255, 190, 50),
	Blue = Color3.fromRGB(80, 170, 255),
	Good = Color3.fromRGB(90, 220, 120),
	Bad = Color3.fromRGB(235, 80, 80),
}

UI.Display = Enum.Font.FredokaOne
UI.Body = Enum.Font.GothamBold
UI.Light = Enum.Font.Gotham

-- new("Frame", { Size = ..., Parent = ... }, { children })
function UI.new(className: string, props: { [string]: any }?, children: { any }?): any
	local inst = Instance.new(className)
	if props then
		local parent = props.Parent
		for k, v in props do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
		if children then
			for _, c in children do
				c.Parent = inst
			end
		end
		if parent then
			inst.Parent = parent
		end
	elseif children then
		for _, c in children do
			c.Parent = inst
		end
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.stroke(thickness: number?, color: Color3?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Thickness = thickness or 2,
		Color = color or UI.Colors.Stroke,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UI.borderStroke(thickness: number?, color: Color3?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Thickness = thickness or 2,
		Color = color or UI.Colors.Stroke,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return UI.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UI.list(direction: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.gradient(top: Color3, bottom: Color3): UIGradient
	return UI.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
	})
end

function UI.text(props: { [string]: any }): TextLabel
	local t = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = UI.Display,
		TextColor3 = UI.Colors.Text,
		TextScaled = false,
		TextSize = 20,
	})
	for k, v in props do
		if k ~= "Parent" and k ~= "Stroke" and k ~= "StrokeThickness" then
			(t :: any)[k] = v
		end
	end
	if props.Stroke ~= false then
		UI.stroke(props.StrokeThickness or 2).Parent = t
	end
	if props.Parent then
		t.Parent = props.Parent
	end
	return t
end

-- A chunky button with a press bounce. `onClick` runs on activation.
function UI.button(props: { [string]: any }, onClick: () -> ()): TextButton
	local color: Color3 = props.Color or UI.Colors.Accent
	local b = UI.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Font = UI.Display,
		TextColor3 = props.TextColor or UI.Colors.Text,
		TextSize = props.TextSize or 20,
		Text = props.Text or "",
		Size = props.Size or UDim2.fromOffset(140, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Name = props.Name or "Button",
	})
	UI.corner(props.Radius or 10).Parent = b
	UI.gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)).Parent = b
	UI.borderStroke(2.5, Color3.new(0, 0, 0), 0.2).Parent = b
	local textStroke = UI.stroke(2)
	textStroke.Parent = b
	local scale = UI.new("UIScale", { Scale = 1, Parent = b })
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.05 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	b.Activated:Connect(function()
		scale.Scale = 0.92
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		onClick()
	end)
	if props.Parent then
		b.Parent = props.Parent
	end
	return b
end

function UI.panel(props: { [string]: any }): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = props.Color or UI.Colors.Panel,
		BackgroundTransparency = props.Transparency or 0.08,
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Name = props.Name or "Panel",
		Visible = if props.Visible == nil then true else props.Visible,
		LayoutOrder = props.LayoutOrder or 0,
	})
	UI.corner(props.Radius or 14).Parent = f
	UI.borderStroke(2, Color3.new(0, 0, 0), 0.35).Parent = f
	if props.Parent then
		f.Parent = props.Parent
	end
	return f
end

function UI.pop(inst: GuiObject, from: number?)
	local scale = inst:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = inst })
	scale.Scale = from or 0.6
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function UI.tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- Text labels carry a UIStroke outline; fading only TextTransparency leaves
-- the outline behind. These fade/show both, and hide the label when done.
function UI.showText(label: TextLabel)
	label.TextTransparency = 0
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	label.Visible = true
end

function UI.fadeText(label: TextLabel, time: number, isCurrent: (() -> boolean)?)
	UI.tween(label, time, { TextTransparency = 1 })
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		UI.tween(stroke, time, { Transparency = 1 })
	end
	task.delay(time, function()
		if not isCurrent or isCurrent() then
			label.Visible = false
		end
	end)
end

function UI.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="39">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>