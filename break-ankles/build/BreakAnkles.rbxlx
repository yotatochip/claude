		Size = UDim2.fromOffset(600, 50),
		Parent = overlay,
	})
	refs.DownedHint = UI.text({
		Text = "",
		Font = UI.Body,
		TextSize = 18,
		AnchorPoint = Vector2.new(0.5, 0),
