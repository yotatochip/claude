          <string name="Name">Arena</string>
          <string name="Source"><![CDATA[--!strict
-- Arena geometry shared by the server and clients. The field runs along Z.
-- Side A sits at -Z, side B at +Z. Direction 1 means runners go A -> B.

local Config = require(script.Parent.Config)

local A = Config.Arena
local HALF_L = A.Length / 2
local HALF_W = A.Width / 2

local Arena = {}

Arena.HalfLength = HALF_L
Arena.HalfWidth = HALF_W
Arena.SafeDepth = A.SafeDepth

-- Z of the line for a side ("A" or "B").
function Arena.LineZ(side: string): number
	return if side == "A" then -HALF_L else HALF_L
end

function Arena.StartSide(direction: number): string
	return if direction == 1 then "A" else "B"
end

function Arena.TargetSide(direction: number): string
	return if direction == 1 then "B" else "A"
end

function Arena.InSafeZone(pos: Vector3, side: string): boolean
	if math.abs(pos.X) > HALF_W + 1 then
		return false
	end
	if side == "A" then
		return pos.Z < -HALF_L and pos.Z > -HALF_L - A.SafeDepth - 2
	end
	return pos.Z > HALF_L and pos.Z < HALF_L + A.SafeDepth + 2
end

function Arena.OnField(pos: Vector3): boolean
	return math.abs(pos.X) <= HALF_W and math.abs(pos.Z) <= HALF_L
end

-- Anywhere inside the fenced area (field plus both safe zones).
function Arena.InBounds(pos: Vector3): boolean
	return math.abs(pos.X) <= HALF_W + 4
		and math.abs(pos.Z) <= HALF_L + A.SafeDepth + 4
		and pos.Y > -20
		and pos.Y < 60
end

-- A spread of standing spots inside a safe zone.
function Arena.SafeSpot(side: string, index: number, count: number): CFrame
	local cols = math.max(1, math.min(count, 8))
	local row = (index - 1) // cols
	local col = (index - 1) % cols
	local spacing = math.min(12, (A.Width - 20) / cols)
	local x = (col - (cols - 1) / 2) * spacing
	local depth = 8 + row * 6
	local z = if side == "A" then -HALF_L - depth else HALF_L + depth
	local facing = if side == "A" then Vector3.new(0, 0, 1) else Vector3.new(0, 0, -1)
	local pos = Vector3.new(x, 3, z)
	return CFrame.lookAt(pos, pos + facing)
end

-- Where chasers start a crossing: midfield, facing the runners.
function Arena.ChaserSpot(index: number, count: number, direction: number): CFrame
	local spacing = 14
	local x = (index - (count + 1) / 2) * spacing
	local pos = Vector3.new(x, 3, 0)
	local startZ = Arena.LineZ(Arena.StartSide(direction))
	return CFrame.lookAt(pos, Vector3.new(x, 3, startZ))
end

function Arena.LobbyCenter(): Vector3
	return A.LobbyOffset
end

return Arena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[--!strict
-- Everything players can own: abilities (gems), consumables (coins),
-- knife skins (gems) and titles. Both the shop UI and the server read this.

export type Ability = {
	Id: string,
	Name: string,
	Role: "Runner" | "Chaser",
	Price: number, -- gems, 0 = free starter
	Cooldown: number,
	Description: string,
	Color: Color3,
	Order: number,
}

export type Item = {
	Id: string,
	Name: string,
	Price: number, -- coins per pack
	Charges: number, -- uses per pack
	Cooldown: number,
	Roles: { [string]: boolean },
	Description: string,
	Color: Color3,
	Order: number,
}

export type Knife = {
	Id: string,
	Name: string,
	Price: number,
	Blade: Color3,
	BladeMaterial: Enum.Material,
	Handle: Color3,
	Glow: boolean,
	Order: number,
}

local Catalog = {}

Catalog.Abilities = {
	-- Runner abilities ------------------------------------------------------
	OneHitShield = {
		Id = "OneHitShield", Name = "One Hit Shield", Role = "Runner", Price = 0, Cooldown = 12, Order = 1,
		Description = "Raise a shield that blocks the next knife hit for 0.75 seconds. Time it right.",
		Color = Color3.fromRGB(90, 200, 255),
	},
	PocketDoor = {
		Id = "PocketDoor", Name = "Pocket Door", Role = "Runner", Price = 875, Cooldown = 20, Order = 2,
		Description = "Slam down a door between you and the chaser. Chasers must smash it or go around. Lasts 6 seconds.",
		Color = Color3.fromRGB(196, 138, 80),
	},
	EmergencyAirhorn = {
		Id = "EmergencyAirhorn", Name = "Emergency Airhorn", Role = "Runner", Price = 1450, Cooldown = 25, Order = 3,
		Description = "Blast every nearby chaser backward in all directions.",
		Color = Color3.fromRGB(255, 214, 60),
	},
	Cloak = {
		Id = "Cloak", Name = "Cloak", Role = "Runner", Price = 1625, Cooldown = 22, Order = 4,
		Description = "Vanish for 3 seconds. You can still be hit, and using an item ends it.",
		Color = Color3.fromRGB(170, 120, 255),
	},
	-- Chaser abilities ------------------------------------------------------
	BearTrap = {
		Id = "BearTrap", Name = "Bear Trap", Role = "Chaser", Price = 0, Cooldown = 14, Order = 1,
		Description = "Toss a trap 10 studs ahead. The first runner to step in is stuck for half a second. Lasts 12 seconds.",
		Color = Color3.fromRGB(150, 150, 160),
	},
	BowlingBall = {
		Id = "BowlingBall", Name = "Bowling Ball", Role = "Chaser", Price = 600, Cooldown = 12, Order = 2,
		Description = "Roll a ball along the ground. A direct hit trips the runner.",
		Color = Color3.fromRGB(60, 90, 220),
	},
	BigDagger = {
		Id = "BigDagger", Name = "Big Dagger", Role = "Chaser", Price = 1125, Cooldown = 16, Order = 3,
		Description = "Double your reach for your next swing. Expires after 5 seconds.",
		Color = Color3.fromRGB(230, 80, 80),
	},
	RocketShoes = {
		Id = "RocketShoes", Name = "Rocket Shoes", Role = "Chaser", Price = 1300, Cooldown = 10, Order = 4,
		Description = "Blast forward in the direction you're moving, or where you're looking if you're standing still.",
		Color = Color3.fromRGB(255, 120, 40),
	},
	RufusLeash = {
		Id = "RufusLeash", Name = "Rufus's Leash", Role = "Chaser", Price = 1625, Cooldown = 16, Order = 5,
		Description = "Throw a leash up to 15 studs ahead. A hit yanks the runner 6 studs toward you.",
		Color = Color3.fromRGB(120, 220, 120),
	},
} :: { [string]: Ability }

Catalog.Items = {
	BananaPeel = {
		Id = "BananaPeel", Name = "Banana Peel", Price = 135, Charges = 3, Cooldown = 3, Order = 1,
		Roles = { Runner = true, Chaser = true },
		Description = "Drop a peel. The first opponent to step on it slips and falls.",
		Color = Color3.fromRGB(255, 225, 70),
	},
	RescueKit = {
		Id = "RescueKit", Name = "Rescue Kit", Price = 203, Charges = 3, Cooldown = 1, Order = 2,
		Roles = { Runner = true },
		Description = "Picks you back up when you're downed. No teammate needed.",
		Color = Color3.fromRGB(240, 70, 70),
	},
	Adrenaline = {
		Id = "Adrenaline", Name = "Adrenaline", Price = 135, Charges = 3, Cooldown = 3, Order = 3,
		Roles = { Runner = true, Chaser = true },
		Description = "Five seconds of extra speed and sharper cornering.",
		Color = Color3.fromRGB(80, 230, 160),
	},
} :: { [string]: Item }

Catalog.Knives = {
	Classic = { Id = "Classic", Name = "Classic", Price = 0, Order = 1,
		Blade = Color3.fromRGB(205, 210, 215), BladeMaterial = Enum.Material.Metal, Handle = Color3.fromRGB(60, 40, 30), Glow = false },
	Rusty = { Id = "Rusty", Name = "Rusty", Price = 300, Order = 2,
		Blade = Color3.fromRGB(150, 90, 50), BladeMaterial = Enum.Material.CorrodedMetal, Handle = Color3.fromRGB(80, 60, 40), Glow = false },
	Candy = { Id = "Candy", Name = "Candy Cane", Price = 600, Order = 3,
		Blade = Color3.fromRGB(255, 90, 110), BladeMaterial = Enum.Material.SmoothPlastic, Handle = Color3.fromRGB(255, 255, 255), Glow = false },
	Neon = { Id = "Neon", Name = "Neon", Price = 900, Order = 4,
		Blade = Color3.fromRGB(60, 255, 200), BladeMaterial = Enum.Material.Neon, Handle = Color3.fromRGB(25, 25, 30), Glow = true },
	Gold = { Id = "Gold", Name = "Gold", Price = 1500, Order = 5,
		Blade = Color3.fromRGB(255, 200, 60), BladeMaterial = Enum.Material.Foil, Handle = Color3.fromRGB(120, 20, 20), Glow = false },
	Ghost = { Id = "Ghost", Name = "Ghost", Price = 2500, Order = 6,
		Blade = Color3.fromRGB(170, 200, 255), BladeMaterial = Enum.Material.ForceField, Handle = Color3.fromRGB(200, 220, 255), Glow = true },
} :: { [string]: Knife }

-- Titles show above your head. Most are earned, not bought.
Catalog.Titles = {
	Rookie = { Id = "Rookie", Name = "Rookie", Color = Color3.fromRGB(220, 220, 220), Order = 1, Hint = "Everyone starts here" },
	AnkleBreaker = { Id = "AnkleBreaker", Name = "Ankle Breaker", Color = Color3.fromRGB(255, 170, 60), Order = 2, Hint = "Code reward" },
	Flawless = { Id = "Flawless", Name = "Flawless", Color = Color3.fromRGB(120, 230, 255), Order = 3, Hint = "Win a match where nobody gets caught" },
	Hero = { Id = "Hero", Name = "Hero", Color = Color3.fromRGB(255, 225, 90), Order = 4, Hint = "Finish a Hero run" },
	Menace = { Id = "Menace", Name = "Menace", Color = Color3.fromRGB(255, 80, 80), Order = 5, Hint = "Catch 25 runners" },
	Untouchable = { Id = "Untouchable", Name = "Untouchable", Color = Color3.fromRGB(190, 140, 255), Order = 6, Hint = "Break 50 ankles" },
	Veteran = { Id = "Veteran", Name = "Veteran", Color = Color3.fromRGB(150, 255, 150), Order = 7, Hint = "Reach level 15" },
}

-- Sorted list helper for UIs.
function Catalog.Sorted<T>(map: { [string]: T }, filter: ((T) -> boolean)?): { T }
	local list = {}
	for _, v in map do
		if not filter or filter(v) then
			table.insert(list, v)
		end
	end
	table.sort(list, function(a: any, b: any)
		return a.Order < b.Order
	end)
	return list
end

Catalog.StarterRunnerAbility = "OneHitShield"
Catalog.StarterChaserAbility = "BearTrap"

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Every tuning number in Break Ankles lives here, so you can rebalance the
-- game without touching the systems that use them.

local Config = {}

Config.GameName = "Break Ankles"
Config.DataStoreName = "BreakAnkles_Profiles_v1"

---------------------------------------------------------------------------
-- Match flow
---------------------------------------------------------------------------
Config.Match = {
	MinPlayers = 2, -- real players needed to start when bots are off
	Intermission = 20, -- seconds of lobby time between matches
	CrossingsToWin = 3, -- runners must survive this many crossings
	Countdown = 3, -- "3, 2, 1, RUN!!" before each crossing
	CrossingTime = 40, -- seconds to reach the far side
	BetweenCrossings = 5,
	BleedOutTime = 10, -- how long a downed runner waits for a rescue
	ReviveHoldTime = 2.5, -- hold E this long next to a downed teammate
	ReviveRange = 8,
	ResultsTime = 9,
	PlayersPerChaser = 8, -- one starting chaser per this many players (min 1)
	ConvertGraceTime = 1.5, -- a freshly converted chaser can't swing for this long
	-- Hero or Chicken: before crossing 2 or 3 one runner may be offered a solo run
	HeroChance = 0.45,
	HeroChoiceTime = 7,
	HeroCrossingTime = 20,
}

---------------------------------------------------------------------------
-- Bots fill empty slots so the game is playable solo and in quiet servers.
---------------------------------------------------------------------------
Config.Bots = {
	Enabled = true,
	FillTo = 6, -- bots top the match up to this many participants
	Names = {
		"Kenji", "Mara", "Dex", "Lulu", "Tobi", "Rook", "Zia", "Bo",
		"Nico", "Pip", "Juno", "Rex", "Ivy", "Otto", "Sage", "Quinn",
	},
	ReactionTime = { 0.12, 0.3 }, -- chaser bots wait this long before swinging
	FakeOutChance = 0.4, -- chance a chaser bot bites on a runner's juke
	RunnerDashChance = 0.75, -- chance a runner bot jukes when a chaser closes in
}

---------------------------------------------------------------------------
-- Movement: acceleration-based momentum, lateral dash, instant stop.
---------------------------------------------------------------------------
Config.Movement = {
	RunnerSpeed = 22,
	ChaserSpeed = 22.5,
	LobbySpeed = 20,
	RunnerAccel = 80, -- studs/s² toward the input direction
	ChaserAccel = 66, -- chasers turn a little wider, which is what makes jukes work
	Friction = 46, -- studs/s² of slowdown after you let go (the slide)

	DashSpeed = 64,
	DashTime = 0.16,
	DashCooldown = 0.9,
	StopCooldown = 0.35,

	LungeSpeed = 34, -- chaser's forward burst on a swing
	LungeTime = 0.12,

	RocketSpeed = 82, -- Rocket Shoes
	RocketTime = 0.24,
}

---------------------------------------------------------------------------
-- The knife and ankle breaking
---------------------------------------------------------------------------
Config.Knife = {
	Reach = 6,
	Leniency = 1.5, -- extra server-side reach to cover ping
	HalfAngle = 80, -- degrees either side of where the chaser faces
	CloseRange = 3.5, -- inside this, any angle hits
	Windup = 0.1,
	Cooldown = 1.0,
	MissSlowMult = 0.5,
	MissSlowTime = 0.55,
	-- Ankle break: the swing misses a runner who juked (dash or instant stop)
	-- within JukeWindow seconds while inside JukeRange studs.
	JukeWindow = 0.8,
	JukeRange = 12,
	AnkleStunTime = 1.25,
}

---------------------------------------------------------------------------
-- Economy. Gems buy abilities, coins buy consumables.
---------------------------------------------------------------------------
Config.Rewards = {
	CrossingGems = 15,
	CrossingCoins = 25,
	SurviveGems = 60,
	SurviveCoins = 80,
	FlawlessGems = 40, -- every runner survived every crossing
	CatchGems = 20,
	CatchCoins = 30,
	ChaserWinGems = 60,
	ChaserWinCoins = 80,
	AnkleBreakGems = 15,
	RescueGems = 20,
	HeroGems = 100,
	ParticipationCoins = 10,
	FieldGemValue = 5,
	FieldGemsPerCrossing = 14,

	CrossingXP = 30,
	SurviveXP = 120,
	CatchXP = 40,
	AnkleBreakXP = 25,
	RescueXP = 50, -- rescuing gives a big XP boost
	ChaserWinXP = 100,
	ParticipationXP = 20,
}

-- XP needed to go from `level` to `level + 1`.
function Config.XPForLevel(level: number): number
	return 100 + (level - 1) * 40
end

---------------------------------------------------------------------------
-- Codes. Each reward table can grant Gems, Coins, timed Boosts (seconds of
-- 2x gems / 2x coins) and a Title (an id from Catalog.Titles).
---------------------------------------------------------------------------
Config.Codes = {
	BREAKANKLES = { Gems = 250, Boosts = { Gems = 15 * 60, Coins = 15 * 60 }, Title = "AnkleBreaker" },
	FIRSTCROSSING = { Gems = 150, Coins = 200 },
}

---------------------------------------------------------------------------
-- Developer products for Robux gem packs. Create them under the experience's
-- Monetization > Developer Products page and paste the IDs in here.
---------------------------------------------------------------------------
Config.Products = {
	-- [1234567890] = { Gems = 1000 },
}

---------------------------------------------------------------------------
-- Sounds. Built-in Roblox sounds are used by default. Upload your own audio
-- and paste "rbxassetid://<id>" here to replace any of them.
---------------------------------------------------------------------------
Config.Sounds = {
	Swing = "rbxasset://sounds/swordslash.wav",
	Lunge = "rbxasset://sounds/swordlunge.wav",
	Equip = "rbxasset://sounds/unsheath.wav",
	Down = "rbxasset://sounds/uuhhh.mp3",
	Dash = "rbxasset://sounds/Rocket whoosh 01.wav",
	Stop = "rbxasset://sounds/action_jump_land.mp3",
	AnkleBreak = "rbxasset://sounds/glassbreak.wav",
	Gem = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/button.wav",
	Tick = "rbxasset://sounds/clickfast.wav",
	Safe = "rbxasset://sounds/electronicpingshort.wav",
	Win = "rbxasset://sounds/victory.wav",
	Horn = "rbxasset://sounds/Launching rocket.wav",
	Trap = "rbxasset://sounds/collide.wav",
	Trip = "rbxasset://sounds/action_falling.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
}

-- Background music. Leave empty for none, or paste "rbxassetid://<id>".
Config.Music = {
	Lobby = "",
	Chase = "",
}

---------------------------------------------------------------------------
-- Art made with ForgeGUI and uploaded to the creator's Roblox account.
-- The lobby poster shows Poster; if it ever fails to load, the text title
-- underneath shows instead.
---------------------------------------------------------------------------
Config.Art = {
	Poster = "rbxassetid://91723483788506", -- game thumbnail art
	Icon = "rbxassetid://98979542296379", -- game icon art
}

---------------------------------------------------------------------------
-- Arena dimensions (studs). The field runs along Z: side A is at -Z.
---------------------------------------------------------------------------
Config.Arena = {
	Length = 220, -- line to line
	Width = 120,
	SafeDepth = 32, -- depth of each safe zone beyond its line
	WallHeight = 40,
	LobbyOffset = Vector3.new(-150, 26, 0),
}

-- Image is the vote-card picture (ForgeGUI art on the creator's account).
-- Leave it empty to show only the live 3D preview of the map.
Config.Maps = {
	{ Id = "Valley", Name = "The Valley", Blurb = "Rolling green field", Image = "rbxassetid://122661598565232" },
	{ Id = "Dunes", Name = "The Dunes", Blurb = "Sun-baked sand flats", Image = "rbxassetid://132328319131981" },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MoveMath</string>
          <string name="Source"><![CDATA[--!strict
-- Momentum math shared by the player controller and the bots, so both move
-- the same way.

local Config = require(script.Parent.Config)

local Mv = Config.Movement

local MoveMath = {}

-- Speed multiplier from slows and boosts written as attributes (server time).
function MoveMath.SpeedMult(model: Instance, serverNow: number): number
	local mult = 1
	local slowUntil = model:GetAttribute("SlowUntil")
	if type(slowUntil) == "number" and serverNow < slowUntil then
		mult *= (model:GetAttribute("SlowMult") :: number?) or 1
	end
	local boostUntil = model:GetAttribute("BoostUntil")
	if type(boostUntil) == "number" and serverNow < boostUntil then
		mult *= (model:GetAttribute("BoostMult") :: number?) or 1
	end
	return mult
end

function MoveMath.Boosted(model: Instance, serverNow: number): boolean
	local boostUntil = model:GetAttribute("BoostUntil")
	return type(boostUntil) == "number" and serverNow < boostUntil
end

function MoveMath.MaxSpeed(role: string?): number
	if role == "Chaser" then
		return Mv.ChaserSpeed
	elseif role == "Runner" then
		return Mv.RunnerSpeed
	end
	return Mv.LobbySpeed
end

function MoveMath.Accel(role: string?): number
	return if role == "Chaser" then Mv.ChaserAccel else Mv.RunnerAccel
end

-- Move `vel` toward `desired`, accelerating while there's input and sliding
-- to a stop under friction when there isn't.
function MoveMath.Approach(vel: Vector3, desired: Vector3, hasInput: boolean, accel: number, dt: number): Vector3
	local rate = if hasInput then accel else Mv.Friction
	-- Above top speed (after a knockback) always bleed off with friction.
	if vel.Magnitude > desired.Magnitude + 0.5 and vel.Magnitude > MoveMath.MaxSpeed("Chaser") * 1.4 then
		rate = math.max(rate, Mv.Friction)
	end
	local diff = desired - vel
	local step = rate * dt
	if diff.Magnitude <= step then
		return desired
	end
	return vel + diff.Unit * step
end

function MoveMath.Flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function MoveMath.FlatUnit(v: Vector3, fallback: Vector3?): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-3 then
		return fallback or Vector3.zero
	end
	return f.Unit
end

return MoveMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- One place that names every remote. The server creates them, clients wait
-- for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Swing", -- client -> server: chaser swings the knife
	"Juke", -- client -> server: runner dashed or stopped (for ankle breaks)
	"UseAbility", -- client -> server
	"UseItem", -- client -> server
	"HeroChoice", -- both ways: offer, then the runner's answer
	"Notify", -- server -> client: banners, feed lines, toasts, sounds
	"Effect", -- server -> all: visual effects other players should see
	"Knock", -- server -> client: impulses applied to your own character
	"ProfileChanged", -- server -> client: your saved data changed
	"Results", -- server -> client: end of match breakdown
}

local FUNCTIONS = {
	"GetProfile",
	"Shop", -- buy, equip, redeem, vote, AFK
}

local Net = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing :: Folder
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local f = Instance.new("RemoteFunction")
			f.Name = name
			f.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.Event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

-- Match state lives as attributes on this folder so every client sees it.
function Net.State(): Folder
	if RunService:IsServer() then
		local s = ReplicatedStorage:FindFirstChild("MatchState")
		if not s then
			s = Instance.new("Folder")
			s.Name = "MatchState"
			s.Parent = ReplicatedStorage
		end
		return s :: Folder
	end
	return ReplicatedStorage:WaitForChild("MatchState") :: Folder
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Themes</string>
          <string name="Source"><![CDATA[--!strict
-- The look of each map: ground, fences, hills, decor and lighting. The
-- server builds the real arena from this and clients build the small vote
-- previews from it, so the two always match.

local Themes = {}

export type Theme = {
	Ground: Enum.Material,
	GroundColor: Color3,
	StripeColor: Color3,
	Surround: Enum.Material,
	SurroundColor: Color3,
	SafeMaterial: Enum.Material,
	SafeColor: Color3,
	FenceColor: Color3,
	HillMaterial: Enum.Material,
	HillColor: Color3,
	Lighting: { [string]: any },
	Atmosphere: { [string]: any },
	Tint: Color3,
	Decor: string,
}

Themes.Themes = ({
	Valley = {
		Ground = Enum.Material.Grass,
		GroundColor = Color3.fromRGB(86, 158, 64),
		StripeColor = Color3.fromRGB(98, 172, 72),
		Surround = Enum.Material.Grass,
		SurroundColor = Color3.fromRGB(74, 138, 58),
		SafeMaterial = Enum.Material.Ground,
		SafeColor = Color3.fromRGB(176, 150, 108),
		FenceColor = Color3.fromRGB(120, 86, 56),
		HillMaterial = Enum.Material.Grass,
		HillColor = Color3.fromRGB(68, 130, 56),
		Lighting = {
			ClockTime = 14.2,
			Brightness = 2.6,
			Ambient = Color3.fromRGB(88, 92, 104),
			OutdoorAmbient = Color3.fromRGB(140, 142, 152),
		},
		Atmosphere = {
			Density = 0.28,
			Offset = 0.1,
			Color = Color3.fromRGB(199, 222, 255),
			Decay = Color3.fromRGB(108, 140, 182),
			Glare = 0.2,
			Haze = 1.2,
		},
		Tint = Color3.fromRGB(255, 255, 255),
		Decor = "Valley",
	},
	Dunes = {
		Ground = Enum.Material.Sand,
		GroundColor = Color3.fromRGB(222, 192, 136),
		StripeColor = Color3.fromRGB(230, 202, 148),
		Surround = Enum.Material.Sand,
		SurroundColor = Color3.fromRGB(214, 180, 122),
		SafeMaterial = Enum.Material.Sandstone,
		SafeColor = Color3.fromRGB(196, 150, 104),
		FenceColor = Color3.fromRGB(150, 110, 70),
		HillMaterial = Enum.Material.Sand,
		HillColor = Color3.fromRGB(224, 186, 124),
		Lighting = {
			ClockTime = 16.6,
			Brightness = 3.1,
			Ambient = Color3.fromRGB(110, 96, 86),
			OutdoorAmbient = Color3.fromRGB(160, 140, 124),
		},
		Atmosphere = {
			Density = 0.34,
			Offset = 0.15,
			Color = Color3.fromRGB(255, 226, 184),
			Decay = Color3.fromRGB(214, 160, 112),
			Glare = 0.4,
			Haze = 2.0,
		},
		Tint = Color3.fromRGB(255, 244, 230),
		Decor = "Dunes",
	},
}) :: { [string]: Theme }

Themes.SideColors = {
	A = Color3.fromRGB(60, 140, 255),
	B = Color3.fromRGB(255, 140, 40),
}

function Themes.Get(id: string): Theme
	return Themes.Themes[id] or Themes.Themes.Valley
end

return Themes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Abilities</string>
          <string name="Source"><![CDATA[--!strict
-- Q uses your role's equipped ability; F uses your equipped consumable.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Net = require(Shared.Net)
local Arena = require(Shared.Arena)
local Combat = require(script.Parent.Combat)
local DataService = require(script.Parent.DataService)
local Hazards = require(script.Parent.Hazards)
local Phase = require(script.Parent.Phase)
local Roster = require(script.Parent.Roster)
local Status = require(script.Parent.Status)

local Effect = Net.Event("Effect")
local Notify = Net.Event("Notify")

local Abilities = {}

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else Vector3.new(0, 0, 1)
end

local function tell(entry: any, payload: { [string]: any })
	if entry.Player then
		Notify:FireClient(entry.Player, payload)
	end
end

---------------------------------------------------------------------------
-- Ability handlers
---------------------------------------------------------------------------
local handlers: { [string]: (entry: any, root: BasePart) -> () } = {}

handlers.OneHitShield = function(entry, _root)
	entry.ShieldUntil = os.clock() + 0.75
	Effect:FireAllClients({ Kind = "Shield", Model = entry.Model, Duration = 0.75 })
end

handlers.PocketDoor = function(entry, root)
	Hazards.PocketDoor(entry, root)
end

handlers.EmergencyAirhorn = function(_entry, root)
	local origin = root.Position
	for _, e in Roster.WithRole("Chaser") do
		local r = Roster.Root(e)
		if r then
			local offset = r.Position - origin
			local d = Vector3.new(offset.X, 0, offset.Z).Magnitude
			if d <= 16 then
				local push = flat(offset) * (78 - d * 2)
				Status.Impulse(e, push, 0.45)
				Status.Slow(e, 0.6, 1.0)
				tell(e, { Kind = "Toast", Text = "AIRHORN!", Color = Color3.fromRGB(255, 214, 60) })
			end
		end
	end
	Effect:FireAllClients({ Kind = "Airhorn", Position = origin })
end

handlers.Cloak = function(entry, _root)
	local untilT = os.clock() + 3
	entry.CloakUntil = untilT
	Roster.SetCloak(entry, true)
	Effect:FireAllClients({ Kind = "Cloak", Model = entry.Model })
	task.delay(3, function()
		if entry.CloakUntil == untilT then
			Roster.SetCloak(entry, false)
		end
	end)
end

handlers.BearTrap = function(entry, root)
	Hazards.BearTrap(entry, root.Position + flat(root.CFrame.LookVector) * 10)
	Effect:FireAllClients({ Kind = "Toss", Model = entry.Model })
end

handlers.BowlingBall = function(entry, root)
	Hazards.BowlingBall(entry, root.Position, root.CFrame.LookVector)
	Effect:FireAllClients({ Kind = "Toss", Model = entry.Model })
end

handlers.BigDagger = function(entry, _root)
	local untilT = os.clock() + 5
	entry.BigDaggerUntil = untilT
	Roster.SetKnifeBig(entry, true)
	task.delay(5, function()
		if entry.BigDaggerUntil == untilT then
			entry.BigDaggerUntil = 0
			Roster.SetKnifeBig(entry, false)
		end
	end)
end

handlers.RocketShoes = function(entry, _root)
	Status.Rocket(entry)
	Effect:FireAllClients({ Kind = "Rocket", Model = entry.Model })
end

handlers.RufusLeash = function(entry, root)
	local origin = root.Position
	local dir = flat(root.CFrame.LookVector)
	local range = 15
	local hit, hitAlong = nil, math.huge
	for _, e in Roster.WithRole("Runner") do
		local r = Roster.Root(e)
		if r and not Arena.InSafeZone(r.Position, "A") and not Arena.InSafeZone(r.Position, "B") then
			local rel = r.Position - origin
			local along = rel:Dot(dir)
			if along > 0 and along <= range + 1 then
				local lateral = (Vector3.new(rel.X, 0, rel.Z) - dir * along).Magnitude
				if lateral <= 3.2 and along < hitAlong then
					hit, hitAlong = e, along
				end
			end
		end
	end
	local endPoint = origin + dir * (if hit then hitAlong else range)
	Effect:FireAllClients({ Kind = "Leash", Model = entry.Model, To = endPoint, Hit = hit and hit.Model })
	if hit then
		-- Friction brings the yank to rest after about 6 studs.
		local pull = flat(origin - (Roster.Root(hit) :: BasePart).Position) * 23.5
		Status.Impulse(hit, pull, 0.35)
		Status.Slow(hit, 0.6, 0.7)
		tell(hit, { Kind = "Toast", Text = "LEASHED!", Color = Color3.fromRGB(120, 220, 120), Sound = "Trap" })
	end
end

---------------------------------------------------------------------------
-- Use
---------------------------------------------------------------------------
function Abilities.Use(entry: any): boolean
	local role = entry.Role
	if (role ~= "Runner" and role ~= "Chaser") or not entry.InMatch or not Phase.IsLive() then
		return false
	end
	if Status.IsStunned(entry) then
		return false
	end
	local root = Roster.Root(entry)
	if not root then
		return false
	end
	local loadout = Roster.Loadout(entry)
	local id = if role == "Runner" then loadout.Runner else loadout.Chaser
	local def = Catalog.Abilities[id]
	if not def or def.Role ~= role then
		return false
	end
	local now = os.clock()
	if now < (entry.AbilityReady[role] or 0) then
		return false
	end
	if role == "Runner" and (Arena.InSafeZone(root.Position, "A") or Arena.InSafeZone(root.Position, "B")) and id ~= "Cloak" then
		tell(entry, { Kind = "Toast", Text = "Step onto the field to use that", Color = Color3.fromRGB(220, 220, 220) })
		return false
	end
	entry.AbilityReady[role] = now + def.Cooldown
	if entry.Player then
		entry.Player:SetAttribute("AbilityReadyAt", workspace:GetServerTimeNow() + def.Cooldown)
		entry.Player:SetAttribute("AbilityCooldown", def.Cooldown)
	end
	if role == "Chaser" and entry.CloakUntil > 0 then
		Roster.SetCloak(entry, false)
	end
	local handler = handlers[id]
	if handler then
		handler(entry, root)
	end
	return true
end

function Abilities.UseItem(entry: any): boolean
	if not entry.InMatch or not Phase.InArena() then
		return false
	end
	local loadout = Roster.Loadout(entry)
	local id = loadout.Item
	local def = Catalog.Items[id]
	if not def then
		return false
	end
	local role = entry.Role
	local now = os.clock()
	if now < entry.ItemReadyAt then
		return false
	end
	if id == "RescueKit" then
		if role ~= "Downed" then
			tell(entry, { Kind = "Toast", Text = "Rescue Kits work when you're downed", Color = Color3.fromRGB(220, 220, 220) })
			return false
		end
	elseif not def.Roles[role] or not Phase.IsLive() or Status.IsStunned(entry) then
		return false
	end
	-- Spend a charge (bots have unlimited).
	if entry.Player then
		local p = DataService.Get(entry.Player)
		if not p or (p.Items[id] or 0) <= 0 then
			tell(entry, { Kind = "Toast", Text = "Out of " .. def.Name .. ". Buy more in the shop.", Color = Color3.fromRGB(255, 160, 160) })
			return false
		end
		DataService.Mutate(entry.Player, function(prof)
			prof.Items[id] -= 1
			if prof.Items[id] <= 0 then
				prof.Items[id] = nil
				prof.Equipped.Item = ""
			end
		end)
		entry.Player:SetAttribute("ItemReadyAt", workspace:GetServerTimeNow() + def.Cooldown)
		entry.Player:SetAttribute("ItemCooldown", def.Cooldown)
	end
	entry.ItemReadyAt = now + def.Cooldown
	-- Using an item ends Cloak.
	if entry.CloakUntil > 0 then
		Roster.SetCloak(entry, false)
	end
	local root = Roster.Root(entry)
	if id == "RescueKit" then
		Combat.Revive(entry, nil)
	elseif id == "BananaPeel" and root then
		Hazards.BananaPeel(entry, root.Position - flat(root.CFrame.LookVector) * 2.5)
	elseif id == "Adrenaline" then
		Status.Boost(entry, 1.25, 5)
		Effect:FireAllClients({ Kind = "Adrenaline", Model = entry.Model })
		tell(entry, { Kind = "Toast", Text = "ADRENALINE!", Color = Color3.fromRGB(80, 230, 160), Sound = "Dash" })
	end
	return true
end

function Abilities.Start()
	Net.Event("UseAbility").OnServerEvent:Connect(function(player)
		local e = Roster.ForPlayer(player)
		if e then
			Abilities.Use(e)
		end
	end)
	Net.Event("UseItem").OnServerEvent:Connect(function(player)
		local e = Roster.ForPlayer(player)
		if e then
			Abilities.UseItem(e)
		end
	end)
end

return Abilities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Bots</string>
          <string name="Source"><![CDATA[--!strict
-- Bots fill empty slots so a match always has people to juke and chase.
-- They move with the same momentum rules as players and use the same
-- Combat/Abilities entry points, so they can break ankles and get theirs
-- broken.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arena = require(Shared.Arena)
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local MoveMath = require(Shared.MoveMath)
local Net = require(Shared.Net)
local Abilities = require(script.Parent.Abilities)
local Combat = require(script.Parent.Combat)
local Gems = require(script.Parent.Gems)
local Phase = require(script.Parent.Phase)
local Roster = require(script.Parent.Roster)
local Status = require(script.Parent.Status)

local Mv = Config.Movement
local B = Config.Bots

local Effect = Net.Event("Effect")

local Bots = {}

local bots: { any } = {}
local rng = Random.new()

-- Roblox's default R15 animations (public, owned by Roblox).
local ANIMS = {
	Idle = "rbxassetid://507766666",
	Run = "rbxassetid://507767714",
}

local SKINS = {
	Color3.fromRGB(255, 220, 177), Color3.fromRGB(234, 184, 146), Color3.fromRGB(196, 140, 98),
	Color3.fromRGB(141, 85, 54), Color3.fromRGB(99, 61, 40), Color3.fromRGB(253, 234, 141),
}
local SHIRTS = {
	Color3.fromRGB(230, 60, 60), Color3.fromRGB(50, 120, 230), Color3.fromRGB(60, 190, 90),
	Color3.fromRGB(250, 190, 40), Color3.fromRGB(150, 80, 220), Color3.fromRGB(30, 30, 36),
	Color3.fromRGB(240, 240, 240), Color3.fromRGB(255, 120, 180), Color3.fromRGB(40, 200, 200),
}
local PANTS = {
	Color3.fromRGB(40, 50, 80), Color3.fromRGB(30, 30, 34), Color3.fromRGB(110, 80, 60),
	Color3.fromRGB(70, 70, 76), Color3.fromRGB(200, 200, 205),
}

local function pick<T>(list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

local function folder(): Folder
	local f = workspace:FindFirstChild("Bots")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Bots"
		f.Parent = workspace
	end
	return f :: Folder
end

local function makeModel(name: string): Model?
	local desc = Instance.new("HumanoidDescription")
	local skin = pick(SKINS)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = pick(SHIRTS)
	local legs = pick(PANTS)
	desc.LeftLegColor = legs
	desc.RightLegColor = legs
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not result then
		warn("[BreakAnkles] Couldn't build a bot: " .. tostring(result))
		return nil
	end
	local model = result :: Model
	model.Name = name
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	return model
end

local function randomLoadout(): any
	local runner = Catalog.Sorted(Catalog.Abilities, function(a)
		return a.Role == "Runner"
	end)
	local chaser = Catalog.Sorted(Catalog.Abilities, function(a)
		return a.Role == "Chaser"
	end)
	return {
		Runner = pick(runner).Id,
		Chaser = pick(chaser).Id,
		Item = "",
		Knife = pick({ "Classic", "Classic", "Rusty", "Candy", "Neon" }),
		Title = "Rookie",
	}
end

---------------------------------------------------------------------------
-- Animation
---------------------------------------------------------------------------
local function loadTracks(model: Model, b: any)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		local created = Instance.new("Animator")
		created.Parent = hum
		animator = created
	end
	for name, id in ANIMS do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return (animator :: Animator):LoadAnimation(anim)
		end)
		if ok and track then
			track.Looped = true
			b.Tracks[name] = track
		end
	end
end

local function setAnim(b: any, speed: number)
	local want = if speed > 1.5 then "Run" else "Idle"
	if b.CurrentAnim ~= want then
		local cur = b.Tracks[b.CurrentAnim]
		if cur then
			cur:Stop(0.2)
		end
		local nextTrack = b.Tracks[want]
		if nextTrack then
			nextTrack:Play(0.2)
		end
		b.CurrentAnim = want
	end
	if want == "Run" and b.Tracks.Run then
		b.Tracks.Run:AdjustSpeed(math.clamp(speed / 18, 0.6, 2.2))
	end
end

---------------------------------------------------------------------------
-- Spawning
---------------------------------------------------------------------------
function Bots.Spawn(count: number): { any }
	local created = {}
	local used: { [string]: boolean } = {}
	for _, e in Roster.All() do
		used[e.Name] = true
	end
	for _ = 1, count do
		local name: string = pick(B.Names)
		local tries = 0
		while used[name] and tries < 30 do
			name = pick(B.Names)
			tries += 1
		end
		used[name] = true
		local model = makeModel(name)
		if model then
			model:PivotTo(CFrame.new(0, 4, 0))
			model.Parent = folder()
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				pcall(function()
					(root :: BasePart):SetNetworkOwner(nil)
				end)
			end
			local entry = Roster.AddBot(name, model, randomLoadout())
			entry.Bot = {
				Vel = Vector3.zero,
				Desired = Vector3.zero,
				DashUntil = 0,
				DashDir = Vector3.zero,
				DashSpeed = 0,
				LockUntil = 0,
				NextDash = 0,
				NextThink = 0,
				Started = false,
				StartAt = 0,
				LaneX = 0,
				Side = 1,
				Seed = rng:NextNumber(0, 100),
				Tracks = {},
				CurrentAnim = nil,
				Fallen = false,
				SwingAt = nil,
				SeenJuke = 0,
				Target = nil,
				Rescue = nil,
				ChannelStart = nil,
				Considered = {},
				NoRescueUntil = 0,
			}
			loadTracks(model, entry.Bot)
			table.insert(bots, entry)
			table.insert(created, entry)
		end
	end
	return created
end

function Bots.DespawnAll()
	for _, e in bots do
		Roster.Remove(e)
		if e.Model then
			e.Model:Destroy()
		end
	end
	table.clear(bots)
end

local function startDash(e: any, dir: Vector3, speed: number, duration: number)
	local b = e.Bot
	b.DashDir = MoveMath.FlatUnit(dir, Vector3.new(0, 0, 1))
	b.DashSpeed = speed
	b.DashUntil = os.clock() + duration
	b.Vel = b.DashDir * MoveMath.MaxSpeed(e.Role)
end

Status.BotImpulse = function(e: any, velocity: Vector3, lock: number)
	local b = e.Bot
	if b then
		b.Vel = MoveMath.Flat(velocity)
		b.DashUntil = 0
		b.LockUntil = os.clock() + lock
	end
end

Status.BotRocket = function(e: any)
	local b = e.Bot
	local root = Roster.Root(e)
	if b and root then
		local dir = if b.Desired.Magnitude > 0.1 then b.Desired else root.CFrame.LookVector
		startDash(e, dir, Mv.RocketSpeed, Mv.RocketTime)
	end
end

---------------------------------------------------------------------------
-- Thinking
---------------------------------------------------------------------------
local function inSafe(pos: Vector3): boolean
	return Arena.InSafeZone(pos, "A") or Arena.InSafeZone(pos, "B")
end

local function nearestChaser(pos: Vector3, within: number): (any?, number, Vector3?)
	local best, bestD, bestPos = nil, within, nil
	for _, c in Roster.WithRole("Chaser") do
		local r = Roster.Root(c)
		if r then
			local d = MoveMath.Flat(r.Position - pos).Magnitude
			if d < bestD then
				best, bestD, bestPos = c, d, r.Position
			end
		end
	end
	return best, bestD, bestPos
end

local function stopChannel(e: any)
	local b = e.Bot
	b.ChannelStart = nil
	if e.Model then
		e.Model:SetAttribute("Channeling", nil)
	end
end

local function thinkRescue(e: any, pos: Vector3): boolean
	local b = e.Bot
	local now = os.clock()
	if not b.Rescue and now >= b.NoRescueUntil then
		for _, d in Roster.WithRole("Downed") do
			local r = Roster.Root(d)
			if r and not b.Considered[d] then
				b.Considered[d] = true
				local dist = MoveMath.Flat(r.Position - pos).Magnitude
				local _, threatD = nearestChaser(r.Position, 14)
				if dist < 38 and threatD >= 14 and rng:NextNumber() < 0.6 then
					b.Rescue = d
					break
				end
			end
		end
	end
	local t = b.Rescue
	if not t then
		return false
	end
	local troot = Roster.Root(t)
	if t.Role ~= "Downed" or not t.InMatch or not troot then
		b.Rescue = nil
		stopChannel(e)
		return false
	end
	local _, threatD = nearestChaser(pos, 9)
	if threatD < 9 then
		b.Rescue = nil
		b.NoRescueUntil = now + 3
		stopChannel(e)
		return false
	end
	local d = MoveMath.Flat(troot.Position - pos).Magnitude
	if d > 4.5 then
		stopChannel(e)
		b.Desired = MoveMath.FlatUnit(troot.Position - pos)
		return true
	end
	b.Desired = Vector3.zero
	if not b.ChannelStart then
		b.ChannelStart = now
		if e.Model then
			e.Model:SetAttribute("Channeling", true)
		end
	elseif now - b.ChannelStart >= Config.Match.ReviveHoldTime then
		stopChannel(e)
		b.Rescue = nil
		Combat.Revive(t, e)
	end
	return true
end

local function thinkRunner(e: any, pos: Vector3)
	local b = e.Bot
	local now = os.clock()
	local heroRun = Phase.Name == "HeroRun"
	if not Phase.IsLive() or (heroRun and not e.IsHero) then
		b.Desired = Vector3.zero
		b.Started = false
		stopChannel(e)
		return
	end
	local dir = Phase.Direction
	local start = Arena.StartSide(dir)
	local target = Arena.TargetSide(dir)
	if not b.Started then
		b.Started = true
		b.StartAt = now + (if e.IsHero then 0.2 else rng:NextNumber(0, 4.5))
		b.LaneX = rng:NextNumber(-Arena.HalfWidth + 10, Arena.HalfWidth - 10)
		b.Considered = {}
	end
	if now < b.StartAt and Arena.InSafeZone(pos, start) then
		b.Desired = Vector3.zero
		return
	end
	local lineZ = Arena.LineZ(target)
	local sign = if target == "B" then 1 else -1
	if Arena.InSafeZone(pos, target) and (pos.Z - lineZ) * sign > 6 then
		b.Desired = Vector3.zero
		return
	end
	if thinkRescue(e, pos) then
		return
	end
	local goal = Vector3.new(b.LaneX, 0, lineZ + sign * 12)
	local toGoal = MoveMath.FlatUnit(goal - pos, Vector3.new(0, 0, sign))
	local lateral = Vector3.new(-toGoal.Z, 0, toGoal.X)
	local threat, tdist, tpos = nearestChaser(pos, 32)
	local desired = toGoal
	if threat and tpos then
		local rel = MoveMath.FlatUnit(tpos - pos, toGoal)
		local away = -rel
		if rng:NextNumber() < 0.03 then
			b.Side = if lateral:Dot(away) >= 0 then 1 else -1
		end
		local ahead = rel:Dot(toGoal) > 0.15
		if ahead then
			desired = toGoal * 0.45 + lateral * b.Side + away * 0.35
		else
			desired = toGoal + away * 0.4
		end
		desired = MoveMath.FlatUnit(desired, toGoal)
		-- Cut back the other way when the chaser commits: the ankle breaker.
		if tdist < 9 and now >= b.NextDash and rng:NextNumber() < B.RunnerDashChance then
			b.Side = -b.Side
			startDash(e, lateral * b.Side + toGoal * 0.35, Mv.DashSpeed, Mv.DashTime)
			b.NextDash = now + Mv.DashCooldown + rng:NextNumber(0.1, 0.7)
			Combat.Juke(e)
			Effect:FireAllClients({ Kind = "Dash", Model = e.Model })
		end
		if tdist < 7 and rng:NextNumber() < 0.25 then
			Abilities.Use(e)
		end
	else
		desired = MoveMath.FlatUnit(toGoal + lateral * math.sin(now * 1.3 + b.Seed) * 0.35, toGoal)
		-- Grab a nearby gem if it's roughly on the way.
		for _, gem in Gems.List() do
			local rel = MoveMath.Flat(gem.Position - pos)
			if rel.Magnitude < 14 and rel.Unit:Dot(toGoal) > 0.2 then
				desired = rel.Unit
				break
			end
		end
	end
	b.Desired = desired
end

local function thinkChaser(e: any, pos: Vector3, root: BasePart)
	local b = e.Bot
	local now = os.clock()
	if not Phase.IsLive() then
		b.Desired = Vector3.zero
		b.SwingAt = nil
		return
	end
	local heroOnly = Phase.Name == "HeroRun"
	local best, bestScore = nil, math.huge
	for _, r in Roster.WithRole("Runner") do
		local rr = Roster.Root(r)
		if rr and not inSafe(rr.Position) and not (r.Model and r.Model:GetAttribute("Cloaked")) and (not heroOnly or r.IsHero) then
			local d = MoveMath.Flat(rr.Position - pos).Magnitude
			local score = if r == b.Target then d * 0.75 else d
			if score < bestScore then
				best, bestScore = r, score
			end
		end
	end
	b.Target = best
	if not best then
		-- Hold midfield on the runners' side, ready for the next one out.
		local startZ = Arena.LineZ(Arena.StartSide(Phase.Direction))
		local goal = Vector3.new(math.sin(now * 0.4 + b.Seed) * 25, 0, startZ * 0.4)
		local rel = MoveMath.Flat(goal - pos)
		b.Desired = if rel.Magnitude > 4 then rel.Unit else Vector3.zero
		b.SwingAt = nil
		return
	end
	local troot = Roster.Root(best) :: BasePart
	local tpos = troot.Position
	local tvel = MoveMath.Flat(troot.AssemblyLinearVelocity)
	local d = MoveMath.Flat(tpos - pos).Magnitude
	local lead = math.clamp(d / 40, 0.05, 0.4)
	local aim = tpos + tvel * lead
	aim = Vector3.new(aim.X, 0, math.clamp(aim.Z, -Arena.HalfLength + 1, Arena.HalfLength - 1))
	b.Desired = MoveMath.FlatUnit(aim - pos)

	local reach = Config.Knife.Reach * (if now < e.BigDaggerUntil then 2 else 1)
	if d <= reach * 0.9 then
		if not b.SwingAt then
			b.SwingAt = now + rng:NextNumber(B.ReactionTime[1], B.ReactionTime[2])
		end
	else
		b.SwingAt = nil
	end
	-- Biting on a juke: swing at where the runner was.
	if best.LastJuke > b.SeenJuke and now - best.LastJuke < 0.25 and d < reach * 1.7 then
		b.SeenJuke = best.LastJuke
		if rng:NextNumber() < B.FakeOutChance then
			Combat.Swing(e)
			b.SwingAt = nil
		end
	end
	if b.SwingAt and now >= b.SwingAt then
		Combat.Swing(e)
		b.SwingAt = nil
	end
	-- Abilities, used when the target is at a useful distance and ahead.
	local facing = MoveMath.FlatUnit(root.CFrame.LookVector):Dot(MoveMath.FlatUnit(tpos - pos)) > 0.75
	local id = Roster.Loadout(e).Chaser
	local want = false
	if id == "BearTrap" or id == "BowlingBall" then
		want = facing and d > 8 and d < 22
	elseif id == "RocketShoes" then
		want = facing and d > 14 and d < 30
	elseif id == "RufusLeash" then
		want = facing and d > reach and d < 14
	elseif id == "BigDagger" then
		want = d > reach and d < reach * 1.8
	end
	if want and rng:NextNumber() < 0.3 then
		Abilities.Use(e)
	end
end

---------------------------------------------------------------------------
-- Moving
---------------------------------------------------------------------------
local function stepBot(e: any, dt: number)
	local b = e.Bot
	local model = e.Model
	if not b or not model or not model.Parent then
		return
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = Roster.Root(e)
	if not hum or not root then
		return
	end
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	local stunUntil = model:GetAttribute("StunUntil")
	local stunned = type(stunUntil) == "number" and serverNow < stunUntil
	local fallen = e.Role == "Downed" or (stunned and model:GetAttribute("StunKind") == "Trip")

	if fallen and not b.Fallen then
		b.Fallen = true
		hum.PlatformStand = true
		root.AssemblyAngularVelocity = root.CFrame.RightVector * 7
		root.AssemblyLinearVelocity += Vector3.new(0, 6, 0)
	elseif not fallen and b.Fallen then
		b.Fallen = false
		hum.PlatformStand = false
		local p = root.Position
		local look = MoveMath.FlatUnit(root.CFrame.LookVector, Vector3.new(0, 0, 1))
		model:PivotTo(CFrame.lookAt(Vector3.new(p.X, 3, p.Z), Vector3.new(p.X, 3, p.Z) + look))
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	if fallen or stunned or model:GetAttribute("Channeling") then
		b.Vel = Vector3.zero
		b.DashUntil = 0
		hum.WalkSpeed = 0
		hum:Move(Vector3.zero)
		setAnim(b, 0)
		return
	end
	if now < b.DashUntil then
		hum.WalkSpeed = b.DashSpeed
		hum:Move(b.DashDir)
		setAnim(b, b.DashSpeed)
		return
	end
	local maxSpeed = MoveMath.MaxSpeed(e.Role) * MoveMath.SpeedMult(model, serverNow)
	local input = if now < b.LockUntil then Vector3.zero else b.Desired
	local hasInput = input.Magnitude > 0.01
	local accel = MoveMath.Accel(e.Role) * (if MoveMath.Boosted(model, serverNow) then 1.3 else 1)
	b.Vel = MoveMath.Approach(b.Vel, input * maxSpeed, hasInput, accel, dt)
	local speed = b.Vel.Magnitude
	hum.WalkSpeed = speed
	hum:Move(if speed > 0.3 then b.Vel.Unit else Vector3.zero)
	setAnim(b, speed)
end

function Bots.Start()
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, e in bots do
			if e.InMatch then
				stepBot(e, dt)
				local b = e.Bot
				if b and now >= b.NextThink then
					b.NextThink = now + 0.1 + rng:NextNumber(0, 0.05)
					local root = Roster.Root(e)
					if root then
						if e.Role == "Runner" then
							thinkRunner(e, root.Position)
						elseif e.Role == "Chaser" then
							thinkChaser(e, root.Position, root)
						else
							b.Desired = Vector3.zero
						end
					end
				end
			end
		end
	end)
end

function Bots.List(): { any }
	return bots
end

return Bots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[--!strict
-- The knife: swings, hits, shields, ankle breaks, downs, rescues and
-- conversions. All checks happen on the server against server positions,
-- with a little extra reach to cover latency.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arena = require(Shared.Arena)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Hazards = require(script.Parent.Hazards)
local Phase = require(script.Parent.Phase)
local Rewards = require(script.Parent.Rewards)
local Roster = require(script.Parent.Roster)
local Status = require(script.Parent.Status)

local K = Config.Knife
local R = Config.Rewards
local M = Config.Match

local Effect = Net.Event("Effect")
local Notify = Net.Event("Notify")

local Combat = {}

-- Set by Match so it can count catches toward a flawless run.
Combat.OnCaught = nil :: ((runner: any) -> ())?

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function feed(text: string)
	Notify:FireAllClients({ Kind = "Feed", Text = text })
end

local function tell(entry: any, payload: { [string]: any })
	if entry.Player then
		Notify:FireClient(entry.Player, payload)
	end
end

local function inAnySafeZone(pos: Vector3): boolean
	return Arena.InSafeZone(pos, "A") or Arena.InSafeZone(pos, "B")
end

---------------------------------------------------------------------------
-- Down / revive / convert
---------------------------------------------------------------------------
local function removePrompt(entry: any)
	local model: Model? = entry.Model
	if model then
		local p = model:FindFirstChild("RevivePrompt", true)
		if p then
			p:Destroy()
		end
	end
end

local function clearChanneling()
	for _, e in Roster.InMatch() do
		if e.Model and e.Model:GetAttribute("Channeling") then
			e.Model:SetAttribute("Channeling", nil)
		end
	end
end

function Combat.Revive(target: any, rescuer: any?)
	if target.Role ~= "Downed" then
		return
	end
	removePrompt(target)
	target.ProtectedUntil = os.clock() + 1.2
	Roster.SetRole(target, "Runner")
	Status.Clear(target)
	Effect:FireAllClients({ Kind = "Revive", Model = target.Model })
	if rescuer then
		if rescuer.Model then
			rescuer.Model:SetAttribute("Channeling", nil)
		end
		rescuer.Rescues += 1
		Rewards.Give(rescuer, R.RescueGems, 0, R.RescueXP, "Rescue")
		Rewards.Stat(rescuer, "Rescues", 1)
		feed(("%s rescued %s"):format(rescuer.Name, target.Name))
		tell(target, { Kind = "Announce", Text = "RESCUED!", Sub = rescuer.Name .. " picked you up", Color = Color3.fromRGB(140, 255, 160), Sound = "Safe" })
		tell(rescuer, { Kind = "Toast", Text = "You rescued " .. target.Name .. "!", Color = Color3.fromRGB(140, 255, 160), Sound = "Safe" })
	else
		feed(("%s used a Rescue Kit"):format(target.Name))
		tell(target, { Kind = "Announce", Text = "BACK UP!", Sub = "Rescue Kit used", Color = Color3.fromRGB(140, 255, 160), Sound = "Safe" })
	end
end

function Combat.Convert(entry: any, reason: string?)
	if entry.Role ~= "Runner" and entry.Role ~= "Downed" then
		return
	end
	removePrompt(entry)
	entry.IsHero = false
	entry.GraceUntil = os.clock() + M.ConvertGraceTime
	Status.Clear(entry)
	Roster.SetRole(entry, "Chaser")
	if Combat.OnCaught then
		(Combat.OnCaught :: (any) -> ())(entry)
	end
	local why = if reason == "time" then "ran out of time" else "was converted"
	feed(("%s %s and is now a CHASER"):format(entry.Name, why))
	tell(entry, {
		Kind = "Announce",
		Text = if reason == "time" then "TOO SLOW!" else "YOU'RE A CHASER NOW",
		Sub = "Catch the runners! Click to swing.",
		Color = Color3.fromRGB(255, 90, 90),
		Sound = "Equip",
	})
	Notify:FireAllClients({ Kind = "Counts" })
end

local function startRevivePrompt(entry: any)
	local root = Roster.Root(entry)
	if not root then
		return
	end
	removePrompt(entry)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive"
	prompt.ObjectText = entry.Name
	prompt.HoldDuration = M.ReviveHoldTime
	prompt.MaxActivationDistance = M.ReviveRange
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Parent = root
	local function rescuerOf(player: Player): any?
		local e = Roster.ForPlayer(player)
		if e and e ~= entry and e.InMatch and e.Role == "Runner" then
			return e
		end
		return nil
	end
	-- Rescuers are frozen while they hold the prompt; release them if the
	-- prompt goes away mid-hold (revived, converted, or the crossing ended).
	local holders: { [Player]: boolean } = {}
	local function release(player: Player)
		holders[player] = nil
		local e = Roster.ForPlayer(player)
		if e and e.Model then
			e.Model:SetAttribute("Channeling", nil)
		end
	end
	prompt.PromptButtonHoldBegan:Connect(function(player)
		local e = rescuerOf(player)
		if e and e.Model then
			holders[player] = true
			e.Model:SetAttribute("Channeling", true)
		end
	end)
	prompt.PromptButtonHoldEnded:Connect(release)
	prompt.Destroying:Connect(function()
		for player in holders do
			release(player)
		end
	end)
	prompt.Triggered:Connect(function(player)
		local e = rescuerOf(player)
		if not e then
			return
		end
		local r1, r2 = Roster.Root(e), Roster.Root(entry)
		if r1 and r2 and (r1.Position - r2.Position).Magnitude <= M.ReviveRange + 3 then
			Combat.Revive(entry, e)
		end
	end)
end

function Combat.Down(runner: any, by: any)
	if runner.Role ~= "Runner" then
		return
	end
	runner.DownedAt = os.clock()
	runner.DownedBy = by
	runner.ShieldUntil = 0
	if runner.Model and runner.Model:GetAttribute("Cloaked") then
		Roster.SetCloak(runner, false)
	end
	Status.Clear(runner)
	Roster.SetRole(runner, "Downed")
	startRevivePrompt(runner)
	Effect:FireAllClients({ Kind = "Down", Model = runner.Model, By = by.Model })

	by.Catches += 1
	Rewards.Give(by, R.CatchGems, R.CatchCoins, R.CatchXP, "Caught " .. runner.Name)
	Rewards.Stat(by, "Catches", 1)
	feed(("%s caught %s"):format(by.Name, runner.Name))
	tell(by, { Kind = "Toast", Text = "CAUGHT " .. string.upper(runner.Name) .. "!", Color = Color3.fromRGB(255, 90, 90), Sound = "Down" })
	tell(runner, {
		Kind = "Announce",
		Text = "YOU'RE DOWN!",
		Sub = "Wait for a teammate to revive you, or press F to use a Rescue Kit",
		Color = Color3.fromRGB(255, 90, 90),
		Sound = "Down",
	})
	Notify:FireAllClients({ Kind = "Counts" })
end

---------------------------------------------------------------------------
-- Ankle breaks
---------------------------------------------------------------------------
local function ankleBreak(chaser: any, runner: any)
	Status.Stun(chaser, K.AnkleStunTime, "Trip")
	runner.Ankles += 1
	runner.LastJuke = -math.huge -- one break per juke
	Rewards.Give(runner, R.AnkleBreakGems, 0, R.AnkleBreakXP, "Broke " .. chaser.Name .. "'s ankles")
	Rewards.Stat(runner, "Ankles", 1)
	Effect:FireAllClients({ Kind = "AnkleBreak", Chaser = chaser.Model, Runner = runner.Model })
	feed(("%s broke %s's ankles!"):format(runner.Name, chaser.Name))
	tell(runner, { Kind = "Announce", Text = "ANKLES BROKEN!", Sub = "You sent " .. chaser.Name .. " to the floor", Color = Color3.fromRGB(255, 200, 60), Sound = "AnkleBreak" })
	tell(chaser, { Kind = "Announce", Text = "YOUR ANKLES!", Sub = runner.Name .. " juked you", Color = Color3.fromRGB(255, 120, 60), Sound = "AnkleBreak" })
end

---------------------------------------------------------------------------
-- Swing
---------------------------------------------------------------------------
local function resolve(chaser: any, big: boolean)
	if chaser.Role ~= "Chaser" or not Phase.IsLive() then
		return
	end
	local root = Roster.Root(chaser)
	if not root then
		return
	end
	local origin = root.Position
	local look = flat(root.CFrame.LookVector)
	look = if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, 1)
	local reach = K.Reach * (if big then 2 else 1) + K.Leniency
	local cosLimit = math.cos(math.rad(K.HalfAngle))
	local now = os.clock()

	local best, bestDist = nil, math.huge
	for _, e in Roster.WithRole("Runner") do
		local r = Roster.Root(e)
		if r and now >= e.ProtectedUntil and not inAnySafeZone(r.Position) then
			local offset = r.Position - origin
			local f = flat(offset)
			local d = f.Magnitude
			if d <= reach and math.abs(offset.Y) < 8 then
				local inFront = d <= K.CloseRange or look:Dot(f.Unit) >= cosLimit
				if inFront and d < bestDist then
					best, bestDist = e, d
				end
			end
		end
	end

	if best then
		if now < best.ShieldUntil then
			best.ShieldUntil = 0
			Effect:FireAllClients({ Kind = "ShieldBreak", Model = best.Model })
			tell(best, { Kind = "Toast", Text = "BLOCKED!", Color = Color3.fromRGB(90, 200, 255), Sound = "Stop" })
			tell(chaser, { Kind = "Toast", Text = "Blocked by a shield", Color = Color3.fromRGB(90, 200, 255) })
			Status.Slow(chaser, K.MissSlowMult, K.MissSlowTime)
			return
		end
		Combat.Down(best, chaser)
		return
	end

	if Hazards.HitDoor(root, reach) then
		return
	end

	-- Missed. Did somebody juke this swing?
	Status.Slow(chaser, K.MissSlowMult, K.MissSlowTime)
	local juker, jukeDist = nil, math.huge
	for _, e in Roster.WithRole("Runner") do
		local r = Roster.Root(e)
		if r and now - e.LastJuke <= K.JukeWindow then
			local d = flat(r.Position - origin).Magnitude
			if d <= K.JukeRange and d < jukeDist then
				juker, jukeDist = e, d
			end
		end
	end
	if juker then
		ankleBreak(chaser, juker)
	end
end

function Combat.Swing(chaser: any)
	if chaser.Role ~= "Chaser" or not chaser.InMatch or not Phase.IsLive() then
		return
	end
	local now = os.clock()
	-- 10% slack so network jitter doesn't eat swings the client allowed.
	if now - chaser.LastSwing < K.Cooldown * 0.9 or now < chaser.GraceUntil then
		return
	end
	if Status.IsStunned(chaser) then
		return
	end
	chaser.LastSwing = now
	local big = now < chaser.BigDaggerUntil
	if big then
		chaser.BigDaggerUntil = 0
		task.delay(0.35, function()
			Roster.SetKnifeBig(chaser, false)
		end)
	end
	Effect:FireAllClients({ Kind = "Swing", Model = chaser.Model, Big = big })
	task.delay(K.Windup, resolve, chaser, big)
end

-- Runners report dashes and instant stops; a swing that misses right after
-- one breaks the chaser's ankles.
function Combat.Juke(runner: any)
	if runner.Role == "Runner" and runner.InMatch then
		local now = os.clock()
		if now - runner.LastJuke > 0.2 then
			runner.LastJuke = now
		end
	end
end

---------------------------------------------------------------------------
-- Ticking: bleed-outs
---------------------------------------------------------------------------
function Combat.Tick()
	local now = os.clock()
	for _, e in Roster.WithRole("Downed") do
		if now - e.DownedAt >= M.BleedOutTime then
			Combat.Convert(e)
		end
	end
	if #Roster.WithRole("Downed") == 0 then
		clearChanneling()
	end
end

function Combat.Start()
	Net.Event("Swing").OnServerEvent:Connect(function(player)
		local e = Roster.ForPlayer(player)
		if e then
			Combat.Swing(e)
		end
	end)
	Net.Event("Juke").OnServerEvent:Connect(function(player, kind)
		local e = Roster.ForPlayer(player)
		if e then
			Combat.Juke(e)
			if kind == "Dash" and e.Model then
				Effect:FireAllClients({ Kind = "Dash", Model = e.Model })
			end
		end
	end)
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Saves each player's gems, coins, unlocks and stats in a DataStore.
-- In Studio, turn on Game Settings > Security > "Enable Studio Access to API
-- Services" to save; otherwise the game runs with fresh data each session.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Net = require(Shared.Net)

export type Profile = {
	Gems: number,
	Coins: number,
	XP: number,
	Level: number,
	Wins: number,
	Ankles: number,
	Catches: number,
	Rescues: number,
	Heroes: number,
	Matches: number,
	OwnedAbilities: { [string]: boolean },
	OwnedKnives: { [string]: boolean },
	OwnedTitles: { [string]: boolean },
	Items: { [string]: number },
	Equipped: { Runner: string, Chaser: string, Item: string, Knife: string, Title: string },
	Redeemed: { [string]: boolean },
	Boosts: { Gems: number, Coins: number }, -- unix expiry times
	Receipts: { string },
}

local function defaultProfile(): Profile
	return {
		Gems = 0,
		Coins = 0,
		XP = 0,
		Level = 1,
		Wins = 0,
		Ankles = 0,
		Catches = 0,
		Rescues = 0,
		Heroes = 0,
		Matches = 0,
		OwnedAbilities = { [Catalog.StarterRunnerAbility] = true, [Catalog.StarterChaserAbility] = true },
		OwnedKnives = { Classic = true },
		OwnedTitles = { Rookie = true },
		Items = {},
		Equipped = {
			Runner = Catalog.StarterRunnerAbility,
			Chaser = Catalog.StarterChaserAbility,
			Item = "",
			Knife = "Classic",
			Title = "Rookie",
		},
		Redeemed = {},
		Boosts = { Gems = 0, Coins = 0 },
		Receipts = {},
	}
end

-- Fill in any fields added since the profile was first saved.
local function reconcile(target: any, template: any)
	for k, v in template do
		if target[k] == nil then
			target[k] = if type(v) == "table" then table.clone(v) else v
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil and #v == 0 then
			reconcile(target[k], v)
		end
	end
end

local DataService = {}

local store: DataStore? = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local profiles: { [Player]: Profile } = {}
local loaded: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local listeners: { (Player, Profile) -> () } = {}

local ProfileChanged = Net.Event("ProfileChanged")

local function key(player: Player): string
	return "u_" .. player.UserId
end

-- Studio without "Enable Studio Access to API Services" fails every call;
-- stop asking instead of retrying for each player.
local function isAccessError(err: string): boolean
	return string.find(err, "403") ~= nil
		or string.find(err, "StudioAccess") ~= nil
		or string.find(string.lower(err), "api access") ~= nil
		or string.find(string.lower(err), "api services") ~= nil
end

local function withRetries<T>(fn: () -> T): (boolean, T?)
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		local err = tostring(result)
		if isAccessError(err) then
			warn("[BreakAnkles] DataStores are off in this session (" .. err .. "). Progress won't save.")
			store = nil
			return false, nil
		end
		warn(("[BreakAnkles] DataStore attempt %d failed: %s"):format(attempt, err))
		task.wait(attempt)
	end
	return false, nil
end

local function snapshot(p: Profile): any
	return {
		Gems = p.Gems,
		Coins = p.Coins,
		XP = p.XP,
		Level = p.Level,
		Wins = p.Wins,
		Ankles = p.Ankles,
		Catches = p.Catches,
		Rescues = p.Rescues,
		Heroes = p.Heroes,
		OwnedAbilities = table.clone(p.OwnedAbilities),
		OwnedKnives = table.clone(p.OwnedKnives),
		OwnedTitles = table.clone(p.OwnedTitles),
		Items = table.clone(p.Items),
		Equipped = table.clone(p.Equipped),
		Boosts = table.clone(p.Boosts),
		XPNeeded = Config.XPForLevel(p.Level),
	}
end

local function applyStats(player: Player, p: Profile)
	player:SetAttribute("Gems", p.Gems)
	player:SetAttribute("Coins", p.Coins)
	player:SetAttribute("Level", p.Level)
	player:SetAttribute("Title", p.Equipped.Title)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		(ls:FindFirstChild("Gems") :: IntValue).Value = p.Gems;
		(ls:FindFirstChild("Wins") :: IntValue).Value = p.Wins;
		(ls:FindFirstChild("Ankles") :: IntValue).Value = p.Ankles
	end
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.IsLoaded(player: Player): boolean
	return loaded[player] == true
end

function DataService.Snapshot(player: Player): any
	local p = profiles[player]
	return if p then snapshot(p) else nil
end

function DataService.OnChanged(fn: (Player, Profile) -> ())
	table.insert(listeners, fn)
end

-- Call after changing a profile: updates leaderstats and the client's copy.
function DataService.Changed(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	dirty[player] = true
	applyStats(player, p)
	ProfileChanged:FireClient(player, snapshot(p))
	for _, fn in listeners do
		task.spawn(fn, player, p)
	end
end

function DataService.Mutate(player: Player, fn: (Profile) -> ()): boolean
	local p = profiles[player]
	if not p then
		return false
	end
	fn(p)
	DataService.Changed(player)
	return true
end

local function boostActive(p: Profile, kind: "Gems" | "Coins"): boolean
	return (p.Boosts[kind] or 0) > os.time()
end

function DataService.BoostActive(player: Player, kind: "Gems" | "Coins"): boolean
	local p = profiles[player]
	return p ~= nil and boostActive(p, kind)
end

-- Adds currency and XP with any active 2x boosts applied. Returns what was given.
function DataService.Award(player: Player, gems: number, coins: number, xp: number): (number, number)
	local p = profiles[player]
	if not p then
		return 0, 0
	end
	if boostActive(p, "Gems") then
		gems *= 2
	end
	if boostActive(p, "Coins") then
		coins *= 2
	end
	p.Gems += gems
	p.Coins += coins
	p.XP += xp
	local leveled = false
	while p.XP >= Config.XPForLevel(p.Level) do
		p.XP -= Config.XPForLevel(p.Level)
		p.Level += 1
		leveled = true
	end
	if p.Level >= 15 then
		p.OwnedTitles.Veteran = true
	end
	if leveled then
		Net.Event("Notify"):FireClient(player, { Kind = "Toast", Text = ("LEVEL UP! You're level %d"):format(p.Level), Color = Color3.fromRGB(150, 255, 150), Sound = "Win" })
	end
	DataService.Changed(player)
	return gems, coins
end

local function save(player: Player): boolean
	local p = profiles[player]
	if not p or not loaded[player] or not store then
		return false
	end
	local data = table.clone(p)
	local ok = withRetries(function()
		(store :: DataStore):UpdateAsync(key(player), function()
			return data
		end)
		return true
	end)
	if ok then
		dirty[player] = false
	end
	return ok
end

local function load(player: Player)
	local data: any = nil
	local fetched = false
	if store then
		local ok, result = withRetries(function()
			return (store :: DataStore):GetAsync(key(player))
		end)
		if ok then
			data = result
			fetched = true
		else
			warn("[BreakAnkles] Could not load data for " .. player.Name .. "; progress won't save this session.")
		end
	end
	local profile: Profile = if type(data) == "table" then data else defaultProfile()
	reconcile(profile, defaultProfile())
	-- Drop anything the catalog no longer has.
	for id in profile.OwnedAbilities do
		if not Catalog.Abilities[id] then
			profile.OwnedAbilities[id] = nil
		end
	end
	if not Catalog.Abilities[profile.Equipped.Runner] then
		profile.Equipped.Runner = Catalog.StarterRunnerAbility
	end
	if not Catalog.Abilities[profile.Equipped.Chaser] then
		profile.Equipped.Chaser = Catalog.StarterChaserAbility
	end
	if not Catalog.Knives[profile.Equipped.Knife] then
		profile.Equipped.Knife = "Classic"
	end
	if not Catalog.Titles[profile.Equipped.Title] then
		profile.Equipped.Title = "Rookie"
	end
	if player.Parent ~= Players then
		return
	end
	profiles[player] = profile
	-- Only save profiles the store actually answered for, so a failed load
	-- never overwrites real progress with a blank profile.
	loaded[player] = fetched
	DataService.Changed(player)
end

local function onPlayerAdded(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in { "Gems", "Wins", "Ankles" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
	end
	ls.Parent = player
	load(player)
end

function DataService.Start()
	if not storeOk then
		warn("[BreakAnkles] DataStores unavailable; progress won't save.")
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		loaded[player] = nil
		dirty[player] = nil
	end)
	Net.Function("GetProfile").OnServerInvoke = function(player)
		local deadline = os.clock() + 15
		while not profiles[player] and os.clock() < deadline do
			task.wait(0.2)
		end
		return DataService.Snapshot(player)
	end
	task.spawn(function()
		while true do
			task.wait(120)
			for player, isDirty in dirty do
				if isDirty then
					task.spawn(save, player)
				end
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Gems</string>
          <string name="Source"><![CDATA[--!strict
-- Gem pickups scattered over the field each crossing. Only runners can grab
-- them, which tempts them off the safe line.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arena = require(Shared.Arena)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local MapBuilder = require(script.Parent.MapBuilder)
local Phase = require(script.Parent.Phase)
local Rewards = require(script.Parent.Rewards)
local Roster = require(script.Parent.Roster)

local Effect = Net.Event("Effect")

local Gems = {}

local gems: { BasePart } = {}
local rng = Random.new()

function Gems.Spawn(count: number)
	Gems.Clear()
	local folder = MapBuilder.Dynamic()
	for _ = 1, count do
		local x = rng:NextNumber(-Arena.HalfWidth + 6, Arena.HalfWidth - 6)
		local z = rng:NextNumber(-Arena.HalfLength + 14, Arena.HalfLength - 14)
		local gem = Instance.new("Part")
		gem.Name = "Gem"
		gem.Size = Vector3.new(1.3, 1.3, 1.3)
		gem.CFrame = CFrame.new(x, 2.2, z) * CFrame.Angles(math.rad(45), 0, math.rad(45))
		gem.Anchored = true
		gem.CanCollide = false
		gem.CanQuery = false
		gem.CanTouch = false
		gem.Material = Enum.Material.Neon
		gem.Color = Color3.fromRGB(190, 90, 255)
		gem.CastShadow = false
		gem:SetAttribute("Gem", true)
		local light = Instance.new("PointLight")
		light.Color = gem.Color
		light.Range = 7
		light.Brightness = 1.4
		light.Parent = gem
		gem.Parent = folder
		table.insert(gems, gem)
	end
end

function Gems.List(): { BasePart }
	return gems
end

function Gems.Clear()
	for _, g in gems do
		g:Destroy()
	end
	table.clear(gems)
end

local function step()
	if #gems == 0 or not Phase.IsLive() then
		return
	end
	local runners = Roster.WithRole("Runner")
	for i = #gems, 1, -1 do
		local gem = gems[i]
		local p = gem.Position
		for _, e in runners do
			local r = Roster.Root(e)
			if r and Vector3.new(r.Position.X - p.X, 0, r.Position.Z - p.Z).Magnitude < 3.6 then
				Effect:FireAllClients({ Kind = "GemPickup", Position = p, Model = e.Model })
				Rewards.Give(e, Config.Rewards.FieldGemValue, 0, 0, "Gem pickup")
				gem:Destroy()
				table.remove(gems, i)
				break
			end
		end
	end
end

function Gems.Start()
	RunService.Heartbeat:Connect(step)
end

return Gems
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Groups</string>
          <string name="Source"><![CDATA[--!strict
-- Collision groups. Players never collide with each other (no body
-- blocking). Invisible barriers only stop the group they're meant for.

local PhysicsService = game:GetService("PhysicsService")

local Groups = {}

Groups.Lobby = "BA_Lobby"
Groups.Runners = "BA_Runners"
Groups.Hero = "BA_Hero"
Groups.Chasers = "BA_Chasers"
Groups.ChaserBarrier = "BA_ChaserBarrier"
Groups.RunnerGate = "BA_RunnerGate"
Groups.PocketDoor = "BA_PocketDoor"
Groups.Pickups = "BA_Pickups"

local PLAYER_GROUPS = { Groups.Lobby, Groups.Runners, Groups.Hero, Groups.Chasers }

function Groups.Setup()
	local all = { Groups.Lobby, Groups.Runners, Groups.Hero, Groups.Chasers, Groups.ChaserBarrier, Groups.RunnerGate, Groups.PocketDoor, Groups.Pickups }
	for _, name in all do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(name)
		end)
	end
	-- Players pass through each other.
	for _, a in PLAYER_GROUPS do
		for _, b in PLAYER_GROUPS do
			PhysicsService:CollisionGroupSetCollidable(a, b, false)
		end
	end
	-- Barriers: collide with exactly one kind of player, and nothing else.
	local only = {
		[Groups.ChaserBarrier] = { [Groups.Chasers] = true },
		[Groups.RunnerGate] = { [Groups.Runners] = true },
		[Groups.PocketDoor] = { [Groups.Chasers] = true },
		[Groups.Pickups] = {},
	}
	for barrier, allowed in only do
		for _, g in all do
			if g ~= barrier then
				PhysicsService:CollisionGroupSetCollidable(barrier, g, allowed[g] == true)
			end
		end
		PhysicsService:CollisionGroupSetCollidable(barrier, "Default", false)
	end
end

function Groups.SetModel(model: Model, group: string)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
	model:SetAttribute("CollisionGroup", group)
end

-- Keep accessories that load late in the right group.
function Groups.Track(model: Model)
	model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			local g = model:GetAttribute("CollisionGroup")
			if type(g) == "string" then
				d.CollisionGroup = g
			end
		end
	end)
end

return Groups
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Hazards</string>
          <string name="Source"><![CDATA[--!strict
-- Things abilities leave on the field: bear traps, banana peels, bowling
-- balls and pocket doors. Contact is checked by distance every frame,
-- which is steadier than Touched for client-simulated characters.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arena = require(Shared.Arena)
local Net = require(Shared.Net)
local Groups = require(script.Parent.Groups)
local MapBuilder = require(script.Parent.MapBuilder)
local Roster = require(script.Parent.Roster)
local Status = require(script.Parent.Status)

local Effect = Net.Event("Effect")
local Notify = Net.Event("Notify")

type Hazard = {
	Kind: string,
	Model: any, -- a Part or a Model
	Owner: any,
	TargetRole: string,
	Expires: number,
	Radius: number,
	-- bowling ball
	Dir: Vector3?,
	Speed: number?,
	Traveled: number?,
	MaxDistance: number?,
	-- door
	HP: number?,
}

local Hazards = {}

local active: { Hazard } = {}

local function make(className: string, props: { [string]: any }, parent: Instance): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

-- Keep things on the field and off the safe zones.
local function clampToField(pos: Vector3, margin: number): Vector3
	local x = math.clamp(pos.X, -Arena.HalfWidth + margin, Arena.HalfWidth - margin)
	local z = math.clamp(pos.Z, -Arena.HalfLength + margin, Arena.HalfLength - margin)
	return Vector3.new(x, pos.Y, z)
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else Vector3.new(0, 0, 1)
end

local function opposite(role: string): string
	return if role == "Chaser" then "Runner" else "Chaser"
end

---------------------------------------------------------------------------
-- Spawners
---------------------------------------------------------------------------
function Hazards.BearTrap(owner: any, at: Vector3)
	local pos = clampToField(Vector3.new(at.X, 0.25, at.Z), 2)
	local model = Instance.new("Model")
	model.Name = "BearTrap"
	local base = make("Part", {
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 3.4, 3.4),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(70, 70, 76),
	}, model)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		make("WedgePart", {
			Name = "Tooth",
			Size = Vector3.new(0.15, 0.6, 0.35),
			CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 1.45, 0.4, math.sin(a) * 1.45)) * CFrame.Angles(0, -a, 0),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(190, 190, 196),
		}, model)
	end
	model.PrimaryPart = base
	model.Parent = MapBuilder.Dynamic()
	table.insert(active, {
		Kind = "Trap",
		Model = model,
		Owner = owner,
		TargetRole = "Runner",
		Expires = os.clock() + 12,
		Radius = 2.0,
	})
end

function Hazards.BananaPeel(owner: any, at: Vector3)
	local pos = Vector3.new(at.X, 0.2, at.Z)
	local peel = make("Part", {
		Name = "BananaPeel",
		Size = Vector3.new(1.6, 0.25, 1.1),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, math.random() * math.pi * 2, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 222, 60),
	}, MapBuilder.Dynamic())
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = peel
	table.insert(active, {
		Kind = "Peel",
		Model = peel,
		Owner = owner,
		TargetRole = opposite(owner.Role),
		Expires = os.clock() + 20,
		Radius = 2.2,
	})
end

function Hazards.BowlingBall(owner: any, from: Vector3, dir: Vector3)
	local d = flat(dir)
	local ball = make("Part", {
		Name = "BowlingBall",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		Position = Vector3.new(from.X, 1.55, from.Z) + d * 3,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.15,
		Color = Color3.fromRGB(40, 70, 210),
	}, MapBuilder.Dynamic())
	table.insert(active, {
		Kind = "Ball",
		Model = ball,
		Owner = owner,
		TargetRole = "Runner",
		Expires = os.clock() + 3,
		Radius = 2.8,
		Dir = d,
		Speed = 72,
		Traveled = 0,
		MaxDistance = 130,
	})
end

-- Placed between the runner and the closest chaser when one is near,
-- otherwise just ahead. Only chasers collide with it.
function Hazards.PocketDoor(owner: any, root: BasePart)
	local pos = root.Position
	local facing = flat(root.CFrame.LookVector)
	local nearest, best = nil, 32
	for _, e in Roster.WithRole("Chaser") do
		local r = Roster.Root(e)
		if r then
			local d = (r.Position - pos).Magnitude
			if d < best then
				nearest, best = r, d
			end
		end
	end
	local toward = if nearest then flat(nearest.Position - pos) else facing
	local dist = if nearest then math.min(5, best * 0.5) else 6
	local at = clampToField(pos + toward * dist, 3)
	local door = make("Part", {
		Name = "PocketDoor",
		Size = Vector3.new(13, 10, 1.2),
		CFrame = CFrame.lookAt(Vector3.new(at.X, 5, at.Z), Vector3.new(at.X, 5, at.Z) + toward),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(176, 120, 70),
		CanCollide = true,
		CanQuery = true,
	}, MapBuilder.Dynamic())
	door.CollisionGroup = Groups.PocketDoor
	local frame = make("Part", {
		Name = "Frame",
		Size = Vector3.new(14, 1, 1.6),
		CFrame = door.CFrame * CFrame.new(0, 5, 0),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(60, 60, 66),
	}, door)
	frame.CollisionGroup = Groups.Pickups
	table.insert(active, {
		Kind = "Door",
		Model = door,
		Owner = owner,
		TargetRole = "Chaser",
		Expires = os.clock() + 6,
		Radius = 0,
		HP = 2,
	})
	Effect:FireAllClients({ Kind = "Door", Position = door.Position })
end

---------------------------------------------------------------------------
-- Knife vs doors: returns true if a swing landed on a door.
---------------------------------------------------------------------------
function Hazards.HitDoor(chaserRoot: BasePart, reach: number): boolean
	local origin = chaserRoot.Position
	local look = flat(chaserRoot.CFrame.LookVector)
	for i, h in active do
		if h.Kind == "Door" then
			local door = h.Model :: BasePart
			local rel = door.CFrame:PointToObjectSpace(origin)
			-- distance from the chaser to the door's plane, within its width
			local planeDist = math.abs(rel.Z)
			local facingDoor = look:Dot(flat(door.Position - origin)) > 0.2
			if planeDist <= reach and math.abs(rel.X) <= 8 and facingDoor then
				h.HP = (h.HP or 1) - 1
				Effect:FireAllClients({ Kind = "DoorHit", Position = door.Position })
				if (h.HP :: number) <= 0 then
					door:Destroy()
					table.remove(active, i)
				end
				return true
			end
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Frame step
---------------------------------------------------------------------------
local function trigger(h: Hazard, target: any)
	if h.Kind == "Trap" then
		Status.Stun(target, 0.5, "Trap")
		Effect:FireAllClients({ Kind = "Trap", Position = (h.Model :: Model):GetPivot().Position })
		if target.Player then
			Notify:FireClient(target.Player, { Kind = "Toast", Text = "BEAR TRAP!", Color = Color3.fromRGB(255, 120, 120), Sound = "Trap" })
		end
	elseif h.Kind == "Peel" then
		Status.Stun(target, 1.2, "Trip")
		Effect:FireAllClients({ Kind = "Slip", Model = target.Model })
		if target.Player then
			Notify:FireClient(target.Player, { Kind = "Toast", Text = "SLIPPED ON A BANANA!", Color = Color3.fromRGB(255, 225, 70), Sound = "Trip" })
		end
	elseif h.Kind == "Ball" then
		Status.Stun(target, 1.0, "Trip")
		Effect:FireAllClients({ Kind = "Slip", Model = target.Model })
		if target.Player then
			Notify:FireClient(target.Player, { Kind = "Toast", Text = "STRIKE! You got bowled over", Color = Color3.fromRGB(120, 160, 255), Sound = "Trip" })
		end
	end
end

local function step(dt: number)
	if #active == 0 then
		return
	end
	local now = os.clock()
	local targets: { [string]: { { Entry: any, Pos: Vector3 } } } = { Runner = {}, Chaser = {} }
	for _, e in Roster.InMatch() do
		if e.Role == "Runner" or e.Role == "Chaser" then
			local r = Roster.Root(e)
			if r and Arena.OnField(r.Position) then
				table.insert(targets[e.Role], { Entry = e, Pos = r.Position })
			end
		end
	end
	for i = #active, 1, -1 do
		local h = active[i]
		local alive = now < h.Expires and h.Model.Parent ~= nil
		if alive and h.Kind == "Ball" then
			local ball = h.Model :: BasePart
			local move = (h.Dir :: Vector3) * (h.Speed :: number) * dt
			local nextPos = ball.Position + move
			h.Traveled = (h.Traveled :: number) + move.Magnitude
			-- roll: spin around the axis perpendicular to travel
			local axis = Vector3.new(0, 1, 0):Cross(h.Dir :: Vector3)
			ball.CFrame = CFrame.fromAxisAngle(axis, move.Magnitude / 1.5) * (ball.CFrame - ball.Position) + nextPos
			if (h.Traveled :: number) > (h.MaxDistance :: number) or not Arena.OnField(nextPos) then
				alive = false
			end
		end
		if alive and h.Kind ~= "Door" then
			local pos = if h.Model:IsA("BasePart") then h.Model.Position else (h.Model :: Model):GetPivot().Position
			for _, t in targets[h.TargetRole] do
				local d = Vector3.new(t.Pos.X - pos.X, 0, t.Pos.Z - pos.Z).Magnitude
				if d <= h.Radius then
					trigger(h, t.Entry)
					alive = false
					break
				end
			end
		end
		if not alive then
			if h.Model.Parent then
				h.Model:Destroy()
			end
			table.remove(active, i)
		end
	end
end

function Hazards.Clear()
	for _, h in active do
		if h.Model.Parent then
			h.Model:Destroy()
		end
	end
	table.clear(active)
end

function Hazards.Start()
	RunService.Heartbeat:Connect(step)
end

return Hazards
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Break Ankles server entry point.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
require(Shared.Net) -- creates the remotes before anything else runs

local Groups = require(script.Parent.Groups)
local MapBuilder = require(script.Parent.MapBuilder)
local DataService = require(script.Parent.DataService)
local Roster = require(script.Parent.Roster)
local Hazards = require(script.Parent.Hazards)
local Combat = require(script.Parent.Combat)
local Abilities = require(script.Parent.Abilities)
local Gems = require(script.Parent.Gems)
local Bots = require(script.Parent.Bots)
local Match = require(script.Parent.Match)
local Shop = require(script.Parent.Shop)
local Phase = require(script.Parent.Phase)

Players.RespawnTime = 1.5
Players.CharacterAutoLoads = true

-- Remove the template baseplate if this place still has one.
local baseplate = workspace:FindFirstChild("Baseplate")
if baseplate then
	baseplate:Destroy()
end

Groups.Setup()
MapBuilder.BuildLobby()
MapBuilder.BuildArena("Valley")
Phase.Set("Waiting", nil, "Starting up")

DataService.Start()
Roster.Start()
Hazards.Start()
Combat.Start()
Abilities.Start()
Gems.Start()
Bots.Start()
Shop.Start()
Match.Start()

print("[BreakAnkles] Server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the lobby and the arena out of parts at runtime, so the place file
-- needs no imported models. Two themes share one layout: a long rectangular
-- field with a line and a safe zone at each end.

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Arena = require(Shared.Arena)
local Themes = require(Shared.Themes)
local Groups = require(script.Parent.Groups)

local HALF_L = Arena.HalfLength
local HALF_W = Arena.HalfWidth
local DEPTH = Arena.SafeDepth
local WALL_H = Config.Arena.WallHeight
local OUTER_Z = HALF_L + DEPTH

type Theme = Themes.Theme
local SIDE_COLORS = Themes.SideColors

local MapBuilder = {}

local arenaModel: Model? = nil
local gates: { [string]: BasePart } = {}

local function part(props: { [string]: any }, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function invisibleWall(size: Vector3, cf: CFrame, parent: Instance, name: string): Part
	return part({
		Name = name,
		Size = size,
		CFrame = cf,
		Transparency = 1,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	}, parent)
end

local function label(p: BasePart, face: Enum.NormalId, text: string, color: Color3, ppsOverride: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppsOverride or 30
	gui.LightInfluence = 0.2
	gui.Parent = p
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = text
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = color
	t.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = t
	return t
end

---------------------------------------------------------------------------
-- Lighting
---------------------------------------------------------------------------
local function ensure(className: string, name: string): Instance
	local inst = Lighting:FindFirstChild(name)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name;
		(inst :: Instance).Parent = Lighting
	end
	return inst :: Instance
end

function MapBuilder.ApplyLighting(themeId: string)
	local theme = Themes.Get(themeId)
	for k, v in theme.Lighting do
		(Lighting :: any)[k] = v
	end
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	local atmo = ensure("Atmosphere", "BA_Atmosphere") :: Atmosphere
	for k, v in theme.Atmosphere do
		(atmo :: any)[k] = v
	end
	local cc = ensure("ColorCorrectionEffect", "BA_Color") :: ColorCorrectionEffect
	cc.Saturation = 0.14
	cc.Contrast = 0.06
	cc.Brightness = 0.01
	cc.TintColor = theme.Tint
	local bloom = ensure("BloomEffect", "BA_Bloom") :: BloomEffect
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1.7
	local rays = ensure("SunRaysEffect", "BA_SunRays") :: SunRaysEffect
	rays.Intensity = 0.05
	rays.Spread = 0.8
end

---------------------------------------------------------------------------
-- Decor
---------------------------------------------------------------------------
local function tree(at: Vector3, rng: Random, parent: Instance)
	local h = rng:NextNumber(10, 18)
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(h, 2.2, 2.2),
		CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(110, 76, 48),
	}, parent)
	for i = 1, 3 do
		local s = rng:NextNumber(8, 13)
		part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s, s),
			Position = at + Vector3.new(rng:NextNumber(-2.5, 2.5), h + rng:NextNumber(-1, 3) + i * 0.6, rng:NextNumber(-2.5, 2.5)),
			Material = Enum.Material.Grass,
			Color = Color3.fromRGB(56 + rng:NextInteger(0, 30), 120 + rng:NextInteger(0, 40), 50),
			CastShadow = true,
		}, parent)
	end
end

local function cactus(at: Vector3, rng: Random, parent: Instance)
	local h = rng:NextNumber(7, 13)
	local green = Color3.fromRGB(80, 140, 70)
	part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(h, 2.4, 2.4),
		CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Grass,
		Color = green,
	}, parent)
	for _, side in { -1, 1 } do
		if rng:NextNumber() < 0.75 then
			local armH = rng:NextNumber(2.5, 4.5)
			local y = rng:NextNumber(h * 0.35, h * 0.7)
			part({
				Size = Vector3.new(3, 1.6, 1.6),
				CFrame = CFrame.new(at + Vector3.new(side * 1.8, y, 0)),
				Material = Enum.Material.Grass,
				Color = green,
			}, parent)
			part({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(armH, 1.6, 1.6),
				CFrame = CFrame.new(at + Vector3.new(side * 3, y + armH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Material = Enum.Material.Grass,
				Color = green,
			}, parent)
		end
	end
end

local function rock(at: Vector3, rng: Random, color: Color3, parent: Instance)
	local s = rng:NextNumber(3, 8)
	part({
		Name = "Rock",
		Size = Vector3.new(s * rng:NextNumber(0.9, 1.6), s * 0.7, s),
		CFrame = CFrame.new(at + Vector3.new(0, s * 0.25, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)),
		Material = Enum.Material.Slate,
		Color = color,
	}, parent)
end

local function outsideSpot(rng: Random, margin: number, spread: number): Vector3
	-- A random spot outside the fence, within `spread` studs of it.
	while true do
		local x = rng:NextNumber(-HALF_W - spread, HALF_W + spread)
		local z = rng:NextNumber(-OUTER_Z - spread, OUTER_Z + spread)
		if math.abs(x) > HALF_W + margin or math.abs(z) > OUTER_Z + margin then
			-- keep the lobby side clear
			local lobby = Arena.LobbyCenter()
			if (Vector3.new(x, 0, z) - Vector3.new(lobby.X, 0, lobby.Z)).Magnitude > 60 then
				return Vector3.new(x, 0, z)
			end
		end
	end
end

local function buildDecor(theme: Theme, parent: Instance)
	local rng = Random.new(if theme.Decor == "Valley" then 1384 else 4831)
	-- Rolling hills ring the arena.
	for i = 1, 26 do
		local angle = (i / 26) * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
		local r = rng:NextNumber(260, 330)
		local s = rng:NextNumber(120, 220)
		local pos = Vector3.new(math.cos(angle) * r * 0.8, -s * 0.38, math.sin(angle) * r * 1.15)
		part({
			Name = "Hill",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s, s),
			Position = pos,
			Material = theme.HillMaterial,
			Color = theme.HillColor:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.12)),
			CastShadow = false,
			CanCollide = false,
		}, parent)
	end
	local rockColor = if theme.Decor == "Valley" then Color3.fromRGB(120, 120, 124) else Color3.fromRGB(176, 120, 84)
	for _ = 1, 40 do
		local at = outsideSpot(rng, 10, 120)
		if theme.Decor == "Valley" then
			tree(at, rng, parent)
		else
			cactus(at, rng, parent)
		end
	end
	for _ = 1, 30 do
		rock(outsideSpot(rng, 6, 110), rng, rockColor, parent)
	end
end

---------------------------------------------------------------------------
-- Arena
---------------------------------------------------------------------------
local function fenceLine(from: Vector3, to: Vector3, color: Color3, parent: Instance)
	local delta = to - from
	local len = delta.Magnitude
	local dir = delta.Unit
	local count = math.floor(len / 10)
	for i = 0, count do
		local p = from + dir * (len * i / count)
		part({
			Name = "Post",
			Size = Vector3.new(0.9, 4.4, 0.9),
			Position = p + Vector3.new(0, 2.2, 0),
			Material = Enum.Material.Wood,
			Color = color,
		}, parent)
	end
	for _, y in { 1.6, 3.4 } do
		local mid = (from + to) / 2 + Vector3.new(0, y, 0)
		part({
			Name = "Rail",
			Size = Vector3.new(0.35, 0.5, len),
			CFrame = CFrame.lookAt(mid, mid + dir),
			Material = Enum.Material.Wood,
			Color = color,
		}, parent)
	end
end

local function arch(side: string, parent: Instance)
	local z = Arena.LineZ(side)
	local color = SIDE_COLORS[side]
	local outward = if side == "A" then -1 else 1
	for _, sx in { -1, 1 } do
		part({
			Name = "ArchPost",
			Size = Vector3.new(2.4, 20, 2.4),
			Position = Vector3.new(sx * (HALF_W + 2), 10, z),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(40, 42, 48),
		}, parent)
	end
	local beam = part({
		Name = "ArchBanner",
		Size = Vector3.new(HALF_W * 2 + 6, 4, 1.2),
		Position = Vector3.new(0, 21, z),
		Material = Enum.Material.SmoothPlastic,
		Color = color,
	}, parent)
	-- Text faces the field on one side and the safe zone on the other.
	local fieldFace = if outward == -1 then Enum.NormalId.Back else Enum.NormalId.Front
	local zoneFace = if outward == -1 then Enum.NormalId.Front else Enum.NormalId.Back
	label(beam, fieldFace, "SIDE " .. side .. "  •  SAFE ZONE", Color3.new(1, 1, 1), 12)
	label(beam, zoneFace, "SIDE " .. side, Color3.new(1, 1, 1), 12)
	-- A colored strip on the ground just inside the safe zone.
	part({
		Name = "SideStrip",
		Size = Vector3.new(HALF_W * 2, 0.12, 2.4),
		Position = Vector3.new(0, 0.12, z + outward * 2.4),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	}, parent)
end

function MapBuilder.BuildArena(themeId: string): Model
	local theme = Themes.Get(themeId)
	if arenaModel then
		arenaModel:Destroy()
	end
	gates = {}
	local model = Instance.new("Model")
	model.Name = "Arena"
	model:SetAttribute("Theme", themeId)

	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = model

	-- World floor.
	part({
		Name = "Surround",
		Size = Vector3.new(900, 4, 1000),
		Position = Vector3.new(0, -2.05, 0),
		Material = theme.Surround,
		Color = theme.SurroundColor,
	}, ground)

	-- The field with mowing stripes.
	part({
		Name = "Field",
		Size = Vector3.new(HALF_W * 2, 1, HALF_L * 2),
		Position = Vector3.new(0, -0.45, 0),
		Material = theme.Ground,
		Color = theme.GroundColor,
	}, ground)
	local stripes = 11
	local stripeLen = HALF_L * 2 / stripes
	for i = 0, stripes - 1, 2 do
		part({
			Name = "Stripe",
			Size = Vector3.new(HALF_W * 2, 0.1, stripeLen),
			Position = Vector3.new(0, 0.1, -HALF_L + stripeLen * (i + 0.5)),
			Material = theme.Ground,
			Color = theme.StripeColor,
			CanCollide = false,
		}, ground)
	end
	-- Safe zones.
	for _, side in { "A", "B" } do
		local sign = if side == "A" then -1 else 1
		part({
			Name = "SafeZone" .. side,
			Size = Vector3.new(HALF_W * 2, 1, DEPTH),
			Position = Vector3.new(0, -0.45, sign * (HALF_L + DEPTH / 2)),
			Material = theme.SafeMaterial,
			Color = theme.SafeColor,
		}, ground)
		-- The line.
		part({
			Name = "Line" .. side,
			Size = Vector3.new(HALF_W * 2, 0.14, 1.6),
			Position = Vector3.new(0, 0.14, sign * HALF_L),
			Color = Color3.fromRGB(250, 250, 250),
			CanCollide = false,
		}, ground)
	end

	-- Fence, arches and invisible walls.
	local bounds = Instance.new("Folder")
	bounds.Name = "Bounds"
	bounds.Parent = model
	fenceLine(Vector3.new(-HALF_W - 1, 0, -OUTER_Z), Vector3.new(-HALF_W - 1, 0, OUTER_Z), theme.FenceColor, bounds)
	fenceLine(Vector3.new(HALF_W + 1, 0, -OUTER_Z), Vector3.new(HALF_W + 1, 0, OUTER_Z), theme.FenceColor, bounds)
	fenceLine(Vector3.new(-HALF_W - 1, 0, -OUTER_Z - 1), Vector3.new(HALF_W + 1, 0, -OUTER_Z - 1), theme.FenceColor, bounds)
	fenceLine(Vector3.new(-HALF_W - 1, 0, OUTER_Z + 1), Vector3.new(HALF_W + 1, 0, OUTER_Z + 1), theme.FenceColor, bounds)
	arch("A", bounds)
	arch("B", bounds)
	local wallLen = OUTER_Z * 2 + 4
	invisibleWall(Vector3.new(2, WALL_H, wallLen), CFrame.new(-HALF_W - 2.5, WALL_H / 2, 0), bounds, "WallLeft")
	invisibleWall(Vector3.new(2, WALL_H, wallLen), CFrame.new(HALF_W + 2.5, WALL_H / 2, 0), bounds, "WallRight")
	invisibleWall(Vector3.new(HALF_W * 2 + 8, WALL_H, 2), CFrame.new(0, WALL_H / 2, -OUTER_Z - 2.5), bounds, "WallBackA")
	invisibleWall(Vector3.new(HALF_W * 2 + 8, WALL_H, 2), CFrame.new(0, WALL_H / 2, OUTER_Z + 2.5), bounds, "WallBackB")
	invisibleWall(Vector3.new(HALF_W * 2 + 8, 2, wallLen), CFrame.new(0, WALL_H + 1, 0), bounds, "Ceiling")

	-- Chaser barriers sit just inside each safe zone; runner gates hold the
	-- runners back during the countdown.
	for _, side in { "A", "B" } do
		local sign = if side == "A" then -1 else 1
		local barrier = invisibleWall(Vector3.new(HALF_W * 2 + 4, WALL_H, 1), CFrame.new(0, WALL_H / 2, sign * (HALF_L + 1.6)), bounds, "ChaserBarrier" .. side)
		barrier.CollisionGroup = Groups.ChaserBarrier
		local gate = part({
			Name = "RunnerGate" .. side,
			Size = Vector3.new(HALF_W * 2 + 4, 12, 0.6),
			Position = Vector3.new(0, 6, sign * (HALF_L + 0.5)),
			Material = Enum.Material.ForceField,
			Color = SIDE_COLORS[side],
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, bounds)
		gate.CollisionGroup = Groups.RunnerGate
		gates[side] = gate
	end

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = model
	buildDecor(theme, decor)

	local dynamic = Instance.new("Folder")
	dynamic.Name = "Dynamic" -- gems, traps, doors, peels
	dynamic.Parent = model

	model.Parent = workspace
	arenaModel = model
	MapBuilder.ApplyLighting(themeId)
	return model
end

function MapBuilder.Dynamic(): Folder
	local m = arenaModel
	if m then
		local f = m:FindFirstChild("Dynamic")
		if f then
			return f :: Folder
		end
	end
	return workspace
end

function MapBuilder.ClearDynamic()
	local f = MapBuilder.Dynamic()
	if f ~= workspace then
		f:ClearAllChildren()
	end
end

-- Closed gates are visible and stop runners; open ones vanish.
function MapBuilder.SetGate(side: string, closed: boolean)
	local g = gates[side]
	if g then
		g.CanCollide = closed
		g.Transparency = if closed then 0.35 else 1
	end
end

---------------------------------------------------------------------------
-- Lobby: a raised deck beside the field, so waiting players can watch.
---------------------------------------------------------------------------
local lobbySpawn: SpawnLocation? = nil

function MapBuilder.BuildLobby(): Model
	local old = workspace:FindFirstChild("Lobby")
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "Lobby"
	local c = Arena.LobbyCenter()
	local w, d = 70, 84

	part({
		Name = "Deck",
		Size = Vector3.new(w, 2, d),
		Position = c - Vector3.new(0, 1, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(150, 112, 78),
	}, model)
	-- Supports down to the ground.
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local h = c.Y
			part({
				Name = "Pillar",
				Size = Vector3.new(3, h, 3),
				Position = Vector3.new(c.X + sx * (w / 2 - 3), h / 2 - 2, c.Z + sz * (d / 2 - 3)),
				Material = Enum.Material.Concrete,
				Color = Color3.fromRGB(190, 190, 196),
			}, model)
		end
	end
	-- Glass rail (visible) with a tall invisible wall so nobody falls off.
	local railColor = Color3.fromRGB(200, 230, 255)
	local function rail(size: Vector3, pos: Vector3)
		part({ Name = "Rail", Size = size, Position = pos + Vector3.new(0, 1.8, 0), Material = Enum.Material.Glass, Transparency = 0.6, Color = railColor }, model)
		invisibleWall(Vector3.new(size.X, 16, size.Z), CFrame.new(pos + Vector3.new(0, 8, 0)), model, "LobbyWall")
	end
	rail(Vector3.new(0.5, 3.6, d), c + Vector3.new(w / 2, 0, 0))
	rail(Vector3.new(0.5, 3.6, d), c + Vector3.new(-w / 2, 0, 0))
	rail(Vector3.new(w, 3.6, 0.5), c + Vector3.new(0, 0, d / 2))
	rail(Vector3.new(w, 3.6, 0.5), c + Vector3.new(0, 0, -d / 2))

	-- Poster board at the back of the deck, facing the field: the thumbnail
	-- art, with a text title behind it in case the image doesn't load.
	local board = part({
		Name = "TitleBoard",
		Size = Vector3.new(1, 18, 32),
		Position = c + Vector3.new(-w / 2 + 2, 11, 0),
		Color = Color3.fromRGB(24, 26, 34),
	}, model)
	local title = label(board, Enum.NormalId.Right, "BREAK ANKLES", Color3.fromRGB(255, 200, 60), 16)
	title.Size = UDim2.fromScale(1, 0.62)
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0.04, 0.62)
	sub.Size = UDim2.fromScale(0.92, 0.32)
	sub.TextScaled = true
	sub.Font = Enum.Font.GothamBold
	sub.TextColor3 = Color3.new(1, 1, 1)
	sub.Text = "Cross the field 3 times. Juke the knife. Don't get caught."
	sub.Parent = title.Parent
	local poster = Instance.new("ImageLabel")
	poster.Name = "Poster"
	poster.BackgroundTransparency = 1
	poster.Size = UDim2.fromScale(1, 1)
	poster.ScaleType = Enum.ScaleType.Crop
	poster.Image = Config.Art.Poster
	poster.ZIndex = 2
	poster.Parent = title.Parent

	-- How-to board on the side.
	local howto = part({
		Name = "HowToBoard",
		Size = Vector3.new(26, 12, 1),
		Position = c + Vector3.new(0, 7.5, d / 2 - 2),
		Color = Color3.fromRGB(24, 26, 34),
	}, model)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0.2
	gui.Parent = howto
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.new(1, -40, 1, -30)
	text.Position = UDim2.fromOffset(20, 15)
	text.TextScaled = true
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.Font = Enum.Font.GothamBold
	text.TextColor3 = Color3.new(1, 1, 1)
	text.RichText = true
	text.Text = table.concat({
		'<font color="#FFC83C">HOW TO PLAY</font>',
		"RUNNERS: cross to the other side 3 times.",
		"CHASER: one knife hit downs a runner.",
		"Downed runners can be revived (hold E).",
		"Nobody saves you? You become a chaser.",
		"",
		'<font color="#7FD4FF">Space + A/D</font>  dash     <font color="#7FD4FF">Alt</font>  instant stop',
		'<font color="#7FD4FF">Q</font>  ability     <font color="#7FD4FF">F</font>  item     <font color="#7FD4FF">Click</font>  swing',
	}, "\n")
	text.Parent = gui
	howto.CFrame = CFrame.lookAt(howto.Position, howto.Position + Vector3.new(0, 0, -1))

	-- Shop stall with a prompt the client turns into the shop menu.
	local stall = part({
		Name = "ShopStall",
		Size = Vector3.new(10, 4, 4),
		Position = c + Vector3.new(-14, 2, -d / 2 + 6),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(196, 92, 60),
	}, model)
	local awning = part({
		Name = "Awning",
		Size = Vector3.new(11, 0.6, 6),
		Position = stall.Position + Vector3.new(0, 6, 0),
		Color = Color3.fromRGB(255, 220, 90),
	}, model)
	label(awning, Enum.NormalId.Back, "SHOP", Color3.new(1, 1, 1), 20)
	label(awning, Enum.NormalId.Top, "SHOP", Color3.fromRGB(196, 92, 60), 6)
	for _, sx in { -1, 1 } do
		part({ Size = Vector3.new(0.6, 6, 0.6), Position = stall.Position + Vector3.new(sx * 5, 3, 2.5), Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 76, 48) }, model)
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShopPrompt"
	prompt.ActionText = "Open Shop"
	prompt.ObjectText = "Gems & Coins"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = stall

	-- Canopy over the middle of the deck.
	part({
		Name = "Canopy",
		Size = Vector3.new(w - 10, 0.6, 30),
		Position = c + Vector3.new(0, 16, 0),
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Color = Color3.fromRGB(150, 210, 255),
		CastShadow = false,
	}, model)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local post = part({
				Name = "CanopyPost",
				Size = Vector3.new(1, 16, 1),
				Position = c + Vector3.new(sx * (w / 2 - 6), 8, sz * 14),
				Material = Enum.Material.Metal,
				Color = Color3.fromRGB(60, 62, 70),
			}, model)
			local light = Instance.new("PointLight")
			light.Range = 18
			light.Brightness = 0.8
			light.Color = Color3.fromRGB(255, 236, 200)
			light.Parent = post
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = c + Vector3.new(4, 0.5, 0)
	spawn.Transparency = 0
	spawn.Material = Enum.Material.Neon
	spawn.Color = Color3.fromRGB(255, 200, 60)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = model
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	lobbySpawn = spawn

	model.Parent = workspace
	return model
end

function MapBuilder.LobbyCFrame(index: number?): CFrame
	local c = Arena.LobbyCenter()
	local i = index or math.random(1, 12)
	local angle = (i % 12) / 12 * math.pi * 2
	local pos = c + Vector3.new(6 + math.cos(angle) * 9, 3, math.sin(angle) * 14)
	-- Face the field (+X).
	return CFrame.lookAt(pos, pos + Vector3.new(1, 0, 0))
end

function MapBuilder.InLobby(pos: Vector3): boolean
	local c = Arena.LobbyCenter()
	return math.abs(pos.X - c.X) < 36 and math.abs(pos.Z - c.Z) < 43 and pos.Y > c.Y - 6 and pos.Y < c.Y + 30
end

function MapBuilder.Spawn(): SpawnLocation?
	return lobbySpawn
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[--!strict
-- The match loop: intermission and map vote -> pick the chaser -> three
-- crossings (with the odd Hero or Chicken offer) -> results -> lobby.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arena = require(Shared.Arena)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Bots = require(script.Parent.Bots)
local Combat = require(script.Parent.Combat)
local DataService = require(script.Parent.DataService)
local Gems = require(script.Parent.Gems)
local Hazards = require(script.Parent.Hazards)
local MapBuilder = require(script.Parent.MapBuilder)
local Phase = require(script.Parent.Phase)
local Rewards = require(script.Parent.Rewards)
local Roster = require(script.Parent.Roster)

local M = Config.Match
local R = Config.Rewards

local Notify = Net.Event("Notify")
local HeroChoice = Net.Event("HeroChoice")
local ResultsEvent = Net.Event("Results")

local Match = {}

local rng = Random.new()
local anyCaught = false
local heroAnswer: { [Player]: string } = {}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function announce(text: string, sub: string?, color: Color3?, sound: string?)
	Notify:FireAllClients({ Kind = "Announce", Text = text, Sub = sub, Color = color, Sound = sound })
end

local function feed(text: string)
	Notify:FireAllClients({ Kind = "Feed", Text = text })
end

local function counts(): (number, number)
	local runners, chasers = 0, 0
	for _, e in Roster.InMatch() do
		if e.Role == "Runner" or e.Role == "Downed" then
			runners += 1
		elseif e.Role == "Chaser" then
			chasers += 1
		end
	end
	Phase.Attr("Runners", runners)
	Phase.Attr("Chasers", chasers)
	return runners, chasers
end

local function eligiblePlayers(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		local e = Roster.ForPlayer(p)
		local char = p.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if e and hum and hum.Health > 0 and not p:GetAttribute("AFK") and DataService.Get(p) then
			table.insert(list, p)
		end
	end
	return list
end

local function shuffle<T>(list: { T }): { T }
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

local function placeRunners(side: string)
	local runners = {}
	for _, e in Roster.InMatch() do
		if e.Role == "Runner" or e.Role == "Downed" then
			table.insert(runners, e)
		end
	end
	for i, e in runners do
		Roster.Place(e, Arena.SafeSpot(side, i, #runners))
	end
end

local function placeChasers()
	local chasers = Roster.WithRole("Chaser")
	for i, e in chasers do
		Roster.Place(e, Arena.ChaserSpot(i, #chasers, Phase.Direction))
	end
end

local function sendToLobby(e: any, i: number)
	Roster.Place(e, MapBuilder.LobbyCFrame(i))
end

-- If every chaser left, hand the knife to a random runner.
local function ensureChaser()
	local runners, chasers = counts()
	if chasers == 0 and runners >= 2 then
		local pool = Roster.WithRole("Runner")
		if #pool > 0 then
			local e = pool[rng:NextInteger(1, #pool)]
			Combat.Convert(e)
			feed(e.Name .. " picked up the knife")
		end
	end
end

local function cancelMatchIfEmpty(): boolean
	local runners, chasers = counts()
	if runners == 0 or (chasers == 0 and runners < 2) then
		return true
	end
	-- Don't keep a bots-only match running after the last player leaves.
	for _, e in Roster.InMatch() do
		if e.Player then
			return false
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Intermission
---------------------------------------------------------------------------
local function tallyVotes(): string
	local tally: { [string]: number } = {}
	for _, m in Config.Maps do
		tally[m.Id] = 0
	end
	for player, id in Phase.Votes do
		if player.Parent == Players and tally[id] then
			tally[id] += 1
		end
	end
	local best, bestCount, ties = Config.Maps[1].Id, -1, {}
	for _, m in Config.Maps do
		local c = tally[m.Id]
		if c > bestCount then
			best, bestCount, ties = m.Id, c, { m.Id }
		elseif c == bestCount then
			table.insert(ties, m.Id)
		end
	end
	if #ties > 1 then
		best = ties[rng:NextInteger(1, #ties)]
	end
	return best
end

function Match.UpdateVotes()
	for _, m in Config.Maps do
		local c = 0
		for player, id in Phase.Votes do
			if id == m.Id and player.Parent == Players then
				c += 1
			end
		end
		Phase.Attr("Vote_" .. m.Id, c)
	end
end

local function needed(): number
	return if Config.Bots.Enabled then 1 else M.MinPlayers
end

local function intermission()
	table.clear(Phase.Votes)
	Match.UpdateVotes()
	while true do
		if #eligiblePlayers() < needed() then
			Phase.Set("Waiting", nil, if Config.Bots.Enabled then "Waiting for players" else ("Waiting for %d players"):format(M.MinPlayers))
			repeat
				task.wait(1)
			until #eligiblePlayers() >= needed()
		end
		Phase.Set("Intermission", M.Intermission, "Intermission")
		local ok = true
		for _ = 1, M.Intermission do
			task.wait(1)
			if #eligiblePlayers() < needed() then
				ok = false
				break
			end
		end
		if ok then
			return
		end
	end
end

---------------------------------------------------------------------------
-- Crossings
---------------------------------------------------------------------------
local function resolveCrossing(target: string)
	for _, e in Roster.WithRole("Downed") do
		Combat.Convert(e)
	end
	for _, e in Roster.WithRole("Runner") do
		local root = Roster.Root(e)
		if root and Arena.InSafeZone(root.Position, target) then
			e.Crossings += 1
			Rewards.Give(e, R.CrossingGems, R.CrossingCoins, R.CrossingXP, ("Crossing %d"):format(Phase.Crossing))
			if e.Player then
				Notify:FireClient(e.Player, { Kind = "Toast", Text = ("CROSSING %d COMPLETE"):format(Phase.Crossing), Color = Color3.fromRGB(140, 255, 160), Sound = "Safe" })
			end
		else
			Combat.Convert(e, "time")
		end
	end
	Gems.Clear()
	Hazards.Clear()
	counts()
end

local function allRunnersSafe(target: string): boolean
	if #Roster.WithRole("Downed") > 0 then
		return false
	end
	local any = false
	for _, e in Roster.WithRole("Runner") do
		local root = Roster.Root(e)
		if not root or not Arena.InSafeZone(root.Position, target) then
			return false
		end
		any = true
	end
	return any
end

local function runCrossing()
	local start = Arena.StartSide(Phase.Direction)
	local target = Arena.TargetSide(Phase.Direction)
	Phase.Attr("Crossing", Phase.Crossing)
	Phase.Attr("Direction", Phase.Direction)

	-- Anyone who isn't in the start zone (only possible after a respawn) goes there.
	for i, e in Roster.WithRole("Runner") do
		local root = Roster.Root(e)
		if root and not Arena.InSafeZone(root.Position, start) and not Arena.InSafeZone(root.Position, target) then
			Roster.Place(e, Arena.SafeSpot(start, i, 8))
		end
	end
	placeChasers()
	MapBuilder.SetGate(start, true)
	Phase.Set("Countdown", M.Countdown, ("Crossing %d of %d"):format(Phase.Crossing, M.CrossingsToWin))
	for i = M.Countdown, 1, -1 do
		Notify:FireAllClients({ Kind = "Count", Text = tostring(i) })
		task.wait(1)
	end
	MapBuilder.SetGate(start, false)
	Gems.Spawn(R.FieldGemsPerCrossing)
	Phase.Set("Crossing", M.CrossingTime, ("Crossing %d of %d"):format(Phase.Crossing, M.CrossingsToWin))
	announce("RUN!!", "Get to side " .. target, Color3.fromRGB(255, 255, 255), "Tick")

	local deadline = os.clock() + M.CrossingTime
	local safeSince: number? = nil
	while os.clock() < deadline do
		task.wait(0.1)
		Combat.Tick()
		ensureChaser()
		if cancelMatchIfEmpty() then
			break
		end
		if allRunnersSafe(target) then
			safeSince = safeSince or os.clock()
			if os.clock() - (safeSince :: number) > 0.6 then
				break
			end
		else
			safeSince = nil
		end
	end
	resolveCrossing(target)
end

local function heroPhase()
	local runners = Roster.WithRole("Runner")
	if #runners < 2 then
		return
	end
	local pick = runners[rng:NextInteger(1, #runners)]
	local start = Arena.StartSide(Phase.Direction)
	local target = Arena.TargetSide(Phase.Direction)
	Phase.Attr("Crossing", Phase.Crossing)
	Phase.Attr("Direction", Phase.Direction)
	Phase.Set("HeroChoice", M.HeroChoiceTime, pick.Name .. " is deciding: HERO or CHICKEN?")
	announce("HERO OR CHICKEN?", pick.Name .. " can cross alone for a bonus", Color3.fromRGB(255, 225, 90), "Tick")

	local choice = "Chicken"
	if pick.Player then
		heroAnswer[pick.Player] = nil
		HeroChoice:FireClient(pick.Player, { Time = M.HeroChoiceTime, Reward = R.HeroGems })
		local deadline = os.clock() + M.HeroChoiceTime
		while os.clock() < deadline and not heroAnswer[pick.Player] and pick.Player.Parent do
			task.wait(0.1)
		end
		choice = heroAnswer[pick.Player] or "Chicken"
		heroAnswer[pick.Player] = nil
	else
		task.wait(rng:NextNumber(1.5, 3))
		choice = if rng:NextNumber() < 0.5 then "Hero" else "Chicken"
	end
	if pick.Role ~= "Runner" then
		return
	end
	if choice ~= "Hero" then
		pick.Chicken = true
		announce("CHICKEN!", pick.Name .. " stays with the group", Color3.fromRGB(255, 255, 255))
		task.wait(1.5)
		return
	end

	Phase.Hero = pick
	placeChasers()
	MapBuilder.SetGate(start, true) -- stays shut for everyone except the hero
	Phase.Set("HeroCountdown", 3, pick.Name .. " is going solo!")
	announce("HERO RUN!", pick.Name .. " crosses alone", Color3.fromRGB(255, 225, 90), "Tick")
	for i = 3, 1, -1 do
		Notify:FireAllClients({ Kind = "Count", Text = tostring(i) })
		task.wait(1)
	end
	-- Only now does the hero's collision group let them through the gate.
	pick.IsHero = true
	Roster.RefreshGroup(pick)
	Phase.Set("HeroRun", M.HeroCrossingTime, pick.Name .. "'s Hero run")
	if pick.Player then
		Notify:FireClient(pick.Player, { Kind = "Announce", Text = "GO, HERO!", Sub = "Reach side " .. target .. " alone", Color = Color3.fromRGB(255, 225, 90) })
	end
	local deadline = os.clock() + M.HeroCrossingTime
	local made = false
	while os.clock() < deadline do
		task.wait(0.1)
		Combat.Tick()
		ensureChaser()
		if pick.Role ~= "Runner" or not pick.InMatch then
			break
		end
		local root = Roster.Root(pick)
		if root and Arena.InSafeZone(root.Position, target) then
			made = true
			break
		end
	end
	pick.IsHero = false
	Phase.Hero = nil
	if made then
		Rewards.Give(pick, R.HeroGems, 0, R.SurviveXP, "Hero run")
		Rewards.Stat(pick, "Heroes", 1)
		announce("HERO!", pick.Name .. " made it across alone", Color3.fromRGB(255, 225, 90), "Win")
	elseif pick.Role == "Runner" then
		Combat.Convert(pick, "time")
		announce("FALLEN HERO", pick.Name .. " ran out of time", Color3.fromRGB(255, 120, 120))
	elseif pick.Role == "Downed" then
		Combat.Convert(pick)
		announce("FALLEN HERO", pick.Name .. " got caught", Color3.fromRGB(255, 120, 120))
	else
		announce("FALLEN HERO", pick.Name .. " got caught", Color3.fromRGB(255, 120, 120))
	end
	Roster.RefreshGroup(pick)
	Hazards.Clear()
	task.wait(2)
end

---------------------------------------------------------------------------
-- Results
---------------------------------------------------------------------------
local function finish(runnersWin: boolean, cancelled: boolean)
	local survivors = {}
	for _, e in Roster.WithRole("Runner") do
		table.insert(survivors, e.Name)
	end
	local flawless = runnersWin and not anyCaught
	local mvp, mvpScore = nil, 0
	for _, e in Roster.InMatch() do
		local score = e.Ankles * 2 + e.Catches * 2 + e.Rescues * 3 + e.Crossings
		if score > mvpScore then
			mvp, mvpScore = e, score
		end
		if not cancelled then
			if runnersWin and e.Role == "Runner" then
				Rewards.Give(e, R.SurviveGems, R.SurviveCoins, R.SurviveXP, "Survived")
				Rewards.Stat(e, "Wins", 1)
				if flawless then
					Rewards.Give(e, R.FlawlessGems, 0, 0, "Flawless")
					Rewards.GrantTitle(e, "Flawless")
				end
			elseif not runnersWin and e.Role == "Chaser" then
				Rewards.Give(e, R.ChaserWinGems, R.ChaserWinCoins, R.ChaserWinXP, "Chasers win")
				Rewards.Stat(e, "Wins", 1)
			end
			Rewards.Give(e, 0, R.ParticipationCoins, R.ParticipationXP, "Played a match", true)
			Rewards.Stat(e, "Matches", 1)
		end
	end
	local headline = if cancelled then "MATCH ENDED" elseif runnersWin then (if flawless then "FLAWLESS! RUNNERS WIN" else "RUNNERS WIN") else "CHASERS WIN"
	local color = if cancelled then Color3.fromRGB(220, 220, 220) elseif runnersWin then Color3.fromRGB(140, 255, 160) else Color3.fromRGB(255, 90, 90)
	Phase.Set("Results", M.ResultsTime, headline)
	announce(headline, if runnersWin then (#survivors .. " survived") else nil, color, if cancelled then nil else "Win")
	for _, e in Roster.InMatch() do
		if e.Player then
			ResultsEvent:FireClient(e.Player, {
				Headline = headline,
				Color = color,
				RunnersWin = runnersWin,
				YouWon = not cancelled and ((runnersWin and e.Role == "Runner") or (not runnersWin and e.Role == "Chaser")),
				Survivors = survivors,
				MVP = if mvp then mvp.Name else nil,
				Crossings = e.Crossings,
				Ankles = e.Ankles,
				Catches = e.Catches,
				Rescues = e.Rescues,
				Gems = e.Earned.Gems,
				Coins = e.Earned.Coins,
				XP = e.Earned.XP,
				Lines = e.Earned.Lines,
				Time = M.ResultsTime,
			})
		end
	end
	task.wait(M.ResultsTime)
end

local function cleanup()
	local i = 0
	for _, e in Roster.InMatch() do
		i += 1
		Roster.EndMatch(e)
		if not e.IsBot then
			sendToLobby(e, i)
		end
	end
	Bots.DespawnAll()
	Gems.Clear()
	Hazards.Clear()
	MapBuilder.SetGate("A", false)
	MapBuilder.SetGate("B", false)
	Phase.Hero = nil
	Phase.Crossing = 0
	Phase.Attr("Crossing", 0)
	counts()
end

---------------------------------------------------------------------------
-- A whole match
---------------------------------------------------------------------------
local function runMatch()
	local mapId = tallyVotes()
	Phase.Attr("Map", mapId)
	MapBuilder.BuildArena(mapId)

	local humans = eligiblePlayers()
	local participants = {}
	for _, p in humans do
		local e = Roster.ForPlayer(p)
		if e then
			Roster.BeginMatch(e)
			table.insert(participants, e)
		end
	end
	if Config.Bots.Enabled and #participants < Config.Bots.FillTo then
		for _, e in Bots.Spawn(Config.Bots.FillTo - #participants) do
			Roster.BeginMatch(e)
			table.insert(participants, e)
		end
	end
	if #participants < 2 then
		for _, e in participants do
			Roster.EndMatch(e)
		end
		Bots.DespawnAll()
		return
	end

	anyCaught = false
	Phase.Direction = 1
	Phase.Crossing = 1
	Phase.Attr("Direction", 1)
	Phase.Attr("Crossing", 1)

	-- Pick the chaser(s). Prefer real players for the knife only by chance.
	shuffle(participants)
	local chaserCount = math.max(1, math.floor(#participants / M.PlayersPerChaser))
	for i, e in participants do
		if i <= chaserCount then
			e.OriginalChaser = true
			Roster.SetRole(e, "Chaser")
		else
			Roster.SetRole(e, "Runner")
		end
	end
	placeRunners("A")
	placeChasers()
	MapBuilder.SetGate("A", true)
	counts()

	local mapName = mapId
	for _, m in Config.Maps do
		if m.Id == mapId then
			mapName = m.Name
		end
	end
	Phase.Set("Intro", 4, mapName)
	for _, e in participants do
		if e.Player then
			if e.Role == "Chaser" then
				Notify:FireClient(e.Player, { Kind = "Announce", Text = "YOU'RE THE CHASER", Sub = "One knife hit downs a runner. Click to swing.", Color = Color3.fromRGB(255, 90, 90), Sound = "Equip" })
			else
				Notify:FireClient(e.Player, { Kind = "Announce", Text = "YOU'RE A RUNNER", Sub = ("Cross the field %d times. Break some ankles."):format(M.CrossingsToWin), Color = Color3.fromRGB(140, 255, 160), Sound = "Tick" })
			end
		end
	end
	local chaserNames = {}
	for _, e in Roster.WithRole("Chaser") do
		table.insert(chaserNames, e.Name)
	end
	feed(table.concat(chaserNames, ", ") .. " has the knife")
	task.wait(4)

	local completed = false
	for c = 1, M.CrossingsToWin do
		Phase.Crossing = c
		if c >= 2 and rng:NextNumber() < M.HeroChance then
			heroPhase()
			if cancelMatchIfEmpty() then
				break
			end
		end
		runCrossing()
		if cancelMatchIfEmpty() then
			break
		end
		if c == M.CrossingsToWin then
			completed = true
		else
			Phase.Direction = -Phase.Direction
			Phase.Attr("Direction", Phase.Direction)
			Phase.Set("Between", M.BetweenCrossings, ("Crossing %d done - %d runners left"):format(c, (counts())))
			task.wait(M.BetweenCrossings)
		end
	end

	local runners, chasers = counts()
	local cancelled = runners > 0 and chasers == 0
	finish(completed and runners > 0, cancelled)
	cleanup()
end

---------------------------------------------------------------------------
-- Respawns and strays
---------------------------------------------------------------------------
local function onCharacter(e: any)
	if not e.InMatch or not Phase.InArena() then
		return
	end
	task.wait(0.2)
	if e.Role == "Chaser" then
		Roster.Place(e, Arena.ChaserSpot(1, 1, Phase.Direction))
	else
		-- A respawned runner goes back to the start zone of this crossing.
		Roster.Place(e, Arena.SafeSpot(Arena.StartSide(Phase.Direction), rng:NextInteger(1, 8), 8))
	end
end

local function watchdog()
	while true do
		task.wait(0.5)
		for i, e in Roster.All() do
			local root = Roster.Root(e)
			if root then
				local pos = root.Position
				if e.InMatch then
					if not Arena.InBounds(pos) then
						if e.Role == "Chaser" then
							Roster.Place(e, Arena.ChaserSpot(1, 1, Phase.Direction))
						else
							Roster.Place(e, Arena.SafeSpot(Arena.StartSide(Phase.Direction), 1, 8))
						end
					end
				elseif not e.IsBot and not MapBuilder.InLobby(pos) then
					sendToLobby(e, i)
				end
			end
		end
	end
end

function Match.Answer(player: Player, choice: string)
	if choice == "Hero" or choice == "Chicken" then
		heroAnswer[player] = choice
	end
end

function Match.Start()
	Combat.OnCaught = function(_runner)
		anyCaught = true
	end
	Roster.OnCharacter(onCharacter)
	HeroChoice.OnServerEvent:Connect(function(player, choice)
		if type(choice) == "string" then
			Match.Answer(player, choice)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		Phase.Votes[player] = nil
		Match.UpdateVotes()
		task.defer(counts)
	end)
	task.spawn(watchdog)
	task.spawn(function()
		while true do
			intermission()
			local ok, err = pcall(function()
				runMatch()
			end)
			if not ok then
				warn("[BreakAnkles] Match error: " .. tostring(err))
				pcall(cleanup)
			end
			task.wait(1)
		end
	end)
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Phase</string>
          <string name="Source"><![CDATA[--!strict
-- The match's current phase, shared by every server system. Match.luau is
-- the only writer; everything else reads. The same values are mirrored as
-- attributes on ReplicatedStorage.MatchState for clients.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local State = Net.State()

local Phase = {}

Phase.Name = "Waiting"
Phase.Crossing = 0
Phase.Direction = 1
Phase.Hero = nil :: any -- the Entry doing a Hero run, if any
Phase.Votes = {} :: { [Player]: string }

-- Phases where knives, abilities and pickups are active.
local LIVE = { Crossing = true, HeroRun = true }
-- Phases where players are in the arena (abilities usable but not knives).
local ACTIVE = { Intro = true, Countdown = true, Crossing = true, Between = true, HeroChoice = true, HeroCountdown = true, HeroRun = true }

function Phase.Set(name: string, duration: number?, status: string?)
	Phase.Name = name
	State:SetAttribute("Phase", name)
	State:SetAttribute("EndsAt", if duration then workspace:GetServerTimeNow() + duration else 0)
	if status then
		State:SetAttribute("Status", status)
	end
end

function Phase.SetStatus(status: string)
	State:SetAttribute("Status", status)
end

function Phase.IsLive(): boolean
	return LIVE[Phase.Name] == true
end

function Phase.InArena(): boolean
	return ACTIVE[Phase.Name] == true
end

function Phase.Attr(name: string, value: any)
	State:SetAttribute(name, value)
end

return Phase
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Rewards</string>
          <string name="Source"><![CDATA[--!strict
-- Pays out gems, coins and XP the moment they're earned (so leaving early
-- keeps them) and keeps a per-match list for the results screen.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local DataService = require(script.Parent.DataService)

local Notify = Net.Event("Notify")

local Rewards = {}

function Rewards.Give(entry: any, gems: number, coins: number, xp: number, reason: string, quiet: boolean?)
	local player: Player? = entry.Player
	if not player then
		return
	end
	local g, c = DataService.Award(player, gems, coins, xp)
	entry.Earned.Gems += g
	entry.Earned.Coins += c
	entry.Earned.XP += xp
	table.insert(entry.Earned.Lines, { Reason = reason, Gems = g, Coins = c, XP = xp })
	if not quiet then
		local parts = {}
		if g > 0 then
			table.insert(parts, ("+%d Gems"):format(g))
		end
		if c > 0 then
			table.insert(parts, ("+%d Coins"):format(c))
		end
		if #parts > 0 then
			Notify:FireClient(player, { Kind = "Popup", Text = table.concat(parts, "  "), Sub = reason })
		end
	end
end

function Rewards.Stat(entry: any, field: string, amount: number)
	local player: Player? = entry.Player
	if not player then
		return
	end
	DataService.Mutate(player, function(p: any)
		p[field] = (p[field] or 0) + amount
		if field == "Catches" and p.Catches >= 25 then
			p.OwnedTitles.Menace = true
		elseif field == "Ankles" and p.Ankles >= 50 then
			p.OwnedTitles.Untouchable = true
		elseif field == "Heroes" then
			p.OwnedTitles.Hero = true
		end
	end)
end

function Rewards.GrantTitle(entry: any, titleId: string)
	local player: Player? = entry.Player
	if not player then
		return
	end
	DataService.Mutate(player, function(p: any)
		p.OwnedTitles[titleId] = true
	end)
end

return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Roster</string>
          <string name="Source"><![CDATA[--!strict
-- Everyone who can take part in a match, players and bots alike, as one
-- Entry type. Owns roles and the visuals that go with them: collision
-- groups, the chaser highlight, the knife, name tags and the cloak.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Groups = require(script.Parent.Groups)
local DataService = require(script.Parent.DataService)
local Status = require(script.Parent.Status)

export type Earned = { Gems: number, Coins: number, XP: number, Lines: { any } }

export type Entry = {
	Id: number,
	Name: string,
	IsBot: boolean,
	Player: Player?,
	Model: Model?,
	Role: string, -- "Lobby" | "Runner" | "Chaser" | "Downed"
	InMatch: boolean,
	IsHero: boolean,
	Chicken: boolean,
	OriginalChaser: boolean,
	-- combat timers (os.clock)
	LastSwing: number,
	LastJuke: number,
	ShieldUntil: number,
	ProtectedUntil: number,
	CloakUntil: number,
	BigDaggerUntil: number,
	GraceUntil: number,
	DownedAt: number,
	DownedBy: any,
	AbilityReady: { [string]: number },
	ItemReadyAt: number,
	-- this match
	Crossings: number,
	Catches: number,
	Ankles: number,
	Rescues: number,
	Earned: Earned,
	BotLoadout: { Runner: string, Chaser: string, Item: string, Knife: string, Title: string }?,
	Bot: any, -- AI state for bots
}

local Roster = {}

local entries: { [number]: Entry } = {}
local byModel: { [Model]: Entry } = {}
local nextBotId = -1

local ROLE_TAG_COLOR = {
	Lobby = Color3.fromRGB(255, 255, 255),
	Runner = Color3.fromRGB(140, 255, 160),
	Chaser = Color3.fromRGB(255, 90, 90),
	Downed = Color3.fromRGB(170, 170, 170),
}

local function newEntry(id: number, name: string, isBot: boolean, player: Player?): Entry
	return {
		Id = id,
		Name = name,
		IsBot = isBot,
		Player = player,
		Model = nil,
		Role = "Lobby",
		InMatch = false,
		IsHero = false,
		Chicken = false,
		OriginalChaser = false,
		LastSwing = -math.huge,
		LastJuke = -math.huge,
		ShieldUntil = 0,
		ProtectedUntil = 0,
		CloakUntil = 0,
		BigDaggerUntil = 0,
		GraceUntil = 0,
		DownedAt = 0,
		DownedBy = nil,
		AbilityReady = {},
		ItemReadyAt = 0,
		Crossings = 0,
		Catches = 0,
		Ankles = 0,
		Rescues = 0,
		Earned = { Gems = 0, Coins = 0, XP = 0, Lines = {} },
		BotLoadout = nil,
		Bot = nil,
	}
end

---------------------------------------------------------------------------
-- Lookups
---------------------------------------------------------------------------
function Roster.ForPlayer(player: Player): Entry?
	return entries[player.UserId]
end

function Roster.FromModel(model: Instance?): Entry?
	if model and model:IsA("Model") then
		return byModel[model]
	end
	return nil
end

function Roster.All(): { Entry }
	local list = {}
	for _, e in entries do
		table.insert(list, e)
	end
	return list
end

function Roster.InMatch(): { Entry }
	local list = {}
	for _, e in entries do
		if e.InMatch then
			table.insert(list, e)
		end
	end
	return list
end

function Roster.WithRole(role: string): { Entry }
	local list = {}
	for _, e in entries do
		if e.InMatch and e.Role == role then
			table.insert(list, e)
		end
	end
	return list
end

function Roster.Root(entry: Entry): BasePart?
	local m = entry.Model
	if m and m.Parent then
		local r = m:FindFirstChild("HumanoidRootPart")
		if r and r:IsA("BasePart") then
			return r
		end
	end
	return nil
end

function Roster.Humanoid(entry: Entry): Humanoid?
	local m = entry.Model
	return if m then m:FindFirstChildOfClass("Humanoid") else nil
end

-- The equipped loadout, live from the profile so shop changes apply at once.
function Roster.Loadout(entry: Entry): { Runner: string, Chaser: string, Item: string, Knife: string, Title: string }
	if entry.Player then
		local p = DataService.Get(entry.Player)
		if p then
			return p.Equipped
		end
	end
	return entry.BotLoadout or {
		Runner = Catalog.StarterRunnerAbility,
		Chaser = Catalog.StarterChaserAbility,
		Item = "",
		Knife = "Classic",
		Title = "Rookie",
	}
end

---------------------------------------------------------------------------
-- Knife
---------------------------------------------------------------------------
local function knifePart(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance, wedge: boolean?): BasePart
	local p: BasePart = if wedge then Instance.new("WedgePart") else Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Massless = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function attach(handle: BasePart, part: BasePart, offset: CFrame)
	part.CFrame = handle.CFrame * offset
	local w = Instance.new("Weld")
	w.Name = "Mount"
	w.Part0 = handle
	w.Part1 = part
	w.C0 = offset
	w.Parent = part
end

-- Blade and tip sizes/offsets (along the knife's +Y) for normal and Big Dagger.
local BLADE = {
	[false] = { Blade = Vector3.new(0.1, 1.9, 0.5), BladeY = 1.62, Tip = Vector3.new(0.1, 0.55, 0.5), TipY = 2.845, Trail = 0.95 },
	[true] = { Blade = Vector3.new(0.16, 3.8, 0.9), BladeY = 2.57, Tip = Vector3.new(0.16, 1.0, 0.9), TipY = 4.97, Trail = 1.9 },
}

local function shapeBlade(knife: Model, big: boolean)
	local spec = BLADE[big]
	local blade = knife:FindFirstChild("Blade") :: BasePart?
	local tip = knife:FindFirstChild("Tip") :: BasePart?
	if not blade or not tip then
		return
	end
	blade.Size = spec.Blade
	tip.Size = spec.Tip;
	(blade:FindFirstChild("Mount") :: Weld).C0 = CFrame.new(0, spec.BladeY, 0);
	(tip:FindFirstChild("Mount") :: Weld).C0 = CFrame.new(0, spec.TipY, 0)
	local top = blade:FindFirstChild("TrailTop") :: Attachment?
	local bottom = blade:FindFirstChild("TrailBottom") :: Attachment?
	if top and bottom then
		top.Position = Vector3.new(0, spec.Trail, 0)
		bottom.Position = Vector3.new(0, -spec.Trail * 0.85, 0)
	end
	knife:SetAttribute("Big", big)
end

local function buildKnife(skinId: string): Model
	local skin = Catalog.Knives[skinId] or Catalog.Knives.Classic
	local m = Instance.new("Model")
	m.Name = "BA_Knife"
	local handle = knifePart("Handle", Vector3.new(0.32, 1.1, 0.32), skin.Handle, Enum.Material.SmoothPlastic, m)
	local guard = knifePart("Guard", Vector3.new(0.75, 0.14, 0.34), Color3.fromRGB(40, 40, 44), Enum.Material.Metal, m)
	local blade = knifePart("Blade", BLADE[false].Blade, skin.Blade, skin.BladeMaterial, m)
	-- A wedge narrows along one edge, which reads as a single-edged tip.
	local tip = knifePart("Tip", BLADE[false].Tip, skin.Blade, skin.BladeMaterial, m, true)
	attach(handle, guard, CFrame.new(0, 0.6, 0))
	attach(handle, blade, CFrame.new(0, BLADE[false].BladeY, 0))
	attach(handle, tip, CFrame.new(0, BLADE[false].TipY, 0))
	if skin.Glow then
		local light = Instance.new("PointLight")
		light.Color = skin.Blade
		light.Range = 6
		light.Brightness = 1.2
		light.Parent = blade
	end
	-- Trail endpoints; clients switch the trail on during a swing.
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailBottom"
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailTop"
	a1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.16
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), skin.Blade)
	trail.Transparency = NumberSequence.new(0.25, 1)
	trail.LightEmission = 0.6
	trail.Enabled = false
	trail.Parent = blade
	m.PrimaryPart = handle
	shapeBlade(m, false)
	return m
end

local function removeKnife(model: Model)
	local k = model:FindFirstChild("BA_Knife")
	if k then
		k:Destroy()
	end
end

local function giveKnife(entry: Entry)
	local model = entry.Model
	if not model then
		return
	end
	removeKnife(model)
	local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local knife = buildKnife(Roster.Loadout(entry).Knife)
	local handle = knife.PrimaryPart :: BasePart
	local isR15 = hand.Name == "RightHand"
	local grip = if isR15 then CFrame.new(0, -0.15, 0) else CFrame.new(0, -0.9, 0)
	-- Point the blade forward out of the fist.
	knife:PivotTo(hand.CFrame * grip * CFrame.Angles(math.rad(-90), 0, 0) * CFrame.new(0, -0.3, 0))
	local w = Instance.new("Weld")
	w.Name = "KnifeGrip"
	w.Part0 = hand
	w.Part1 = handle
	w.C0 = hand.CFrame:ToObjectSpace(handle.CFrame)
	w.Parent = handle
	knife.Parent = model
end

function Roster.RefreshKnife(entry: Entry)
	if entry.Role == "Chaser" then
		giveKnife(entry)
	end
end

function Roster.SetKnifeBig(entry: Entry, big: boolean)
	local model = entry.Model
	local knife = model and model:FindFirstChild("BA_Knife")
	if not knife or not knife:IsA("Model") then
		return
	end
	if knife:GetAttribute("Big") ~= big then
		shapeBlade(knife, big)
	end
end

---------------------------------------------------------------------------
-- Name tag
---------------------------------------------------------------------------
local function buildTag(entry: Entry)
	local model = entry.Model
	if not model then
		return
	end
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local old = head:FindFirstChild("BA_Tag")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "BA_Tag"
	gui.Size = UDim2.fromOffset(220, 64)
	gui.StudsOffset = Vector3.new(0, 2.7, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = head

	local name = Instance.new("TextLabel")
	name.Name = "NameLabel"
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 26)
	name.Position = UDim2.fromOffset(0, 18)
	name.Font = Enum.Font.FredokaOne
	name.TextSize = 22
	name.TextColor3 = ROLE_TAG_COLOR.Lobby
	name.Text = entry.Name
	name.Parent = gui
	local s1 = Instance.new("UIStroke")
	s1.Thickness = 2
	s1.Parent = name

	local title = Instance.new("TextLabel")
	title.Name = "TitleLabel"
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 18)
	title.Position = UDim2.fromOffset(0, 0)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 15
	title.Parent = gui
	local s2 = Instance.new("UIStroke")
	s2.Thickness = 1.5
	s2.Parent = title

	-- Bleed-out bar, driven locally on each client from DownedUntil.
	local bar = Instance.new("Frame")
	bar.Name = "BleedBar"
	bar.Size = UDim2.new(0.5, 0, 0, 7)
	bar.Position = UDim2.new(0.25, 0, 0, 47)
	bar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	bar.BorderSizePixel = 0
	bar.Visible = false
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	Roster.RefreshTag(entry)
end

function Roster.RefreshTag(entry: Entry)
	local model = entry.Model
	local head = model and model:FindFirstChild("Head")
	local gui = head and head:FindFirstChild("BA_Tag")
	if not gui then
		return
	end
	local loadout = Roster.Loadout(entry)
	local t = Catalog.Titles[loadout.Title] or Catalog.Titles.Rookie
	local level = if entry.Player then (entry.Player:GetAttribute("Level") :: number?) or 1 else 1
	local titleLabel = gui:FindFirstChild("TitleLabel") :: TextLabel
	titleLabel.Text = ("%s  •  Lv %d"):format(t.Name, level)
	titleLabel.TextColor3 = t.Color
	local nameLabel = gui:FindFirstChild("NameLabel") :: TextLabel
	nameLabel.TextColor3 = ROLE_TAG_COLOR[entry.Role] or ROLE_TAG_COLOR.Lobby
	local bar = gui:FindFirstChild("BleedBar") :: Frame
	bar.Visible = entry.Role == "Downed"
end

---------------------------------------------------------------------------
-- Highlight and cloak
---------------------------------------------------------------------------
local function setHighlight(model: Model, role: string)
	local existing = model:FindFirstChild("BA_Highlight") :: Highlight?
	if role ~= "Chaser" and role ~= "Downed" then
		if existing then
			existing:Destroy()
		end
		return
	end
	local hl: Highlight
	if existing then
		hl = existing
	else
		hl = Instance.new("Highlight")
		hl.Name = "BA_Highlight"
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = model
	end
	if role == "Chaser" then
		hl.FillColor = Color3.fromRGB(255, 40, 40)
		hl.OutlineColor = Color3.fromRGB(255, 70, 70)
		hl.FillTransparency = 0.78
		hl.OutlineTransparency = 0.1
	else
		hl.FillColor = Color3.fromRGB(120, 120, 120)
		hl.OutlineColor = Color3.fromRGB(220, 220, 220)
		hl.FillTransparency = 0.55
		hl.OutlineTransparency = 0.4
	end
end

function Roster.SetCloak(entry: Entry, on: boolean)
	local model = entry.Model
	if not model then
		return
	end
	if (model:GetAttribute("Cloaked") == true) == on then
		return
	end
	model:SetAttribute("Cloaked", on)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			local v = d :: any
			if on then
				v:SetAttribute("BA_OrigT", v.Transparency)
				v.Transparency = 1
			else
				local orig = v:GetAttribute("BA_OrigT")
				if type(orig) == "number" then
					v.Transparency = orig
					v:SetAttribute("BA_OrigT", nil)
				end
			end
		elseif d:IsA("BillboardGui") and d.Name == "BA_Tag" then
			d.Enabled = not on
		end
	end
	if not on then
		entry.CloakUntil = 0
	end
end

---------------------------------------------------------------------------
-- Roles
---------------------------------------------------------------------------
local function groupFor(entry: Entry, role: string): string
	if role == "Chaser" then
		return Groups.Chasers
	elseif role == "Runner" or role == "Downed" then
		return if entry.IsHero then Groups.Hero else Groups.Runners
	end
	return Groups.Lobby
end

function Roster.SetRole(entry: Entry, role: string)
	local previous = entry.Role
	entry.Role = role
	if entry.Player then
		entry.Player:SetAttribute("Role", role)
	end
	local model = entry.Model
	if not model then
		return
	end
	model:SetAttribute("Role", role)
	Groups.SetModel(model, groupFor(entry, role))
	setHighlight(model, role)
	if role == "Chaser" then
		if previous ~= "Chaser" or not model:FindFirstChild("BA_Knife") then
			giveKnife(entry)
		end
	else
		removeKnife(model)
	end
	if role ~= "Runner" and model:GetAttribute("Cloaked") then
		Roster.SetCloak(entry, false)
	end
	if role == "Downed" then
		model:SetAttribute("DownedUntil", workspace:GetServerTimeNow() + Config.Match.BleedOutTime)
	else
		model:SetAttribute("DownedUntil", nil)
	end
	Roster.RefreshTag(entry)
end

-- Re-apply the collision group (used when a runner starts or ends a Hero run).
function Roster.RefreshGroup(entry: Entry)
	if entry.Model then
		Groups.SetModel(entry.Model, groupFor(entry, entry.Role))
	end
end

function Roster.Place(entry: Entry, cf: CFrame)
	local model = entry.Model
	if model and model.Parent then
		model:PivotTo(cf)
		local root = Roster.Root(entry)
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

function Roster.BeginMatch(entry: Entry)
	entry.InMatch = true
	entry.IsHero = false
	entry.Chicken = false
	entry.OriginalChaser = false
	entry.LastSwing = -math.huge
	entry.LastJuke = -math.huge
	entry.ShieldUntil = 0
	entry.ProtectedUntil = 0
	entry.CloakUntil = 0
	entry.BigDaggerUntil = 0
	entry.GraceUntil = 0
	entry.DownedAt = 0
	entry.DownedBy = nil
	entry.AbilityReady = {}
	entry.ItemReadyAt = 0
	entry.Crossings = 0
	entry.Catches = 0
	entry.Ankles = 0
	entry.Rescues = 0
	entry.Earned = { Gems = 0, Coins = 0, XP = 0, Lines = {} }
	if entry.Player then
		entry.Player:SetAttribute("AbilityReadyAt", 0)
		entry.Player:SetAttribute("ItemReadyAt", 0)
	end
	if entry.Model then
		Status.Clear(entry)
	end
end

function Roster.EndMatch(entry: Entry)
	entry.InMatch = false
	entry.IsHero = false
	if entry.Model then
		Roster.SetCloak(entry, false)
		Status.Clear(entry)
		local prompt = entry.Model:FindFirstChild("RevivePrompt", true)
		if prompt then
			prompt:Destroy()
		end
	end
	Roster.SetRole(entry, "Lobby")
end

---------------------------------------------------------------------------
-- Characters
---------------------------------------------------------------------------
local onCharacter: ((Entry) -> ())? = nil

-- Match.luau hooks this to put respawned participants back in the arena.
function Roster.OnCharacter(fn: (Entry) -> ())
	onCharacter = fn
end

function Roster.SetupModel(entry: Entry, model: Model)
	if entry.Model and byModel[entry.Model] == entry then
		byModel[entry.Model] = nil
	end
	entry.Model = model
	byModel[model] = entry
	CollectionService:AddTag(model, "BA_Character")
	local hum = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 10)
	if hum and hum:IsA("Humanoid") then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.BreakJointsOnDeath = false
		hum.MaxHealth = 1e6
		hum.Health = 1e6
		hum.UseJumpPower = true
		hum.JumpPower = 0
	end
	Groups.Track(model)
	model:WaitForChild("Head", 5)
	buildTag(entry)
	Roster.SetRole(entry, entry.Role)
	model.Destroying:Connect(function()
		if byModel[model] == entry then
			byModel[model] = nil
		end
	end)
	if onCharacter then
		task.spawn(onCharacter :: (Entry) -> (), entry)
	end
end

function Roster.AddBot(name: string, model: Model, loadout: any): Entry
	local id = nextBotId
	nextBotId -= 1
	local entry = newEntry(id, name, true, nil)
	entry.BotLoadout = loadout
	entries[id] = entry
	Roster.SetupModel(entry, model)
	return entry
end

function Roster.Remove(entry: Entry)
	entries[entry.Id] = nil
	if entry.Model then
		byModel[entry.Model] = nil
	end
	entry.InMatch = false
end

function Roster.Start()
	local function added(player: Player)
		local entry = newEntry(player.UserId, player.DisplayName, false, player)
		entries[player.UserId] = entry
		player:SetAttribute("Role", "Lobby")
		player.CharacterAdded:Connect(function(character)
			Roster.SetupModel(entry, character)
		end)
		if player.Character then
			task.spawn(Roster.SetupModel, entry, player.Character)
		end
		-- Title or level changes update the name tag.
		player:GetAttributeChangedSignal("Title"):Connect(function()
			Roster.RefreshTag(entry)
		end)
		player:GetAttributeChangedSignal("Level"):Connect(function()
			Roster.RefreshTag(entry)
		end)
	end
	Players.PlayerAdded:Connect(added)
	for _, p in Players:GetPlayers() do
		added(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		local e = entries[player.UserId]
		if e then
			Roster.Remove(e)
		end
	end)
end

return Roster
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--!strict
-- The shop remote: buying and equipping, codes, map votes and AFK. Also
-- grants Robux gem packs configured in Config.Products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local DataService = require(script.Parent.DataService)
local Match = require(script.Parent.Match)
local Phase = require(script.Parent.Phase)
local Roster = require(script.Parent.Roster)

local Shop = {}

type Result = { Ok: boolean, Message: string }

local function ok(message: string): Result
	return { Ok = true, Message = message }
end

local function fail(message: string): Result
	return { Ok = false, Message = message }
end

local actions: { [string]: (Player, any, any) -> Result } = {}

actions.BuyAbility = function(player, id)
	local def = Catalog.Abilities[id]
	if not def then
		return fail("Unknown ability")
	end
	local p = DataService.Get(player)
	if not p then
		return fail("Still loading your data")
	end
	if p.OwnedAbilities[id] then
		return fail("You already own " .. def.Name)
	end
	if p.Gems < def.Price then
		return fail(("You need %d more gems"):format(def.Price - p.Gems))
	end
	DataService.Mutate(player, function(prof)
		prof.Gems -= def.Price
		prof.OwnedAbilities[id] = true
		prof.Equipped[def.Role] = id
	end)
	return ok("Unlocked " .. def.Name .. "!")
end

actions.EquipAbility = function(player, id)
	local def = Catalog.Abilities[id]
	local p = DataService.Get(player)
	if not def or not p or not p.OwnedAbilities[id] then
		return fail("You don't own that")
	end
	DataService.Mutate(player, function(prof)
		prof.Equipped[def.Role] = id
	end)
	return ok(def.Name .. " equipped")
end

actions.BuyItem = function(player, id)
	local def = Catalog.Items[id]
	local p = DataService.Get(player)
	if not def or not p then
		return fail("Unknown item")
	end
	if p.Coins < def.Price then
		return fail(("You need %d more coins"):format(def.Price - p.Coins))
	end
	DataService.Mutate(player, function(prof)
		prof.Coins -= def.Price
		prof.Items[id] = (prof.Items[id] or 0) + def.Charges
		if prof.Equipped.Item == "" then
			prof.Equipped.Item = id
		end
	end)
	return ok(("+%d %s"):format(def.Charges, def.Name))
end

actions.EquipItem = function(player, id)
	local p = DataService.Get(player)
	if not p then
		return fail("Still loading")
	end
	if id ~= "" and (not Catalog.Items[id] or (p.Items[id] or 0) <= 0) then
		return fail("You don't have any of those")
	end
	DataService.Mutate(player, function(prof)
		prof.Equipped.Item = id
	end)
	return ok(if id == "" then "Item unequipped" else Catalog.Items[id].Name .. " equipped")
end

actions.BuyKnife = function(player, id)
	local def = Catalog.Knives[id]
	local p = DataService.Get(player)
	if not def or not p then
		return fail("Unknown knife")
	end
	if p.OwnedKnives[id] then
		return fail("Already owned")
	end
	if p.Gems < def.Price then
		return fail(("You need %d more gems"):format(def.Price - p.Gems))
	end
	DataService.Mutate(player, function(prof)
		prof.Gems -= def.Price
		prof.OwnedKnives[id] = true
		prof.Equipped.Knife = id
	end)
	local e = Roster.ForPlayer(player)
	if e then
		Roster.RefreshKnife(e)
	end
	return ok(def.Name .. " knife unlocked!")
end

actions.EquipKnife = function(player, id)
	local p = DataService.Get(player)
	if not p or not p.OwnedKnives[id] then
		return fail("You don't own that")
	end
	DataService.Mutate(player, function(prof)
		prof.Equipped.Knife = id
	end)
	local e = Roster.ForPlayer(player)
	if e then
		Roster.RefreshKnife(e)
	end
	return ok(Catalog.Knives[id].Name .. " equipped")
end

actions.EquipTitle = function(player, id)
	local p = DataService.Get(player)
	if not p or not p.OwnedTitles[id] or not Catalog.Titles[id] then
		return fail("You haven't earned that title yet")
	end
	DataService.Mutate(player, function(prof)
		prof.Equipped.Title = id
	end)
	return ok("Title set to " .. Catalog.Titles[id].Name)
end

actions.Redeem = function(player, code)
	if type(code) ~= "string" then
		return fail("Enter a code")
	end
	local key = string.upper((string.gsub(code, "%s+", "")))
	local reward = (Config.Codes :: any)[key]
	if not reward then
		return fail("That code doesn't exist")
	end
	local p = DataService.Get(player)
	if not p then
		return fail("Still loading")
	end
	if p.Redeemed[key] then
		return fail("You already used that code")
	end
	local parts = {}
	DataService.Mutate(player, function(prof)
		prof.Redeemed[key] = true
		if reward.Gems then
			prof.Gems += reward.Gems
			table.insert(parts, reward.Gems .. " gems")
		end
		if reward.Coins then
			prof.Coins += reward.Coins
			table.insert(parts, reward.Coins .. " coins")
		end
		if reward.Boosts then
			local now = os.time()
			for kind, seconds in reward.Boosts do
				prof.Boosts[kind] = math.max(prof.Boosts[kind] or 0, now) + seconds
				table.insert(parts, ("2x %s (%d min)"):format(string.lower(kind), seconds // 60))
			end
		end
		if reward.Title and Catalog.Titles[reward.Title] then
			prof.OwnedTitles[reward.Title] = true
			table.insert(parts, "the " .. Catalog.Titles[reward.Title].Name .. " title")
		end
	end)
	return ok("Redeemed: " .. table.concat(parts, ", "))
end

actions.Vote = function(player, mapId)
	if Phase.Name ~= "Intermission" and Phase.Name ~= "Waiting" then
		return fail("Voting is closed")
	end
	for _, m in Config.Maps do
		if m.Id == mapId then
			Phase.Votes[player] = mapId
			Match.UpdateVotes()
			return ok("Voted for " .. m.Name)
		end
	end
	return fail("Unknown map")
end

actions.SetAFK = function(player, value)
	local afk = value == true
	player:SetAttribute("AFK", afk)
	return ok(if afk then "You'll sit out the next match" else "You're back in")
end

---------------------------------------------------------------------------
-- Robux gem packs
---------------------------------------------------------------------------
local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local product = (Config.Products :: any)[info.ProductId]
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not product or not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = DataService.Get(player)
	if not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(p.Receipts, info.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	DataService.Mutate(player, function(prof)
		prof.Gems += product.Gems or 0
		prof.Coins += product.Coins or 0
		table.insert(prof.Receipts, info.PurchaseId)
		while #prof.Receipts > 50 do
			table.remove(prof.Receipts, 1)
		end
	end)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Shop.Start()
	Net.Function("Shop").OnServerInvoke = function(player, action, a, b)
		local fn = actions[action]
		if type(action) ~= "string" or not fn then
			return fail("Unknown action")
		end
		local success, result = pcall(fn, player, a, b)
		if not success then
			warn("[BreakAnkles] Shop error: " .. tostring(result))
			return fail("Something went wrong")
		end
		return result
	end
	if next(Config.Products) ~= nil then
		MarketplaceService.ProcessReceipt = processReceipt
	end
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Status</string>
          <string name="Source"><![CDATA[--!strict
-- Movement effects on a participant: stuns, slows, boosts and impulses.
-- Players simulate their own characters, so effects are written as
-- attributes (in server time) that the owning client reads every frame, or
-- sent as a Knock event. Bots read the same attributes on the server.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local Knock = Net.Event("Knock")

local Status = {}

-- Bots.luau installs these so impulses reach server-driven characters.
Status.BotImpulse = nil :: ((entry: any, velocity: Vector3, lock: number) -> ())?
Status.BotRocket = nil :: ((entry: any) -> ())?

local function now(): number
	return workspace:GetServerTimeNow()
end

-- kind "Trap" freezes you in place; "Trip" knocks you over.
function Status.Stun(entry: any, duration: number, kind: string)
	local model: Model? = entry.Model
	if not model then
		return
	end
	local untilT = now() + duration
	local current = model:GetAttribute("StunUntil")
	if type(current) == "number" and current > untilT then
		return
	end
	model:SetAttribute("StunUntil", untilT)
	model:SetAttribute("StunKind", kind)
end

function Status.IsStunned(entry: any): boolean
	local model: Model? = entry.Model
	if not model then
		return false
	end
	local t = model:GetAttribute("StunUntil")
	return type(t) == "number" and t > now()
end

function Status.Slow(entry: any, mult: number, duration: number)
	local model: Model? = entry.Model
	if model then
		model:SetAttribute("SlowMult", mult)
		model:SetAttribute("SlowUntil", now() + duration)
	end
end

function Status.Boost(entry: any, mult: number, duration: number)
	local model: Model? = entry.Model
	if model then
		model:SetAttribute("BoostMult", mult)
		model:SetAttribute("BoostUntil", now() + duration)
	end
end

-- Sets the character's velocity outright and ignores input for `lock` seconds.
function Status.Impulse(entry: any, velocity: Vector3, lock: number)
	if entry.Player then
		Knock:FireClient(entry.Player, { Kind = "Impulse", Velocity = velocity, Lock = lock })
	elseif Status.BotImpulse then
		Status.BotImpulse(entry, velocity, lock)
	end
end

-- Rocket Shoes: the owner decides the direction from their input/camera.
function Status.Rocket(entry: any)
	if entry.Player then
		Knock:FireClient(entry.Player, { Kind = "Rocket" })
	elseif Status.BotRocket then
		Status.BotRocket(entry)
	end
end

function Status.Clear(entry: any)
	local model: Model? = entry.Model
	if model then
		for _, name in { "StunUntil", "StunKind", "SlowMult", "SlowUntil", "BoostMult", "BoostUntil", "Channeling" } do
			model:SetAttribute(name, nil)
		end
	end
end

return Status
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="26">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="27">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">45</float>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">20</float>
      <bool name="EnableMouseLockOption">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="28">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Visual and audio effects that every client draws for itself: knife
-- swings, dash trails, shields, airhorns, ankle breaks, gem spin, bleed-out
-- bars, and camera shake.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Sounds = require(script.Parent.Sounds)

local player = Players.LocalPlayer

local Effects = {}

local function rootOf(model: Instance?): BasePart?
	if model and model:IsA("Model") then
		local r = model:FindFirstChild("HumanoidRootPart")
		if r and r:IsA("BasePart") then
			return r
		end
	end
	return nil
end

local function isMe(model: Instance?): boolean
	return model ~= nil and model == player.Character
end

local function localPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = workspace.CurrentCamera
	return p
end

---------------------------------------------------------------------------
-- Camera shake
---------------------------------------------------------------------------
local shakeUntil = 0
local shakePower = 0

function Effects.Shake(power: number, duration: number)
	shakePower = math.max(shakePower, power)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

---------------------------------------------------------------------------
-- Knife swing: tween the shoulder joint locally and light the trail.
---------------------------------------------------------------------------
local originalC0: { [Motor6D]: CFrame } = {}

local function shoulder(model: Model): (Motor6D?, boolean)
	local r15 = model:FindFirstChild("RightUpperArm")
	if r15 then
		local m = r15:FindFirstChild("RightShoulder")
		if m and m:IsA("Motor6D") then
			return m, false
		end
	end
	local torso = model:FindFirstChild("Torso")
	if torso then
		local m = torso:FindFirstChild("Right Shoulder")
		if m and m:IsA("Motor6D") then
			return m, true
		end
	end
	return nil, false
end

local function swingArm(model: Model)
	local motor, r6 = shoulder(model)
	if not motor then
		return
	end
	local base = originalC0[motor]
	if not base then
		base = motor.C0
		originalC0[motor] = base
		motor.Destroying:Connect(function()
			originalC0[motor] = nil
		end)
	end
	local function pose(raise: number, twist: number): CFrame
		if r6 then
			return base * CFrame.Angles(0, 0, math.rad(raise))
		end
		return base * CFrame.Angles(math.rad(raise), 0, math.rad(twist))
	end
	local m = motor :: Motor6D
	local up = TweenService:Create(m, TweenInfo.new(0.06, Enum.EasingStyle.Quad), { C0 = pose(150, -20) })
	local down = TweenService:Create(m, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { C0 = pose(30, 35) })
	local back = TweenService:Create(m, TweenInfo.new(0.22, Enum.EasingStyle.Quad), { C0 = base })
	up:Play()
	up.Completed:Once(function()
		down:Play()
		down.Completed:Once(function()
			back:Play()
		end)
	end)
	local knife = model:FindFirstChild("BA_Knife")
	local blade = knife and knife:FindFirstChild("Blade")
	local trail = blade and blade:FindFirstChild("SwingTrail")
	if trail and trail:IsA("Trail") then
		trail.Enabled = true
		task.delay(0.3, function()
			trail.Enabled = false
		end)
	end
end

function Effects.LocalSwing()
	local char = player.Character
	if char then
		swingArm(char)
		Sounds.Play("Swing", 1 + math.random() * 0.15)
	end
end

---------------------------------------------------------------------------
-- Trails
---------------------------------------------------------------------------
local function dashTrail(model: Model, color: Color3, duration: number)
	local root = rootOf(model)
	if not root then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1.2, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1.6, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.22
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.35, 1)
	trail.LightEmission = 0.5
	trail.FaceCamera = true
	trail.Parent = root
	task.delay(duration, function()
		trail.Enabled = false
	end)
	Debris:AddItem(trail, duration + 0.5)
	Debris:AddItem(a0, duration + 0.5)
	Debris:AddItem(a1, duration + 0.5)
end

local function dust(position: Vector3, color: Color3?)
	local p = localPart({ Size = Vector3.new(0.2, 0.2, 0.2), Position = position, Transparency = 1 })
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color or Color3.fromRGB(220, 210, 190))
	e.Size = NumberSequence.new(1.2, 2.6)
	e.Transparency = NumberSequence.new(0.3, 1)
	e.Lifetime = NumberRange.new(0.4, 0.7)
	e.Speed = NumberRange.new(6, 12)
	e.SpreadAngle = Vector2.new(180, 30)
	e.Drag = 4
	e.Rate = 0
	e.Parent = p
	e:Emit(14)
	Debris:AddItem(p, 1.5)
end

function Effects.LocalDash()
	local char = player.Character
	if char then
		dashTrail(char, Color3.fromRGB(255, 255, 255), 0.25)
		local root = rootOf(char)
		if root then
			dust(root.Position - Vector3.new(0, 2.5, 0))
		end
	end
end

---------------------------------------------------------------------------
-- Pop-up text over a character
---------------------------------------------------------------------------
local function worldText(model: Model, text: string, color: Color3, duration: number)
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(320, 70)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.AlwaysOnTop = true
	gui.Adornee = head
	gui.Parent = player:WaitForChild("PlayerGui")
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = label
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	TweenService:Create(gui, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { StudsOffset = Vector3.new(0, 7, 0) }):Play()
	task.delay(duration * 0.6, function()
		TweenService:Create(label, TweenInfo.new(duration * 0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, TweenInfo.new(duration * 0.4), { Transparency = 1 }):Play()
	end)
	Debris:AddItem(gui, duration + 0.1)
end

---------------------------------------------------------------------------
-- Server effect events
---------------------------------------------------------------------------
local handlers: { [string]: (any) -> () } = {}

handlers.Swing = function(e)
	local model = e.Model
	if not model or isMe(model) then
		return
	end
	swingArm(model)
	local root = rootOf(model)
	if root then
		Sounds.PlayAt("Swing", root.Position, if e.Big then 0.75 else 1)
	end
end

handlers.Dash = function(e)
	if e.Model and not isMe(e.Model) then
		dashTrail(e.Model, Color3.fromRGB(255, 255, 255), 0.25)
		local root = rootOf(e.Model)
		if root then
			dust(root.Position - Vector3.new(0, 2.5, 0))
		end
	end
end

handlers.Down = function(e)
	local root = rootOf(e.Model)
	if root then
		Sounds.PlayAt("Down", root.Position)
		dust(root.Position - Vector3.new(0, 2, 0), Color3.fromRGB(255, 120, 120))
	end
	if isMe(e.By) then
		Effects.Shake(0.25, 0.2)
	end
end

handlers.AnkleBreak = function(e)
	local chaser = e.Chaser
	if chaser then
		worldText(chaser, "ANKLES BROKEN!", Color3.fromRGB(255, 200, 60), 1.8)
		local root = rootOf(chaser)
		if root then
			Sounds.PlayAt("AnkleBreak", root.Position)
			dust(root.Position - Vector3.new(0, 2.5, 0))
		end
	end
	if isMe(chaser) then
		Effects.Shake(0.9, 0.5)
	elseif isMe(e.Runner) then
		Effects.Shake(0.3, 0.25)
	end
end

handlers.Shield = function(e)
	local root = rootOf(e.Model)
	if not root then
		return
	end
	local bubble = localPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(7, 7, 7),
		Material = Enum.Material.ForceField,
		Color = Color3.fromRGB(90, 200, 255),
		CFrame = root.CFrame,
	})
	local follow = RunService.RenderStepped:Connect(function()
		bubble.CFrame = root.CFrame
	end)
	task.delay(e.Duration or 0.75, function()
		follow:Disconnect()
		bubble:Destroy()
	end)
	Sounds.PlayAt("Equip", root.Position, 1.4)
end

handlers.ShieldBreak = function(e)
	local root = rootOf(e.Model)
	if root then
		Sounds.PlayAt("AnkleBreak", root.Position, 1.5)
		dust(root.Position, Color3.fromRGB(90, 200, 255))
	end
end

handlers.Airhorn = function(e)
	local pos: Vector3 = e.Position
	local ring = localPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(pos.X, 0.6, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 220, 70),
		Transparency = 0.2,
	})
	TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad), { Size = Vector3.new(0.4, 34, 34), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.6)
	Sounds.PlayAt("Horn", pos, 1.6)
	local root = rootOf(player.Character)
	if root and (root.Position - pos).Magnitude < 30 then
		Effects.Shake(0.5, 0.35)
	end
end

handlers.Cloak = function(e)
	local root = rootOf(e.Model)
	if root then
		dust(root.Position, Color3.fromRGB(170, 120, 255))
	end
	-- Let the cloaked player still see a ghost of themselves.
	if isMe(e.Model) then
		task.delay(0.15, function()
			local char = player.Character
			if char and char:GetAttribute("Cloaked") then
				for _, d in char:GetDescendants() do
					if (d:IsA("BasePart") or d:IsA("Decal")) and d:GetAttribute("BA_OrigT") ~= nil and d.Name ~= "HumanoidRootPart" then
						d.Transparency = 0.75
					end
				end
			end
		end)
	end
end

handlers.Toss = function(e)
	local root = rootOf(e.Model)
	if root then
		Sounds.PlayAt("Lunge", root.Position, 0.8)
	end
end

handlers.Rocket = function(e)
	if e.Model then
		dashTrail(e.Model, Color3.fromRGB(255, 140, 40), 0.35)
		local root = rootOf(e.Model)
		if root then
			Sounds.PlayAt("Horn", root.Position, 2.2)
		end
	end
end

handlers.Leash = function(e)
	local model = e.Model
	local hand = model and (model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm"))
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = hand
	local target = localPart({ Size = Vector3.new(0.6, 0.6, 0.6), Position = e.To, Transparency = 1 })
	local a1 = Instance.new("Attachment")
	a1.Parent = target
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 0.35
	beam.Width1 = 0.35
	beam.Color = ColorSequence.new(Color3.fromRGB(120, 220, 120))
	beam.LightEmission = 0.4
	beam.FaceCamera = true
	beam.Segments = 8
	beam.CurveSize0 = 2
	beam.Parent = target
	Sounds.PlayAt("Lunge", hand.Position, 1.3)
	Debris:AddItem(target, 0.4)
	Debris:AddItem(a0, 0.4)
end

handlers.Trap = function(e)
	Sounds.PlayAt("Trap", e.Position, 0.8)
	dust(e.Position, Color3.fromRGB(150, 150, 160))
end

handlers.Slip = function(e)
	local root = rootOf(e.Model)
	if root then
		Sounds.PlayAt("Trip", root.Position)
		worldText(e.Model, "WHOA!", Color3.fromRGB(255, 225, 70), 1.0)
	end
end

handlers.GemPickup = function(e)
	if isMe(e.Model) then
		Sounds.Play("Gem", 1.5)
	end
	dust(e.Position, Color3.fromRGB(196, 110, 255))
end

handlers.Door = function(e)
	Sounds.PlayAt("Trap", e.Position, 0.6)
	dust(e.Position - Vector3.new(0, 4, 0))
end

handlers.DoorHit = function(e)
	Sounds.PlayAt("Trap", e.Position, 1.1)
	dust(e.Position, Color3.fromRGB(176, 120, 70))
end

handlers.Revive = function(e)
	local root = rootOf(e.Model)
	if root then
		dust(root.Position, Color3.fromRGB(140, 255, 160))
		Sounds.PlayAt("Safe", root.Position)
	end
end

handlers.Adrenaline = function(e)
	if e.Model then
		dashTrail(e.Model, Color3.fromRGB(80, 230, 160), 5)
	end
end

function Effects.Handle(payload: any)
	local fn = handlers[payload.Kind]
	if fn then
		fn(payload)
	end
end

---------------------------------------------------------------------------
-- Per-frame: gem spin, bleed bars, revive prompt visibility, shake
---------------------------------------------------------------------------
local function eachGem(fn: (BasePart) -> ())
	local arena = workspace:FindFirstChild("Arena")
	local dyn = arena and arena:FindFirstChild("Dynamic")
	if not dyn then
		return
	end
	for _, c in dyn:GetChildren() do
		if c:IsA("BasePart") and c:GetAttribute("Gem") then
			fn(c)
		end
	end
end

function Effects.Start()
	Net.Event("Effect").OnClientEvent:Connect(Effects.Handle)

	local t = 0
	RunService.RenderStepped:Connect(function(dt)
		t += dt
		local spin = CFrame.Angles(0, dt * 2.2, 0)
		eachGem(function(g)
			local cf = g.CFrame
			local bob = math.sin(t * 3 + cf.Position.X) * 0.006
			g.CFrame = (CFrame.new(cf.Position + Vector3.new(0, bob, 0)) * spin) * (cf - cf.Position)
		end)
		local serverNow = workspace:GetServerTimeNow()
		for _, model in CollectionService:GetTagged("BA_Character") do
			if model:GetAttribute("Role") == "Downed" then
				local head = model:FindFirstChild("Head")
				local tag = head and head:FindFirstChild("BA_Tag")
				local bar = tag and tag:FindFirstChild("BleedBar")
				local fill = bar and bar:FindFirstChild("Fill")
				local untilT = model:GetAttribute("DownedUntil")
				if fill and fill:IsA("Frame") and type(untilT) == "number" then
					local frac = math.clamp((untilT - serverNow) / Config.Match.BleedOutTime, 0, 1)
					fill.Size = UDim2.fromScale(frac, 1)
				end
			end
		end
	end)

	-- Only runners see (and can use) revive prompts, and never their own.
	task.spawn(function()
		while true do
			task.wait(0.25)
			local myRole = player:GetAttribute("Role")
			for _, model in CollectionService:GetTagged("BA_Character") do
				local root = model:FindFirstChild("HumanoidRootPart")
				local prompt = root and root:FindFirstChild("RevivePrompt")
				if prompt and prompt:IsA("ProximityPrompt") then
					prompt.Enabled = myRole == "Runner" and model ~= player.Character
				end
			end
		end
	end)

	RunService:BindToRenderStep("BA_Shake", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		if now < shakeUntil then
			local remaining = (shakeUntil - now)
			local p = shakePower * math.min(1, remaining * 4)
			local cam = workspace.CurrentCamera
			cam.CFrame = cam.CFrame * CFrame.Angles(math.rad((math.random() - 0.5) * p * 3), math.rad((math.random() - 0.5) * p * 3), 0)
		else
			shakePower = 0
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--!strict
-- Everything on screen during play: status bar, crossing pips, role badge,
-- big announcements, countdown, feed, popups, the ability/item bar, the
-- downed overlay, map voting, Hero-or-Chicken and the results screen.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arena = require(Shared.Arena)
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Input = require(script.Parent.Input)
local MapPreview = require(script.Parent.MapPreview)
local Movement = require(script.Parent.Movement)
local Sounds = require(script.Parent.Sounds)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local State = Net.State()
local C = UI.Colors

local HUD = {}

HUD.Profile = nil :: any

local gui: ScreenGui
local refs: { [string]: any } = {}

local ROLE_STYLE = {
	Runner = { Text = "RUNNER", Color = C.Runner },
	Chaser = { Text = "CHASER", Color = C.Chaser },
	Downed = { Text = "DOWNED", Color = Color3.fromRGB(170, 170, 170) },
	Lobby = { Text = "LOBBY", Color = Color3.fromRGB(220, 220, 220) },
}

local function role(): string
	return (player:GetAttribute("Role") :: string?) or "Lobby"
end

local function timeLeft(): number
	local endsAt = State:GetAttribute("EndsAt")
	if type(endsAt) ~= "number" or endsAt == 0 then
		return -1
	end
	return math.max(0, endsAt - workspace:GetServerTimeNow())
end

local function fmtTime(t: number): string
	if t < 0 then
		return ""
	end
	local s = math.ceil(t)
	return ("%d:%02d"):format(s // 60, s % 60)
end

---------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------
local function buildTop()
	local top = UI.panel({
		Name = "Top",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(420, 78),
		Parent = gui,
	})
	refs.Phase = UI.text({
		Name = "Phase",
		Text = "WAITING",
		TextSize = 30,
		Size = UDim2.new(1, -110, 0, 36),
		Position = UDim2.fromOffset(16, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})
	refs.Status = UI.text({
		Name = "Status",
		Text = "",
		Font = UI.Body,
		TextSize = 15,
		TextColor3 = C.Muted,
		Size = UDim2.new(1, -110, 0, 20),
		Position = UDim2.fromOffset(16, 44),
		TextXAlignment = Enum.TextXAlignment.Left,
		StrokeThickness = 1,
		Parent = top,
	})
	refs.Timer = UI.text({
		Name = "Timer",
		Text = "",
		TextSize = 34,
		Size = UDim2.fromOffset(100, 40),
		Position = UDim2.new(1, -110, 0, 6),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = top,
	})
	refs.Counts = UI.text({
		Name = "Counts",
		Text = "",
		Font = UI.Body,
		TextSize = 14,
		Size = UDim2.fromOffset(100, 20),
		Position = UDim2.new(1, -110, 0, 46),
		TextXAlignment = Enum.TextXAlignment.Right,
		RichText = true,
		StrokeThickness = 1,
		Parent = top,
	})
	-- Crossing pips under the bar.
	local pips = UI.new("Frame", {
		Name = "Pips",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(200, 26),
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })
	refs.Pips = {}
	for i = 1, Config.Match.CrossingsToWin do
		local pip = UI.new("Frame", {
			Size = UDim2.fromOffset(46, 14),
			BackgroundColor3 = Color3.fromRGB(60, 64, 76),
			LayoutOrder = i,
			Parent = pips,
		}, { UI.corner(7) :: any, UI.borderStroke(2, Color3.new(0, 0, 0), 0.3) })
		refs.Pips[i] = pip
	end
	refs.PipsFrame = pips
	-- Role badge.
	local badge = UI.panel({
		Name = "Role",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 122),
		Size = UDim2.fromOffset(150, 34),
		Color = C.Runner,
		Transparency = 0,
		Radius = 17,
		Parent = gui,
	})
	refs.RoleBadge = badge
	refs.RoleText = UI.text({ Text = "RUNNER", TextSize = 22, Size = UDim2.fromScale(1, 1), Parent = badge })
	refs.Safe = UI.text({
		Name = "Safe",
		Text = "SAFE",
		TextSize = 22,
		TextColor3 = C.Good,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 160),
		Size = UDim2.fromOffset(300, 28),
		Visible = false,
		Parent = gui,
	})
end

