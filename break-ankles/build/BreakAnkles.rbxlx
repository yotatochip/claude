		Parent = panel,
	}, { UI.corner(4) })
	refs.XPFill = UI.new("Frame", { BackgroundColor3 = C.Good, Size = UDim2.fromScale(0, 1), Parent = bar }, { UI.corner(4) })
	refs.Boost = UI.text({
		Text = "",
