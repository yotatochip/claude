      <Item class="ModuleScript" referent="RBX9">
       <Properties>
        <string name="Name">PlayerData</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Saves coins, gems, wins, unlocks and items. Values the client needs to show are mirrored
-- onto Player attributes and leaderstats, so the UI just listens for attribute changes.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

export type Data = {
	Coins: number,
	Gems: number,
	Wins: number,
	Tags: number,
	Crossings: number,
	OwnedAbilities: { [string]: boolean },
	Equipped: { Minnow: string, Shark: string },
	Items: { [string]: number },
	OwnedTrails: { [string]: boolean },
	Trail: string,
	Codes: { [string]: boolean },
}

local PlayerData = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[SvM] DataStores unavailable, progress won't save this session:", result)
	end
end

local cache: { [Player]: Data } = {}
local loaded: { [Player]: boolean } = {}

local function defaultData(): Data
	local owned = {}
	for id, def in Config.Abilities do
		if def.Price == 0 then
			owned[id] = true
		end
	end
	return {
		Coins = 100,
		Gems = 0,
		Wins = 0,
		Tags = 0,
		Crossings = 0,
		OwnedAbilities = owned,
		Equipped = { Minnow = Config.DefaultAbility.Minnow, Shark = Config.DefaultAbility.Shark },
		Items = table.clone(Config.StarterItems),
		OwnedTrails = {},
		Trail = "",
		Codes = {},
	}
end

-- Fill in any fields added since the player last saved.
local function reconcile(saved: any): Data
	local data = defaultData()
	if typeof(saved) ~= "table" then
		return data
	end
	for key, value in saved do
		local current = (data :: any)[key]
		if current ~= nil and typeof(value) == typeof(current) then
			if typeof(value) == "table" then
				for k, v in value do
					current[k] = v
				end
			else
				(data :: any)[key] = value
			end
		end
	end
	return data
end

local function mirror(player: Player, data: Data)
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("Gems", data.Gems)
	player:SetAttribute("EquippedMinnow", data.Equipped.Minnow)
	player:SetAttribute("EquippedShark", data.Equipped.Shark)
	player:SetAttribute("Trail", data.Trail)
	for id in Config.Abilities do
		player:SetAttribute("Owns_" .. id, data.OwnedAbilities[id] == true)
	end
	for id in Config.Items do
		player:SetAttribute("Item_" .. id, data.Items[id] or 0)
	end
	for id in Config.Trails do
		player:SetAttribute("OwnsTrail_" .. id, data.OwnedTrails[id] == true)
	end

	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats:FindFirstChild("Wins") :: IntValue).Value = data.Wins;
		(stats:FindFirstChild("Coins") :: IntValue).Value = data.Coins
	end
end

function PlayerData.Load(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = stats
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = stats
	stats.Parent = player

	local saved = nil
	local readOk = false
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync("p_" .. player.UserId)
			end)
			if ok then
				saved = result
				readOk = true
				break
			end
			warn(`[SvM] Load attempt {attempt} failed for {player.Name}: {result}`)
			if RunService:IsStudio() then
				break -- usually "API access disabled"; don't stall Studio tests
			end
			task.wait(attempt)
		end
	end
	if not player.Parent then
		return
	end

	local data = reconcile(saved)
	cache[player] = data
	-- Only save back what we successfully read, so a failed load never wipes real progress.
	loaded[player] = readOk
	mirror(player, data)
end

function PlayerData.Save(player: Player)
	local data = cache[player]
	if not (store and data and loaded[player]) then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("p_" .. player.UserId, data)
	end)
	if not ok then
		warn(`[SvM] Save failed for {player.Name}: {err}`)
	end
end

function PlayerData.Get(player: Player): Data?
	return cache[player]
end

function PlayerData.Release(player: Player)
	PlayerData.Save(player)
	cache[player] = nil
	loaded[player] = nil
end

-- Apply a change and push the result to attributes/leaderstats.
function PlayerData.Update(player: Player, fn: (Data) -> ())
	local data = cache[player]
	if not data then
		return
	end
	fn(data)
	mirror(player, data)
end

function PlayerData.AddCoins(player: Player, amount: number)
	PlayerData.Update(player, function(d)
		d.Coins += amount
	end)
end

function PlayerData.AddGems(player: Player, amount: number)
	PlayerData.Update(player, function(d)
		d.Gems += amount
	end)
end

function PlayerData.Init()
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(PlayerData.Save, player)
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				PlayerData.Save(player)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 20 do
			task.wait(0.1)
		end
	end)
end

return PlayerData
]]></ProtectedString>
       </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX20">
   <Properties>
    <string name="Name">StarterPlayer</string>
   </Properties>
    <Item class="StarterPlayerScripts" referent="RBX19">
     <Properties>
      <string name="Name">StarterPlayerScripts</string>
     </Properties>
      <Item class="Folder" referent="RBX18">
       <Properties>
        <string name="Name">Client</string>
       </Properties>
        <Item class="LocalScript" referent="RBX12">
         <Properties>
          <string name="Name">Client</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- Client entry point: input, remote events, spectating and UI scaling.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Ui = require(script.Parent:WaitForChild("Ui"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Shop = require(script.Parent:WaitForChild("Shop"))
local Movement = require(script.Parent:WaitForChild("Movement"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- Scale the whole HUD down on small screens (phones, small windows).
local scale = Ui.make("UIScale", { Parent = Hud.Gui })
local function rescale()
	local v = camera.ViewportSize
	scale.Scale = math.clamp(math.min(v.X / 1100, v.Y / 720), 0.55, 1)
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

-- Input ---------------------------------------------------------------------------------------

local function useAbility()
	Remotes.UseAbility:FireServer()
end

local function useItem(id: string)
	Remotes.UseItem:FireServer(id)
end

ContextActionService:BindAction("SvMAbility", function(_, state)
	if state == Enum.UserInputState.Begin then
		useAbility()
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.ButtonX)

for _, id in Config.ItemOrder do
	local def = Config.Items[id]
	local key = ({ ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two, ["3"] = Enum.KeyCode.Three })[def.Key]
	ContextActionService:BindAction("SvMItem" .. id, function(_, state)
		if state == Enum.UserInputState.Begin then
			useItem(id)
		end
		return Enum.ContextActionResult.Sink
	end, false, key)
	Hud.ItemSlots[id].Button.Activated:Connect(function()
		useItem(id)
	end)
end
Hud.AbilitySlot.Button.Activated:Connect(useAbility)

Movement.Start()

local touch = Hud.Touch
if touch.DashL then
	touch.DashL.Activated:Connect(function()
		Movement.Dash(-1)
	end)
	touch.DashR.Activated:Connect(function()
		Movement.Dash(1)
	end)
end

Hud.ShopButton.Activated:Connect(Shop.ToggleShop)
Hud.CodesButton.Activated:Connect(Shop.ToggleCodes)

-- Spectating -----------------------------------------------------------------------------------

local spectating = false
local specIndex = 0

local function inRoundModels(): { Model }
	local out = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p.Character and (p:GetAttribute("Role") == "Minnow" or p:GetAttribute("Role") == "Shark") then
			table.insert(out, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("SvMBots")
	if bots then
		for _, m in bots:GetChildren() do
			if m:IsA("Model") and m:GetAttribute("Role") ~= "Lobby" then
				table.insert(out, m)
			end
		end
	end
	return out
end

local function stopSpectating()
	spectating = false
	Hud.SpectateButton.Text = "👀 SPECTATE"
	local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if h then
		camera.CameraSubject = h
	end
end

local function nextTarget()
	local models = inRoundModels()
	if #models == 0 then
		stopSpectating()
		return
	end
	specIndex = specIndex % #models + 1
	local target = models[specIndex]
	local h = target:FindFirstChildOfClass("Humanoid")
	if h then
		camera.CameraSubject = h
		local name = if h.DisplayName ~= "" then h.DisplayName else target.Name
		Hud.SpectateButton.Text = "👀 " .. name
	end
end

Hud.SpectateButton.Activated:Connect(function()
	Fx.Sound("Click")
	-- first click starts; later clicks cycle; the last one in the list stops
	if not spectating then
		spectating = true
		specIndex = 0
		nextTarget()
	elseif specIndex >= #inRoundModels() then
		stopSpectating()
	else
		nextTarget()
	end
end)

-- Remotes ---------------------------------------------------------------------------------------

Remotes.Notify.OnClientEvent:Connect(function(text: string, color: Color3?)
	Hud.Toast(text, color)
end)

Remotes.Banner.OnClientEvent:Connect(function(title: string, subtitle: string, color: Color3?)
	Hud.Banner(title, subtitle, color)
end)

Remotes.Feed.OnClientEvent:Connect(function(killer: string, victim: string, how: string)
	Hud.Feed(killer, victim, how)
end)

Remotes.Effect.OnClientEvent:Connect(function(kind: string, data: any)
	if kind == "Burst" then
		Fx.Burst(data.Position, data.Color, data.Size)
	elseif kind == "Aura" then
		Fx.Aura(data.Model, data.Color, data.Duration)
	elseif kind == "Chomp" then
		Fx.Chomp(data.Position)
	elseif kind == "Sonar" then
		Fx.Sonar(data.Duration)
	elseif kind == "Inked" then
		Fx.Inked(data.Duration)
		Hud.Toast("🦑 Inked! You can't see!", Color3.fromRGB(190, 140, 255))
	elseif kind == "Go" then
		Fx.Sound("Go")
		Hud.Banner("GO!", "", Color3.fromRGB(120, 255, 160))
	end
end)

-- Close menus when a crossing starts so nobody is stuck behind a window.
ReplicatedStorage:GetAttributeChangedSignal("Phase"):Connect(function()
	local phase = ReplicatedStorage:GetAttribute("Phase")
	local role = player:GetAttribute("Role")
	if phase == "Ready" and role ~= "Lobby" then
		Shop.CloseAll()
	end
	if phase ~= "Ready" and phase ~= "Crossing" and spectating then
		stopSpectating()
	end
end)

player:GetAttributeChangedSignal("Role"):Connect(function()
	if player:GetAttribute("Role") ~= "Lobby" and spectating then
		stopSpectating()
	end
end)

RunService.RenderStepped:Connect(function()
	Hud.Update()
	Hud.SetMomentum(Movement.Momentum, Movement.Sprinting, Movement.DashCharge)
	local phase = ReplicatedStorage:GetAttribute("Phase")
	Hud.SpectateButton.Visible = player:GetAttribute("Role") == "Lobby" and (phase == "Ready" or phase == "Crossing")
end)
]]></ProtectedString>
         </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX13">
         <Properties>
          <string name="Name">Fx</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- Client-only visuals and sounds: bursts, auras, chomps, camera shake, sonar and ink.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Fx = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local folder = Instance.new("Folder")
folder.Name = "SvMClientFx"
folder.Parent = workspace

-- Built-in sounds that ship with every Roblox client.
local SOUNDS = {
	Tick = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5 },
	Go = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.8 },
	Whoosh = { Id = "rbxasset://sounds/swoosh.wav", Volume = 0.5 },
	Chomp = { Id = "rbxasset://sounds/uuhhh.mp3", Volume = 0.6 },
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.4 },
}
local soundCache: { [string]: Sound } = {}

function Fx.Sound(name: string, pitch: number?)
	local def = SOUNDS[name]
	if not def then
		return
	end
	local s = soundCache[name]
	if not s then
		local created = Instance.new("Sound")
		created.SoundId = def.Id
		created.Volume = def.Volume
		created.Parent = SoundService
		soundCache[name] = created
		s = created
	end
	s.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(s)
end

function Fx.Burst(pos: Vector3, color: Color3, size: number)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Material = Enum.Material.Neon
	ball.Color = color
	ball.Transparency = 0.3
	ball.Size = Vector3.one * 1
	ball.Position = pos
	ball.Parent = folder
	local t = math.clamp(size / 30, 0.35, 1.2)
	TweenService:Create(ball, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * size, Transparency = 1 }):Play()
	Debris:AddItem(ball, t + 0.1)
end

function Fx.Aura(model: Instance?, color: Color3, duration: number)
	if not model then
		return
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0.1, 1)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Rate = 40
	emitter.Speed = NumberRange.new(2, 5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = root
	task.delay(duration, function()
		emitter.Enabled = false
		Debris:AddItem(emitter, 1)
	end)
	if model == player.Character then
		Fx.Sound("Whoosh", 1.2)
	end
end

local shakeUntil = 0
local shakeStrength = 0
RunService:BindToRenderStep("SvMShake", Enum.RenderPriority.Camera.Value + 1, function()
	local t = os.clock()
	if t < shakeUntil then
		local k = (shakeUntil - t) * shakeStrength
		camera.CFrame *= CFrame.Angles(math.rad((math.random() - 0.5) * k), math.rad((math.random() - 0.5) * k), 0)
	end
end)

function Fx.Shake(strength: number, duration: number)
	shakeStrength = strength / duration
	shakeUntil = os.clock() + duration
end

function Fx.Chomp(pos: Vector3)
	Fx.Burst(pos, Color3.fromRGB(255, 60, 60), 9)
	-- a little splash of bubbles
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = pos
	p.Parent = folder
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(220, 245, 255))
	e.Size = NumberSequence.new(0.6, 0)
	e.Lifetime = NumberRange.new(0.5, 1)
	e.Speed = NumberRange.new(10, 20)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Acceleration = Vector3.new(0, -30, 0)
	e.Rate = 0
	e.Parent = p
	e:Emit(30)
	Debris:AddItem(p, 1.5)

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and (root.Position - pos).Magnitude < 40 then
		Fx.Sound("Chomp")
		Fx.Shake(6, 0.35)
	end
end

local sonarHighlights: { Highlight } = {}
function Fx.Sonar(duration: number)
	for _, h in sonarHighlights do
		h:Destroy()
	end
	table.clear(sonarHighlights)
	local function mark(model: Model)
		if model:GetAttribute("Role") == "Minnow" then
			local h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(255, 220, 60)
			h.FillTransparency = 0.3
			h.OutlineColor = Color3.new(1, 1, 1)
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Adornee = model
			h.Parent = folder
			table.insert(sonarHighlights, h)
		end
	end
	for _, p in Players:GetPlayers() do
		if p ~= player and p.Character then
			mark(p.Character)
		end
	end
	local bots = workspace:FindFirstChild("SvMBots")
	if bots then
		for _, m in bots:GetChildren() do
			if m:IsA("Model") then
				mark(m)
			end
		end
	end
	Fx.Sound("Tick", 0.6)
	local mine = table.clone(sonarHighlights)
	task.delay(duration, function()
		for _, h in mine do
			h:Destroy()
		end
	end)
end

local inkFrame: Frame? = nil
function Fx.SetInkFrame(frame: Frame)
	inkFrame = frame
end

function Fx.Inked(duration: number)
	local frame = inkFrame
	if not frame then
		return
	end
	frame.Visible = true
	frame.BackgroundTransparency = 0.05
	TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
	task.delay(duration, function()
		if frame.BackgroundTransparency > 0.95 then
			frame.Visible = false
		end
	end)
end

return Fx
]]></ProtectedString>
         </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX14">
         <Properties>
          <string name="Name">Hud</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- The in-game HUD. Everything here is driven by attributes the server sets on
-- ReplicatedStorage (round state) and on the local Player (role, coins, cooldowns).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Ui = require(script.Parent.Ui)
local Fx = require(script.Parent.Fx)

local make = Ui.make
local T = Ui.Theme

local player = Players.LocalPlayer

local Hud = {}

local gui = make("ScreenGui", {
	Name = "SvMHud", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5,
	Parent = player:WaitForChild("PlayerGui"),
})
Hud.Gui = gui

local overlay = make("ScreenGui", {
	Name = "SvMOverlay", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1, Parent = player.PlayerGui,
})
local ink = make("Frame", {
	Name = "Ink", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(25, 10, 40), BackgroundTransparency = 1, Visible = false, Parent = overlay,
})
Fx.SetInkFrame(ink)

-- Status bar ------------------------------------------------------------------------------------

local status = make("Frame", {
	Name = "Status", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(380, 70),
	BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, Parent = gui,
}, { Ui.corner(16), Ui.stroke(3) })
local phaseLabel = Ui.label({ Name = "Phase", Position = UDim2.fromOffset(16, 6), Size = UDim2.new(1, -120, 0, 32), TextXAlignment = Enum.TextXAlignment.Left, Text = "WAITING", Parent = status })
local timerLabel = Ui.label({ Name = "Timer", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 4), Size = UDim2.fromOffset(100, 36), TextXAlignment = Enum.TextXAlignment.Right, Text = "", TextColor3 = Color3.fromRGB(255, 230, 120), Parent = status })
local countsLabel = Ui.label({ Name = "Counts", Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Text = "", TextColor3 = T.Muted, Font = Ui.BodyFont, StrokeThickness = 1, Parent = status })

local roleChip = make("Frame", {
	Name = "Role", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 82), Size = UDim2.fromOffset(240, 32),
	BackgroundColor3 = T.PanelLight, Parent = gui,
}, { Ui.corner(16), Ui.stroke(2.5) })
local roleLabel = Ui.label({ Size = UDim2.fromScale(1, 1), Text = "IN THE LOBBY", Parent = roleChip, StrokeThickness = 1.5 })
make("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = roleChip })

local directionLabel = Ui.label({
	Name = "Direction", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(420, 34),
	Text = "", TextColor3 = Color3.fromRGB(140, 255, 180), StrokeThickness = 2.5, Parent = gui,
})

local countdown = Ui.label({
	Name = "Countdown", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.38), Size = UDim2.fromOffset(300, 140),
	Text = "", StrokeThickness = 5, Parent = gui,
})

-- Currency + menu buttons ------------------------------------------------------------------------

local leftColumn = make("Frame", {
	Name = "Left", Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(170, 300), BackgroundTransparency = 1, Parent = gui,
}, { make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })

local function pill(order: number, icon: string, color: Color3): TextLabel
	local f = make("Frame", { LayoutOrder = order, Size = UDim2.fromOffset(160, 38), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.1, Parent = leftColumn }, { Ui.corner(19), Ui.stroke(2.5) })
	Ui.label({ Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(30, 30), Text = icon, Parent = f })
	return Ui.label({ Position = UDim2.fromOffset(42, 5), Size = UDim2.new(1, -54, 0, 28), Text = "0", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, Parent = f })
end
local coinsLabel = pill(1, "🪙", Config.Colors.Coins)
local gemsLabel = pill(2, "💎", Config.Colors.Gems)

Hud.ShopButton = Ui.button({ LayoutOrder = 3, Size = UDim2.fromOffset(160, 44), Text = "🛒 SHOP", Parent = leftColumn }, Color3.fromRGB(255, 170, 40))
Hud.CodesButton = Ui.button({ LayoutOrder = 4, Size = UDim2.fromOffset(160, 40), Text = "🎁 CODES", Parent = leftColumn }, Color3.fromRGB(150, 90, 230))
Hud.SpectateButton = Ui.button({ LayoutOrder = 5, Size = UDim2.fromOffset(160, 40), Text = "👀 SPECTATE", Visible = false, Parent = leftColumn }, Color3.fromRGB(60, 150, 230))

-- Ability + item bar -------------------------------------------------------------------------------

local bar = make("Frame", {
	Name = "Abilities", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(340, 100),
	BackgroundTransparency = 1, Parent = gui,
}, {
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

type Slot = { Button: TextButton, Icon: TextLabel, Name: TextLabel, Key: TextLabel, Count: TextLabel?, Cooldown: Frame, CooldownText: TextLabel }

local function slot(order: number, size: number, key: string, withCount: boolean): Slot
	local b = make("TextButton", {
		LayoutOrder = order, Size = UDim2.fromOffset(size, size), BackgroundColor3 = T.Panel, AutoButtonColor = true, Text = "", Parent = bar,
	}, { Ui.corner(14), Ui.stroke(3) })
	local icon = Ui.label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromScale(0.55, 0.5), Text = "", Parent = b })
	local name = Ui.label({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 14), Text = "", Font = Ui.BodyFont, StrokeThickness = 1, Parent = b })
	local keyChip = make("Frame", { Position = UDim2.fromOffset(-6, -6), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = Color3.fromRGB(250, 250, 250), ZIndex = 3, Parent = b }, { Ui.corner(6), Ui.stroke(2) })
	local keyLabel = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Ui.Font, TextScaled = true, TextColor3 = T.Stroke, Text = key, ZIndex = 3, Parent = keyChip })
	local count = nil
	if withCount then
		count = Ui.label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 2), Size = UDim2.fromOffset(30, 18), Text = "0", TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3, Parent = b })
	end
	local cd = make("Frame", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35, ZIndex = 2, Parent = b,
	}, { Ui.corner(14) })
	local cdText = Ui.label({ Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 4, Parent = b })
	return { Button = b, Icon = icon, Name = name, Key = keyLabel, Count = count, Cooldown = cd, CooldownText = cdText }
end

Hud.AbilitySlot = slot(1, 96, "Q", false)
Hud.ItemSlots = {} :: { [string]: Slot }
for i, id in Config.ItemOrder do
	local def = Config.Items[id]
	local s = slot(i + 1, 70, def.Key, true)
	s.Icon.Text = def.Icon
	s.Name.Text = def.Name
	s.Button.BackgroundColor3 = T.Panel
	Hud.ItemSlots[id] = s
end

-- Momentum / dash ---------------------------------------------------------------------------------------

local momentumFrame = make("Frame", {
	Name = "Momentum", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -124), Size = UDim2.fromOffset(320, 16),
	BackgroundColor3 = T.Panel, BackgroundTransparency = 0.15, Parent = gui,
}, { Ui.corner(8), Ui.stroke(2.5) })
local momentumFill = make("Frame", {
	Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(110, 230, 255), Parent = momentumFrame,
}, { Ui.corner(8), Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)) })
local momentumText = Ui.label({
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -2), Size = UDim2.fromOffset(260, 16),
	Text = "MOMENTUM", Font = Ui.BodyFont, StrokeThickness = 1, Parent = momentumFrame,
})

-- Before the sprint the bar shows momentum building; once sprinting it shows the dash charging.
function Hud.SetMomentum(momentum: number, sprinting: boolean, dashCharge: number)
	if sprinting then
		local ready = dashCharge >= 1
		momentumFill.Size = UDim2.fromScale(math.clamp(dashCharge, 0, 1), 1)
		momentumFill.BackgroundColor3 = if ready then Color3.fromRGB(120, 255, 160) else Color3.fromRGB(255, 210, 80)
		momentumText.Text = if ready then "SPRINTING · DASH READY (Space + A/D)" else "SPRINTING · DASH CHARGING"
	else
		momentumFill.Size = UDim2.fromScale(math.clamp(momentum, 0, 1), 1)
		momentumFill.BackgroundColor3 = Color3.fromRGB(110, 230, 255)
		momentumText.Text = "MOMENTUM"
	end
end

Ui.label({
	Name = "Keys", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -10), Size = UDim2.fromOffset(560, 18),
	TextXAlignment = Enum.TextXAlignment.Left, Font = Ui.BodyFont, StrokeThickness = 1, TextColor3 = T.Muted,
	Text = "Keep running to sprint · Space+A/D dash while sprinting · hold S to brake · Ctrl shift lock · Q ability",
	Visible = not UserInputService.TouchEnabled, Parent = gui,
})

-- Dash buttons for phones and tablets.
Hud.Touch = {} :: { [string]: TextButton }
if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
	local pad = make("Frame", {
		Name = "TouchMoves", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -150, 1, -60), Size = UDim2.fromOffset(150, 62),
		BackgroundTransparency = 1, Parent = gui,
	}, {
		make("UIGridLayout", { CellSize = UDim2.fromOffset(70, 62), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, info in { { "DashL", "◀ DASH" }, { "DashR", "DASH ▶" } } do
		Hud.Touch[info[1]] = Ui.button({ LayoutOrder = i, Text = info[2], BackgroundTransparency = 0.15, Parent = pad }, T.PanelLight)
	end
end

-- Banner, toasts, feed ---------------------------------------------------------------------------

local bannerFrame = make("Frame", {
	Name = "Banner", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(640, 120),
	BackgroundTransparency = 1, Visible = false, Parent = gui,
})
local bannerTitle = Ui.label({ Size = UDim2.new(1, 0, 0, 70), Text = "", StrokeThickness = 4, Parent = bannerFrame })
local bannerSub = Ui.label({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 30), Text = "", Font = Ui.BodyFont, StrokeThickness = 2, Parent = bannerFrame })
local bannerToken = 0

function Hud.Banner(title: string, subtitle: string, color: Color3?)
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color or T.Text
	bannerSub.Text = subtitle
	bannerFrame.Visible = true
	bannerFrame.Size = UDim2.fromOffset(500, 90)
	TweenService:Create(bannerFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(640, 120) }):Play()
	task.delay(3.5, function()
		if bannerToken == token then
			bannerFrame.Visible = false
		end
	end)
end

local toasts = make("Frame", {
	Name = "Toasts", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -130), Size = UDim2.fromOffset(330, 260),
	BackgroundTransparency = 1, Parent = gui,
}, {
	make("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local toastOrder = 0

function Hud.Toast(text: string, color: Color3?)
	toastOrder += 1
	local f = make("Frame", {
		LayoutOrder = toastOrder, Size = UDim2.fromOffset(320, 34), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.15, Parent = toasts,
	}, { Ui.corner(10), Ui.stroke(2) })
	local l = Ui.label({ Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -20, 1, -10), Text = text, TextColor3 = color or T.Text, TextXAlignment = Enum.TextXAlignment.Right, Font = Ui.BodyFont, StrokeThickness = 1, Parent = f })
	local kids = toasts:GetChildren()
	local frames = 0
	for _, k in kids do
		if k:IsA("Frame") then
			frames += 1
		end
	end
	if frames > 6 then
		for _, k in kids do
			if k:IsA("Frame") and k ~= f then
				k:Destroy()
				break
			end
		end
	end
	task.delay(3.5, function()
		if f.Parent then
			TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			task.wait(0.4)
			f:Destroy()
		end
	end)
end

local feed = make("Frame", {
	Name = "Feed", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 8), Size = UDim2.fromOffset(300, 200),
	BackgroundTransparency = 1, Parent = gui,
}, { make("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
local feedOrder = 0

function Hud.Feed(killer: string, victim: string, how: string)
	feedOrder += 1
	local text = if how == "timeout" then `⏱️ {victim} was too slow` else `🦈 {killer}  chomped  🐟 {victim}`
	local f = make("Frame", { LayoutOrder = feedOrder, Size = UDim2.fromOffset(300, 28), BackgroundColor3 = Color3.fromRGB(60, 20, 30), BackgroundTransparency = 0.25, Parent = feed }, { Ui.corner(8) })
	Ui.label({ Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 1, -8), Text = text, TextXAlignment = Enum.TextXAlignment.Right, Font = Ui.BodyFont, StrokeThickness = 1, Parent = f })
	local frames = {}
	for _, k in feed:GetChildren() do
		if k:IsA("Frame") then
			table.insert(frames, k)
		end
	end
	if #frames > 5 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
	task.delay(6, function()
		if f.Parent then
			f:Destroy()
		end
	end)
end

-- Per-frame refresh --------------------------------------------------------------------------------

local PHASE_TEXT = {
	Waiting = "WAITING",
	Intermission = "INTERMISSION",
	Ready = "GET READY",
	Crossing = "SWIM!",
	Ended = "ROUND OVER",
}

local lastCount = -1

local function setCooldown(s: Slot, readyAt: number, total: number, t: number)
	local left = readyAt - t
	if left > 0 and total > 0 then
		s.Cooldown.Size = UDim2.fromScale(1, math.clamp(left / total, 0, 1))
		s.CooldownText.Text = tostring(math.ceil(left))
	else
		s.Cooldown.Size = UDim2.fromScale(1, 0)
		s.CooldownText.Text = ""
	end
end

function Hud.Update()
	local t = workspace:GetServerTimeNow()
	local phase = ReplicatedStorage:GetAttribute("Phase") or "Waiting"
	local endsAt = ReplicatedStorage:GetAttribute("PhaseEndsAt") or 0
	local crossing = ReplicatedStorage:GetAttribute("Crossing") or 0
	local maxCrossings = ReplicatedStorage:GetAttribute("MaxCrossings") or Config.MaxCrossings
	local direction = ReplicatedStorage:GetAttribute("Direction") or 1
	local role = player:GetAttribute("Role") or "Lobby"
	local left = math.max(0, endsAt - t)

	phaseLabel.Text = if phase == "Waiting" then (ReplicatedStorage:GetAttribute("Status") or "WAITING") else PHASE_TEXT[phase] or phase
	timerLabel.Text = if endsAt > 0 and phase ~= "Waiting" then Ui.formatTime(left) else ""
	if phase == "Ready" or phase == "Crossing" then
		countsLabel.Text = `🐟 {ReplicatedStorage:GetAttribute("MinnowsLeft") or 0} minnows   🦈 {ReplicatedStorage:GetAttribute("SharksCount") or 0} sharks   ·   crossing {crossing}/{maxCrossings}`
	elseif phase == "Intermission" then
		countsLabel.Text = "Shop up while you wait!"
	else
		countsLabel.Text = ReplicatedStorage:GetAttribute("Status") or ""
	end
	timerLabel.TextColor3 = if phase == "Crossing" and left < 5 then T.Bad else Color3.fromRGB(255, 230, 120)

	-- role chip
	if role == "Shark" then
		roleLabel.Text = "🦈 YOU'RE A SHARK"
		roleChip.BackgroundColor3 = Color3.fromRGB(150, 40, 50)
	elseif role == "Minnow" then
		roleLabel.Text = "🐟 YOU'RE A MINNOW"
		roleChip.BackgroundColor3 = Color3.fromRGB(220, 120, 30)
	else
		roleLabel.Text = if phase == "Ready" or phase == "Crossing" then "WATCHING · NEXT ROUND SOON" else "IN THE LOBBY"
		roleChip.BackgroundColor3 = T.PanelLight
	end

	-- where to go
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local safe = root ~= nil and root.Position.X * direction > Config.SafeLine
	if role == "Minnow" and (phase == "Ready" or phase == "Crossing") then
		if phase == "Crossing" and safe then
			directionLabel.Text = "✅ SAFE — hang tight"
		else
			directionLabel.Text = if direction > 0 then "SWIM TO THE EAST BEACH  ➜" else "⬅  SWIM TO THE WEST BEACH"
		end
	elseif role == "Shark" and phase == "Crossing" then
		directionLabel.Text = "CHOMP THE MINNOWS!"
	elseif role == "Shark" and phase == "Ready" then
		directionLabel.Text = "Get ready to hunt…"
	else
		directionLabel.Text = ""
	end

	-- big countdown in the last 3 seconds of Ready
	if phase == "Ready" and left <= 3.2 then
		local n = math.ceil(left)
		countdown.Text = tostring(n)
		if n ~= lastCount and n > 0 then
			lastCount = n
			Fx.Sound("Tick")
		end
	else
		countdown.Text = ""
		lastCount = -1
	end

	-- currency
	coinsLabel.Text = Ui.formatNumber(player:GetAttribute("Coins") or 0)
	gemsLabel.Text = Ui.formatNumber(player:GetAttribute("Gems") or 0)

	-- ability slot
	local active = phase == "Crossing" and role ~= "Lobby"
	local abilityId = if role == "Shark" then player:GetAttribute("EquippedShark") else player:GetAttribute("EquippedMinnow")
	local def = Config.Abilities[abilityId or ""]
	local a = Hud.AbilitySlot
	a.Icon.Text = if def then def.Icon else "?"
	a.Name.Text = if def then def.Name else ""
	a.Button.BackgroundColor3 = if def and role ~= "Lobby" then def.Color:Lerp(T.Panel, 0.55) else T.Panel
	setCooldown(a, player:GetAttribute("AbilityReadyAt") or 0, if def then def.Cooldown else 1, t)
	a.Button.BackgroundTransparency = if active then 0 else 0.45

	for id, s in Hud.ItemSlots do
		local item = Config.Items[id]
		local count = player:GetAttribute("Item_" .. id) or 0
		local usable = active and count > 0 and (item.Role == "Any" or item.Role == role)
		if s.Count then
			s.Count.Text = "x" .. count
		end
		s.Button.BackgroundTransparency = if usable then 0 else 0.5
		s.Button.BackgroundColor3 = if usable then item.Color:Lerp(T.Panel, 0.6) else T.Panel
		setCooldown(s, player:GetAttribute("ItemReadyAt") or 0, Config.ItemCooldown, t)
	end
end

return Hud
]]></ProtectedString>
         </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX15">
         <Properties>
          <string name="Name">Movement</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- Huss Valley-style movement for the local character.
--
--   WASD            run. Keep running in one direction and momentum builds until you break
--                   into a sprint on your own (no sprint key), with the sprint animation.
--   Space + A / D   dash sideways. The dash only charges while you're sprinting.
--   Let go          you keep gliding on your momentum for a moment.
--   Hold S          brake: pulling back against your momentum stops you fast.
--   Left Ctrl       toggle shift lock.
--
-- There is no jumping. The server sends a base speed (player attribute "MoveSpeed") that already
-- includes ability boosts, slows, nets and the pre-crossing freeze; this builds on top of it.
-- The default control script still reads the keys; this overrides what the humanoid is told.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Fx = require(script.Parent.Fx)

local M = Config.Movement
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local controls: any = nil
task.spawn(function()
	local ok, module = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
	end)
	if ok and module then
		controls = module:GetControls()
	end
end)

local Movement = {}

Movement.Momentum = 0 -- 0..1; at 1 you're sprinting
Movement.Sprinting = false
Movement.DashCharge = 0 -- 0..1; fills while sprinting
Movement.ShiftLock = false

local velocity = Vector3.zero -- the horizontal velocity we're steering the humanoid with
local lastBase = Config.MinnowSpeed
local nextDash = 0
local keepMomentumUntil = 0 -- a dash doesn't cost you your sprint
local sprintTrack: AnimationTrack? = nil

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function unitOr(v: Vector3, fallback: Vector3): Vector3
	return if v.Magnitude > 1e-3 then v.Unit else fallback
end

local function moveToward(current: Vector3, target: Vector3, step: number): Vector3
	local delta = target - current
	local d = delta.Magnitude
	if d <= step or d < 1e-4 then
		return target
	end
	return current + delta / d * step
end

local function character(): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	local h = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not h or h.Health <= 0 or not root then
		return char, nil, nil
	end
	return char, h, root
end

-- Raw stick / WASD input: X = right, Y = forward.
local function rawInput(): Vector2
	if controls then
		local mv: Vector3 = controls:GetMoveVector()
		return Vector2.new(mv.X, -mv.Z)
	end
	return Vector2.zero
end

local function cameraAxes(): (Vector3, Vector3)
	local cf = camera.CFrame
	local forward = unitOr(flat(cf.LookVector), Vector3.new(0, 0, -1))
	local right = unitOr(flat(cf.RightVector), Vector3.new(1, 0, 0))
	return forward, right
end

local function baseSpeed(): number
	return player:GetAttribute("MoveSpeed") or Config.LobbySpeed
end

local function rooted(): boolean
	return player:GetAttribute("Rooted") == true
end

-- Sprint animation ------------------------------------------------------------------------------

local function loadSprintAnimation(char: Model)
	sprintTrack = nil
	local h = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not h then
		return
	end
	local animator = h:WaitForChild("Animator", 10) :: Animator?
	if not animator then
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = M.SprintAnimation
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Movement -- above the default run cycle
		track.Looped = true
		sprintTrack = track
	end
end

local function updateAnimation(speed: number)
	local track = sprintTrack
	if not track then
		return
	end
	if Movement.Sprinting then
		if not track.IsPlaying then
			track:Play(0.25)
		end
		track:AdjustSpeed(math.clamp(speed / (lastBase * M.SprintMultiplier), 0.8, 1.4))
	elseif track.IsPlaying then
		track:Stop(0.25)
	end
end

-- Dash ------------------------------------------------------------------------------------------

function Movement.Dash(side: number)
	local _, h, root = character()
	if not h or not root or rooted() or os.clock() < nextDash then
		return
	end
	if Movement.DashCharge < 1 then
		return -- only a full sprint charges the dash
	end
	Movement.DashCharge = 0
	nextDash = os.clock() + M.DashCooldown
	keepMomentumUntil = os.clock() + 0.5
	local _, right = cameraAxes()
	if Movement.ShiftLock then
		right = unitOr(flat(root.CFrame.RightVector), right)
	end
	-- keep forward momentum, replace sideways momentum with the burst
	local along = velocity - right * velocity:Dot(right)
	velocity = along + right * side * M.DashSpeed
	Fx.Sound("Whoosh", 1.35)
end

function Movement.ToggleShiftLock()
	Movement.ShiftLock = not Movement.ShiftLock
	if not Movement.ShiftLock then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	Fx.Sound("Click")
end

-- Per-frame controller -----------------------------------------------------------------------

local function step(dt: number)
	local _, h, root = character()
	if not h or not root then
		velocity = Vector3.zero
		Movement.Momentum = 0
		Movement.Sprinting = false
		return
	end
	local t = os.clock()
	local base = baseSpeed()
	local held = rooted() or base <= 0

	-- Ability boosts (Dart, Lunge, Riptide…) arrive as a jump in base speed: snap to them
	-- so a burst feels like a burst instead of slowly accelerating into it.
	if base - lastBase > 10 then
		local dir = unitOr(flat(velocity), flat(root.CFrame.LookVector))
		velocity = dir * math.max(base, velocity.Magnitude)
	end
	lastBase = base

	local input = rawInput()
	local forward, right = cameraAxes()
	local wish = right * input.X + forward * input.Y
	if wish.Magnitude > 1 then
		wish = wish.Unit
	end
	local pushing = wish.Magnitude > 0.1
	local speedNow = velocity.Magnitude
	local alignment = if pushing and speedNow > 0.5 then wish.Unit:Dot(velocity / speedNow) else 0
	local braking = pushing and speedNow > 2 and alignment < -0.3

	-- Momentum: running steadily one way at full jog builds it; turning hard, braking or
	-- letting go bleeds it away. Full momentum = sprint.
	if held then
		Movement.Momentum = 0
	elseif pushing and alignment > 0.75 and speedNow >= base * 0.9 then
		Movement.Momentum = math.min(1, Movement.Momentum + dt / M.SprintBuildTime)
	elseif t > keepMomentumUntil then
		local loss = if braking then 4 elseif pushing then M.MomentumLoss else M.MomentumLoss * 1.5
		Movement.Momentum = math.max(0, Movement.Momentum - loss * dt)
	end
	if Movement.Sprinting then
		Movement.Sprinting = Movement.Momentum > 0.6 and not held
	else
		Movement.Sprinting = Movement.Momentum >= 1
	end

	-- The dash charges while you sprint, and drains away if you stop sprinting.
	if Movement.Sprinting then
		Movement.DashCharge = math.min(1, Movement.DashCharge + dt / M.DashChargeTime)
	else
		Movement.DashCharge = math.max(0, Movement.DashCharge - dt / M.DashChargeTime * 0.5)
	end

	if held then
		velocity = Vector3.zero
	else
		local top = base * (1 + (M.SprintMultiplier - 1) * (if Movement.Sprinting then 1 else Movement.Momentum * 0.3))
		local target = wish * top
		local rate
		if braking then
			rate = M.Brake
		elseif not pushing then
			rate = M.Glide
		elseif velocity.Magnitude > top + 1 then
			rate = M.Glide -- easing back down after a dash or ability burst
		elseif Movement.Sprinting and velocity.Magnitude > base then
			rate = M.SprintAccel
		else
			rate = M.Accel
		end
		velocity = moveToward(velocity, target, rate * dt)
	end

	local speed = velocity.Magnitude
	h.WalkSpeed = speed
	h:Move(if speed > 0.05 then velocity / speed else Vector3.zero, false)
	-- no jumping in Sharks Vs Minnows
	if h.UseJumpPower then
		h.UseJumpPower = false
	end
	if h.JumpHeight ~= 0 then
		h.JumpHeight = 0
	end

	local wantLock = Movement.ShiftLock and not UserInputService.TouchEnabled
	h.AutoRotate = not wantLock
	h.CameraOffset = Vector3.new(if wantLock then M.ShiftLockOffset else 0, 0, 0)

	updateAnimation(speed)

	-- FOV opens up as you hit full sprint
	local fov = M.FovBase + (M.FovSprint - M.FovBase) * (if Movement.Sprinting then 1 else 0)
	camera.FieldOfView += (fov - camera.FieldOfView) * math.min(1, dt * 5)
end

-- Shift lock runs after the camera has updated: lock the mouse to the center and turn the
-- body to face where the camera looks (the over-the-shoulder offset is set in step()).
local function shiftLockStep()
	if not Movement.ShiftLock or UserInputService.TouchEnabled then
		return
	end
	local _, h, root = character()
	if not h or not root then
		return
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	local look = unitOr(flat(camera.CFrame.LookVector), flat(root.CFrame.LookVector))
	root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
end

-- Input -------------------------------------------------------------------------------------------

function Movement.Start()
	RunService:BindToRenderStep("SvMMovement", Enum.RenderPriority.Input.Value + 1, step)
	RunService:BindToRenderStep("SvMShiftLock", Enum.RenderPriority.Camera.Value + 2, shiftLockStep)

	-- Space only dashes (with A or D held). It never jumps.
	ContextActionService:BindActionAtPriority("SvMDash", function(_, state)
		if state == Enum.UserInputState.Begin then
			local x = rawInput().X
			if math.abs(x) > 0.5 then
				Movement.Dash(math.sign(x))
			end
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)

	ContextActionService:BindActionAtPriority("SvMShiftLock", function(_, state)
		if state == Enum.UserInputState.Begin then
			Movement.ToggleShiftLock()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftControl)

	-- Gamepad bumpers dash too.
	ContextActionService:BindActionAtPriority("SvMPadDash", function(_, state, input)
		if state == Enum.UserInputState.Begin then
			Movement.Dash(if input.KeyCode == Enum.KeyCode.ButtonL1 then -1 else 1)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1)

	local function onCharacter(char: Model)
		velocity = Vector3.zero
		Movement.Momentum = 0
		Movement.DashCharge = 0
		Movement.Sprinting = false
		task.spawn(loadSprintAnimation, char)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
end

return Movement
]]></ProtectedString>
         </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX16">
         <Properties>
          <string name="Name">Shop</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- Shop (abilities, consumables, trails) and the codes window.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Ui = require(script.Parent.Ui)
local Fx = require(script.Parent.Fx)
local Hud = require(script.Parent.Hud)

local make = Ui.make
local T = Ui.Theme
local player = Players.LocalPlayer

local Shop = {}

local function window(name: string, size: Vector2, title: string): (Frame, Frame)
	local frame = make("Frame", {
		Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = T.Panel, Visible = false, ZIndex = 10, Parent = Hud.Gui,
	}, {
		Ui.corner(18), Ui.stroke(4), Ui.gradient(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 190, 210)),
		make("UISizeConstraint", { MaxSize = Vector2.new(size.X, size.Y) }),
	})
	Ui.label({ Position = UDim2.fromOffset(20, 10), Size = UDim2.new(1, -90, 0, 40), Text = title, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, StrokeThickness = 3, Parent = frame })
	local close = Ui.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(42, 42), Text = "X", ZIndex = 11, Parent = frame }, T.Bad)
	close.Activated:Connect(function()
		Fx.Sound("Click")
		frame.Visible = false
	end)
	local body = make("Frame", { Name = "Body", Position = UDim2.fromOffset(16, 62), Size = UDim2.new(1, -32, 1, -78), BackgroundTransparency = 1, ZIndex = 11, Parent = frame })
	return frame, body
end

local function pop(frame: GuiObject)
	local final = frame.Size
	frame.Size = UDim2.new(final.X.Scale * 0.9, final.X.Offset * 0.9, final.Y.Scale * 0.9, final.Y.Offset * 0.9)
	TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = final }):Play()
end

-- Shop ------------------------------------------------------------------------------------------------

local shopFrame, shopBody = window("Shop", Vector2.new(660, 460), "🛒 SHOP")
local tabs = make("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, ZIndex = 11, Parent = shopBody }, {
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local list = make("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50), BackgroundTransparency = 1, BorderSizePixel = 0,
	ScrollBarThickness = 8, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 11, Parent = shopBody,
}, {
	make("UIGridLayout", { CellSize = UDim2.fromOffset(195, 200), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	make("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }),
})

local currentTab = "Abilities"
local tabButtons: { [string]: TextButton } = {}

local function buy(action: string, id: string)
	Fx.Sound("Click")
	local ok, message = Remotes.Shop:InvokeServer(action, id)
	Hud.Toast(message, if ok then T.Good else T.Bad)
end

type CardInfo = { Icon: string, Name: string, Tag: string?, TagColor: Color3?, Desc: string, Color: Color3, ButtonText: string, ButtonColor: Color3, Enabled: boolean, OnClick: () -> () }

local function card(order: number, info: CardInfo)
	local c = make("Frame", { LayoutOrder = order, BackgroundColor3 = info.Color:Lerp(T.Panel, 0.65), ZIndex = 12, Parent = list }, { Ui.corner(14), Ui.stroke(2.5) })
	Ui.label({ Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 44), Text = info.Icon, ZIndex = 13, Parent = c })
	Ui.label({ Position = UDim2.fromOffset(8, 54), Size = UDim2.new(1, -16, 0, 24), Text = info.Name, ZIndex = 13, Parent = c })
	if info.Tag then
		local tag = make("Frame", { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(66, 20), BackgroundColor3 = info.TagColor or T.Accent, ZIndex = 14, Parent = c }, { Ui.corner(6) })
		Ui.label({ Size = UDim2.fromScale(1, 1), Text = info.Tag, ZIndex = 15, StrokeThickness = 1, Parent = tag })
	end
	make("TextLabel", {
		Position = UDim2.fromOffset(10, 80), Size = UDim2.new(1, -20, 0, 56), BackgroundTransparency = 1, Font = Ui.BodyFont, TextSize = 14,
		TextWrapped = true, TextColor3 = T.Muted, Text = info.Desc, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 13, Parent = c,
	})
	local b = Ui.button({
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -20, 0, 42),
		Text = info.ButtonText, ZIndex = 13, AutoButtonColor = info.Enabled, Parent = c,
	}, info.ButtonColor)
	if info.Enabled then
		b.Activated:Connect(info.OnClick)
	end
end

local function refresh()
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for name, b in tabButtons do
		b.BackgroundColor3 = if name == currentTab then Color3.fromRGB(255, 170, 40) else T.PanelLight
	end
	local coins = player:GetAttribute("Coins") or 0
	local gems = player:GetAttribute("Gems") or 0

	if currentTab == "Abilities" then
		for i, id in Config.AbilityOrder do
			local def = Config.Abilities[id]
			local owned = player:GetAttribute("Owns_" .. id) == true
			local equipped = player:GetAttribute("Equipped" .. def.Role) == id
			local text, color, enabled, action
			if equipped then
				text, color, enabled, action = "EQUIPPED", T.Good, false, ""
			elseif owned then
				text, color, enabled, action = "EQUIP", T.Accent, true, "EquipAbility"
			else
				text, color, enabled, action = `🪙 {def.Price}`, if coins >= def.Price then Color3.fromRGB(255, 190, 40) else Color3.fromRGB(110, 110, 120), true, "BuyAbility"
			end
			card(i, {
				Icon = def.Icon, Name = def.Name, Tag = string.upper(def.Role), TagColor = if def.Role == "Shark" then Color3.fromRGB(190, 50, 60) else Color3.fromRGB(230, 130, 30),
				Desc = `{def.Description}\nCooldown {def.Cooldown}s`, Color = def.Color, ButtonText = text, ButtonColor = color, Enabled = enabled,
				OnClick = function()
					buy(action, id)
				end,
			})
		end
	elseif currentTab == "Items" then
		for i, id in Config.ItemOrder do
			local def = Config.Items[id]
			local have = player:GetAttribute("Item_" .. id) or 0
			card(i, {
				Icon = def.Icon, Name = `{def.Name}  (x{have})`, Tag = if def.Role == "Any" then "ANYONE" else string.upper(def.Role),
				TagColor = if def.Role == "Shark" then Color3.fromRGB(190, 50, 60) elseif def.Role == "Minnow" then Color3.fromRGB(230, 130, 30) else Color3.fromRGB(70, 150, 90),
				Desc = `{def.Description}\nPress {def.Key} to use.`, Color = def.Color,
				ButtonText = `BUY 🪙 {def.Price}`, ButtonColor = if coins >= def.Price then Color3.fromRGB(255, 190, 40) else Color3.fromRGB(110, 110, 120), Enabled = true,
				OnClick = function()
					buy("BuyItem", id)
				end,
			})
		end
	else
		for i, id in Config.TrailOrder do
			local def = Config.Trails[id]
			local owned = player:GetAttribute("OwnsTrail_" .. id) == true
			local equipped = player:GetAttribute("Trail") == id
			local text, color, action, arg
			if equipped then
				text, color, action, arg = "UNEQUIP", Color3.fromRGB(140, 140, 150), "EquipTrail", ""
			elseif owned then
				text, color, action, arg = "EQUIP", T.Accent, "EquipTrail", id
			else
				text, color, action, arg = `💎 {def.Price}`, if gems >= def.Price then Config.Colors.Gems else Color3.fromRGB(110, 110, 120), "BuyTrail", id
			end
			card(i, {
				Icon = "✨", Name = def.Name, Desc = "A trail that follows you everywhere. Bought with gems from wins.",
				Color = def.Colors[1], ButtonText = text, ButtonColor = color, Enabled = true,
				OnClick = function()
					buy(action, arg)
				end,
			})
		end
	end
end

for i, name in { "Abilities", "Items", "Trails" } do
	local b = Ui.button({ LayoutOrder = i, Size = UDim2.fromOffset(150, 38), Text = name:upper(), ZIndex = 12, Parent = tabs }, T.PanelLight)
	tabButtons[name] = b
	b.Activated:Connect(function()
		Fx.Sound("Click")
		currentTab = name
		refresh()
	end)
end

player.AttributeChanged:Connect(function(attr)
	if shopFrame.Visible and attr ~= "AbilityReadyAt" and attr ~= "ItemReadyAt" and attr ~= "ShieldUntil" then
		refresh()
	end
end)

-- Codes ---------------------------------------------------------------------------------------------

local codesFrame, codesBody = window("Codes", Vector2.new(400, 230), "🎁 CODES")
local box = make("TextBox", {
	Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = Color3.fromRGB(240, 245, 250), Font = Ui.Font, TextScaled = true,
	PlaceholderText = "Enter code", Text = "", TextColor3 = T.Stroke, ClearTextOnFocus = false, ZIndex = 12, Parent = codesBody,
}, { Ui.corner(10), Ui.stroke(2.5), Ui.padding(8) })
local result = Ui.label({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 24), Text = "Codes drop with updates. Try SHARKBAIT!", Font = Ui.BodyFont, TextColor3 = T.Muted, StrokeThickness = 1, ZIndex = 12, Parent = codesBody })
local redeem = Ui.button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(200, 46), Text = "REDEEM", ZIndex = 12, Parent = codesBody }, T.Good)
redeem.Activated:Connect(function()
	Fx.Sound("Click")
	local ok, message = Remotes.RedeemCode:InvokeServer(box.Text)
	result.Text = message
	result.TextColor3 = if ok then T.Good else T.Bad
	if ok then
		box.Text = ""
		Hud.Toast("🎁 " .. message, T.Good)
	end
end)

-- Public ----------------------------------------------------------------------------------------------

function Shop.ToggleShop()
	Fx.Sound("Click")
	codesFrame.Visible = false
	shopFrame.Visible = not shopFrame.Visible
	if shopFrame.Visible then
		refresh()
		pop(shopFrame)
	end
end

function Shop.ToggleCodes()
	Fx.Sound("Click")
	shopFrame.Visible = false
	codesFrame.Visible = not codesFrame.Visible
	if codesFrame.Visible then
		pop(codesFrame)
	end
end

function Shop.CloseAll()
	shopFrame.Visible = false
	codesFrame.Visible = false
end

return Shop
]]></ProtectedString>
         </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX17">
         <Properties>
          <string name="Name">Ui</string>
          <ProtectedString name="Source"><![CDATA[--!strict
-- Tiny helpers for building GUI in code.

local Ui = {}

Ui.Font = Enum.Font.FredokaOne
Ui.BodyFont = Enum.Font.GothamMedium

Ui.Theme = {
	Panel = Color3.fromRGB(18, 38, 58),
	PanelLight = Color3.fromRGB(30, 60, 88),
	Stroke = Color3.fromRGB(10, 20, 32),
	Text = Color3.fromRGB(245, 250, 255),
	Muted = Color3.fromRGB(170, 195, 215),
	Good = Color3.fromRGB(90, 220, 130),
	Bad = Color3.fromRGB(255, 95, 95),
	Accent = Color3.fromRGB(70, 190, 255),
}

-- make("Frame", { Size = ..., Parent = ... }, { children })
function Ui.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Ui.corner(radius: number?): Instance
	return Ui.make("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Ui.stroke(thickness: number?, color: Color3?, transparency: number?): Instance
	return Ui.make("UIStroke", {
		Thickness = thickness or 2,
		Color = color or Ui.Theme.Stroke,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.textStroke(thickness: number?): Instance
	return Ui.make("UIStroke", { Thickness = thickness or 2, Color = Ui.Theme.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function Ui.padding(px: number): Instance
	local u = UDim.new(0, px)
	return Ui.make("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Ui.gradient(top: Color3, bottom: Color3): Instance
	return Ui.make("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function Ui.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Ui.Font,
		TextColor3 = Ui.Theme.Text,
		TextScaled = true,
	}
	for k, v in props do
		defaults[k] = v
	end
	local children: { Instance } = { Ui.textStroke(props.StrokeThickness) }
	defaults.StrokeThickness = nil
	return Ui.make("TextLabel", defaults, children)
end

-- A chunky rounded button with a darker bottom edge.
function Ui.button(props: { [string]: any }, color: Color3): TextButton
	local defaults = {
		AutoButtonColor = true,
		BackgroundColor3 = color,
		Font = Ui.Font,
		TextColor3 = Ui.Theme.Text,
		TextScaled = true,
	}
	for k, v in props do
		defaults[k] = v
	end
	return Ui.make("TextButton", defaults, {
		Ui.corner(10),
		Ui.stroke(2.5),
		Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		Ui.textStroke(1.5),
		Ui.make("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }),
	})
end

function Ui.formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Ui.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

return Ui
]]></ProtectedString>
         </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
